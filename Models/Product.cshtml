@model TMDT_LT.Models.ViewModels.Storefront.ProductDetailVM
@using System.Text.Json
@{
    Layout = "_Layout";
    ViewData["Title"] = Model.Product.Name;

    var uniqueStorages = Model.Product.ProductVariants.Where(v => v.IsActive == true && !string.IsNullOrEmpty(v.Storage)).Select(v => v.Storage).Distinct().ToList();
    var uniqueRams = Model.Product.ProductVariants.Where(v => v.IsActive == true && !string.IsNullOrEmpty(v.Ram)).Select(v => v.Ram).Distinct().ToList();
    var uniqueColors = Model.Product.ProductVariants.Where(v => v.IsActive == true && !string.IsNullOrEmpty(v.Color)).Select(v => v.Color).Distinct().ToList();

    var minPrice = Model.Product.ProductVariants.Where(v => v.IsActive == true).Min(v => v.DiscountPrice > 0 ? v.DiscountPrice : v.Price);
    string displayPrice = minPrice != null ? ((decimal)minPrice).ToString("N0", new System.Globalization.CultureInfo("vi-VN")) + " đ" : "Liên hệ";
}

@section Styles {
    <link rel="stylesheet" href="~/css/storefront/store-home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/storefront/store-catalog.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/storefront/store-pdp.css" asp-append-version="true" />
    <style>
        body, button, input, select, textarea {
            font-family: 'Plus Jakarta Sans', sans-serif !important;
        }

        /* BỘ NÚT CHỌN BIẾN THỂ TRANG CHÍNH & MODAL */
        .chip-btn {
            padding: 8px 16px;
            border: 1px solid var(--border-color);
            background: white;
            color: var(--navy-deep);
            border-radius: 4px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
        }
        .chip-btn:hover {
            border-color: var(--navy-deep);
        }
        .chip-btn.active {
            border-color: var(--accent-red) !important;
            color: var(--accent-red) !important;
            background: #FEF2F2 !important;
            box-shadow: none;
        }
        .chip-btn.disabled-chip {
            opacity: 0.3 !important;
            cursor: not-allowed !important;
            border-color: #E5E7EB !important;
            background: #F9FAFB !important;
            color: #9CA3AF !important;
        }

        /* SLIDER TRƯỢT NGANG ẨN SCROLLBAR */
        .pdp-slider-wrapper {
            display: flex;
            overflow-x: auto;
            gap: 20px;
            padding: 10px 4px 30px 4px;
            scroll-snap-type: x mandatory;
            scrollbar-width: none; 
            -ms-overflow-style: none;  
        }
        .pdp-slider-wrapper::-webkit-scrollbar {
            display: none; 
        }

        /* CSS ICON SAO TRẮNG VIỀN VÀNG */
        .star-custom { color: #FFFFFF !important; -webkit-text-stroke: 1.5px #F59E0B; font-size: 15px; }
        .star-custom.filled { color: #F59E0B !important; -webkit-text-stroke: 1px #F59E0B; }
        .rating-bar-wrapper { flex: 1; height: 6px; background: #E2E8F0; border-radius: 3px; overflow: hidden; }
        .rating-bar-progress { height: 100%; background: var(--navy-deep, #0F172A); border-radius: 3px; transition: width 0.4s ease; }

        /* CSS MODAL QUICK ADD CHUẨN CATALOG */
        .qa-modal-overlay {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0, 0, 0, 0.6);
            display: none; align-items: center; justify-content: center;
            z-index: 1000; opacity: 0; transition: opacity 0.3s;
        }
        .qa-modal-overlay.show { display: flex; opacity: 1; }
        .qa-modal-content {
            background: white; border-radius: 8px; width: 90%; max-width: 480px;
            padding: 20px; position: relative; transform: translateY(20px); transition: transform 0.3s;
        }
        .qa-modal-overlay.show .qa-modal-content { transform: translateY(0); }
        .qa-close-btn {
            position: absolute; top: 15px; right: 15px; background: none; border: none;
            font-size: 20px; color: #9CA3AF; cursor: pointer;
        }
        .qa-close-btn:hover { color: var(--accent-red); }
    </style>
}

<div class="pdp-container" style="max-width: 1200px; margin: 40px auto; padding: 0 20px;">
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 50px;">
        
        <div>
            <div style="border: 1px solid #E2E8F0; border-radius: 12px; padding: 30px; text-align: center; background: #FFFFFF; height: 450px; display: flex; align-items: center; justify-content: center; overflow: hidden;">
                <img id="mainProductImage" src="@(Model.Product.MainImage ?? "/images/productDefault.png")" style="max-height: 100%; max-width: 100%; object-fit: contain; transition: all 0.25s;" />
            </div>
            
            @if (Model.Product.ProductImages != null && Model.Product.ProductImages.Any())
            {
                <div style="display: flex; gap: 12px; margin-top: 16px; overflow-x: auto; padding-bottom: 8px;">
                    <div style="width: 72px; height: 72px; padding: 6px; border: 2px solid #0F172A; border-radius: 6px; cursor: pointer; background: #FFF; flex-shrink: 0;" onclick="changePreviewImage('@Model.Product.MainImage', this)">
                        <img src="@(Model.Product.MainImage ?? "/images/productDefault.png")" style="width:100%; height:100%; object-fit:contain;" />
                    </div>
                    @foreach (var img in Model.Product.ProductImages)
                    {
                        <div style="width: 72px; height: 72px; padding: 6px; border: 1px solid #E2E8F0; border-radius: 6px; cursor: pointer; background: #FFF; flex-shrink: 0;" onclick="changePreviewImage('@img.ImageUrl', this)">
                            <img src="@img.ImageUrl" style="width:100%; height:100%; object-fit:contain;" />
                        </div>
                    }
                </div>
            }
        </div>

        <div>
            <span style="font-size: 11px; font-weight: 800; background: #0F172A; color: #FFFFFF; padding: 4px 12px; border-radius: 4px; text-transform: uppercase;">
                @Model.Product.Brand?.BrandName
            </span>
            <h1 style="font-size: 28px; font-weight: 800; color: #0F172A; margin: 12px 0 16px 0; line-height: 1.25;">
                @Model.Product.Name
            </h1>

            <div style="background: #F8FAFC; padding: 20px 24px; border-radius: 8px; border: 1px solid #E2E8F0; margin-bottom: 24px;">
                <div id="pdpPriceBlock">
                    <span id="pdpDisplayPrice" style="font-size: 26px; font-weight: 800; color: #0F172A;">@displayPrice</span>
                    <span id="pdpRawPrice" style="font-size: 15px; color: #94A3B8; text-decoration: line-through; margin-left: 12px; display: none;"></span>
                </div>
                <div id="pdpStockStatus" style="font-size: 14px; font-weight: 700; color: #64748B; margin-top: 8px;">
                    Vui lòng chọn cấu hình để kiểm tra kho.
                </div>
            </div>

            <div style="display: flex; flex-direction: column; gap: 20px; margin-bottom: 30px;">
                @if (uniqueRams.Any())
                {
                    <div>
                        <div style="font-size: 12px; font-weight: 800; color: #64748B; margin-bottom: 10px; text-transform: uppercase;">Bộ nhớ RAM</div>
                        <div style="display: flex; flex-wrap: wrap; gap: 10px;" id="mainRamOptions">
                            @foreach (var ram in uniqueRams) { <button type="button" class="chip-btn ram-chip" data-ram="@ram">@ram</button> }
                        </div>
                    </div>
                }
                @if (uniqueStorages.Any())
                {
                    <div>
                        <div style="font-size: 12px; font-weight: 800; color: #64748B; margin-bottom: 10px; text-transform: uppercase;">Dung lượng lưu trữ</div>
                        <div style="display: flex; flex-wrap: wrap; gap: 10px;" id="mainStorageOptions">
                            @foreach (var storage in uniqueStorages) { <button type="button" class="chip-btn storage-chip" data-storage="@storage">@storage</button> }
                        </div>
                    </div>
                }
                @if (uniqueColors.Any())
                {
                    <div>
                        <div style="font-size: 12px; font-weight: 800; color: #64748B; margin-bottom: 10px; text-transform: uppercase;">Màu sắc thiết bị</div>
                        <div style="display: flex; flex-wrap: wrap; gap: 10px;" id="mainColorOptions">
                            @foreach (var color in uniqueColors) { <button type="button" class="chip-btn color-chip" data-color="@color">@color</button> }
                        </div>
                    </div>
                }
            </div>

            <form id="addToCartFormMain" action="/Cart/AddToCart" method="post">
                <input type="hidden" id="selectedVariantIdHidden" name="variantId" value="0" />
                <div style="display: flex; gap: 16px; align-items: center; flex-wrap: wrap;">
                    
                    <div style="display: flex; align-items: center; border: 1px solid var(--border-color); border-radius: 4px; height: 46px; background: #FFF; flex-shrink: 0; overflow: hidden;">
                        <button type="button" style="width: 40px; height: 100%; border: none; background: transparent; font-weight: 700; color: #0F172A;" onclick="adjustQty(-1)">-</button>
                        <input type="number" id="pdpMainQty" name="quantity" value="1" min="1" style="width: 50px; text-align: center; border: none; font-weight: 700; height: 100%; color: #0F172A; outline: none;" readonly />
                        <button type="button" style="width: 40px; height: 100%; border: none; background: transparent; font-weight: 700; color: #0F172A;" onclick="adjustQty(1)">+</button>
                    </div>
                    
                    <button type="button" id="btnAddToCartMain" class="btn-dark" style="flex: 1; min-width: 150px; height: 46px; font-weight: 700; text-transform: uppercase; background: #0F172A; border-color: #0F172A;" disabled onclick="executeAddToCart()">
                        <i class="fas fa-shopping-cart" style="margin-right: 8px;"></i> Thêm vào giỏ
                    </button>

                    <button type="button" id="btnBuyNowMain" class="btn-dark" style="flex: 1; min-width: 130px; height: 46px; font-weight: 700; text-transform: uppercase; background: #FFFFFF; color: #0F172A; border: 2px solid #0F172A;" disabled onclick="executeBuyNowAction()">
                        Mua Ngay
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="pdp-reviews-section" style="margin-top: 60px; background: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 12px; padding: 32px;">
        <h3 style="font-size: 16px; font-weight: 800; color: #0F172A; margin-bottom: 24px; text-transform: uppercase;">
            Khách hàng phản hồi về sản phẩm
        </h3>

        <div style="display: grid; grid-template-columns: 1fr 2fr; gap: 40px; align-items: center; border-bottom: 1px solid #F1F5F9; padding-bottom: 32px; margin-bottom: 24px;">
            <div style="text-align: center; border-right: 1px solid #E2E8F0; padding-right: 40px;">
                <div style="font-size: 48px; font-weight: 800; color: #0F172A; line-height: 1;">@Model.AverageRating.ToString("0.0")</div>
                <div style="margin: 8px 0; font-size: 16px;">
                    @for (int i = 1; i <= 5; i++) { <i class="fas fa-star star-custom @(i <= Math.Round(Model.AverageRating) ? "filled" : "")"></i> }
                </div>
                <div style="font-size: 13px; color: #64748B; font-weight: 600;">@Model.TotalReviews lượt đánh giá</div>
            </div>

            <div>
                @for (int i = 5; i >= 1; i--)
                {
                    int count = Model.StarCounts.ContainsKey(i) ? Model.StarCounts[i] : 0;
                    double percent = Model.TotalReviews > 0 ? ((double)count / Model.TotalReviews) * 100 : 0;
                    <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 6px; font-size: 13px; font-weight: 700; color: #475569;">
                        <span style="width: 40px; text-align: right;">@i sao</span>
                        <div class="rating-bar-wrapper">
                            <div class="rating-bar-progress" style="width: @(percent)%;"></div>
                        </div>
                        <span style="width: 35px; color: #94A3B8; margin-left: 4px;">@count</span>
                    </div>
                }
            </div>
        </div>

        <p style="font-size: 13px; color: #64748B; font-style: italic; text-align: left; margin-bottom: 24px;">
            <i class="fas fa-info-circle"></i> Đánh giá chỉ có thể thực hiện khi bạn mua sản phẩm này.
        </p>

        <div class="reviews-list-container">
            @if (Model.ApprovedReviews != null && Model.ApprovedReviews.Any())
            {
                @foreach (var rev in Model.ApprovedReviews)
                {
                    var detailRev = rev.ReviewDetails?.FirstOrDefault();
                    <div style="padding: 20px 0; border-bottom: 1px solid #F1F5F9;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                            <div style="display: flex; align-items: center; gap: 8px;">
                                <strong style="color: #0F172A; font-size: 14px;">@rev.Customer?.FullName</strong>
                                <span style="font-size: 11px; font-weight: 700; background: #F1F5F9; color: #0F172A; padding: 2px 8px; border-radius: 4px; border: 1px solid #E2E8F0;">
                                    <i class="fas fa-check-circle"></i> Đã mua hàng
                                </span>
                            </div>
                            <span style="font-size: 12px; color: #94A3B8; font-weight: 600;">@(rev.CreatedAt?.ToString("dd/MM/yyyy"))</span>
                        </div>
                        <div style="font-size: 12px; margin-bottom: 6px;">
                            @for (int i = 1; i <= 5; i++) { <i class="fas fa-star star-custom @(i <= (rev.Rating ?? 5) ? "filled" : "")"></i> }
                            @if (detailRev?.Variant != null)
                            {
                                <span style="color: #64748B; font-size: 12px; font-weight: 700; margin-left: 10px;">
                                    Bản: @(detailRev.Variant.Ram)/@(detailRev.Variant.Storage) - @detailRev.Variant.Color
                                </span>
                            }
                        </div>
                        <p style="font-size: 14px; color: #334155; line-height: 1.5; margin: 0;">@rev.Comment</p>
                    </div>
                }

                @if (Model.TotalReviews > 4)
                {
                    <div style="text-align: center; margin-top: 28px;">
                        <a href="/Store/Product/@Model.Product.ProductId/Reviews" class="btn-dark" style="background: transparent; border: 1px solid #0F172A; color: #0F172A; text-decoration: none; font-weight: 700;">
                            Xem thêm @(Model.TotalReviews - 3) đánh giá <i class="fas fa-chevron-right" style="margin-left: 4px; font-size: 11px;"></i>
                        </a>
                    </div>
                }
            }
            else
            {
                <p style="text-align: center; color: #94A3B8; font-size: 14px; font-style: italic; padding: 20px 0;">
                    Chưa có phản hồi nào cho dòng sản phẩm này.
                </p>
            }
        </div>
    </div>

    @if (Model.UpSellProducts != null && Model.UpSellProducts.Any())
    {
        <div style="margin-top: 50px; border-top: 1px solid #E2E8F0; padding-top: 40px; margin-bottom: 40px;">
            <h3 style="font-size: 16px; font-weight: 800; color: #0F172A; margin-bottom: 20px; text-transform: uppercase;">
                Sản phẩm tương tự bạn có thể thích
            </h3>
            
            <div class="pdp-slider-wrapper">
                @foreach (var item in Model.UpSellProducts)
                {
                    var activeVariants = item.ProductVariants.Where(v => v.IsActive == true).ToList();
                    var defaultVariant = activeVariants.OrderBy(v => v.DiscountPrice > 0 ? v.DiscountPrice : v.Price).FirstOrDefault();
                    
                    decimal rawPrice = defaultVariant?.Price ?? 0;
                    decimal salePrice = defaultVariant?.DiscountPrice ?? 0;
                    
                    // JSON Biến thể nạp cho Modal Quick View
                    var variantJson = System.Text.Json.JsonSerializer.Serialize(activeVariants.Select(v => new
                    {
                        variantId = v.VariantId,
                        color = v.Color ?? "",
                        ram = v.Ram ?? "",
                        storage = v.Storage ?? "",
                        price = v.Price,
                        discountPrice = v.DiscountPrice,
                        stock = v.Stock,
                        imageUrl = !string.IsNullOrEmpty(v.ImageUrl) ? v.ImageUrl : item.MainImage
                    }));

                    <div class="market-product-card" style="flex: 0 0 230px; scroll-snap-align: start;">
                        <button type="button" class="btn-favorite" onclick="toggleFavorite(event, @item.ProductId)" title="Thêm vào yêu thích">
                            <i class="far fa-heart"></i>
                        </button>

                        <a href="/Store/Product/@item.ProductId" style="text-decoration: none; color: inherit; display: flex; flex-direction: column; flex: 1;">
                            <img src="@(item.MainImage ?? "/images/productDefault.png")" alt="@item.Name" class="product-card-img" />
                            <div class="product-card-name">@item.Name</div>
                            
                            <div class="price-group-market">
                                @if (salePrice > 0 && salePrice < rawPrice)
                                {
                                    <span class="price-market-current">@salePrice.ToString("N0", new System.Globalization.CultureInfo("vi-VN")) đ</span>
                                    <span class="price-market-old">@rawPrice.ToString("N0", new System.Globalization.CultureInfo("vi-VN")) đ</span>
                                }
                                else
                                {
                                    <span class="price-market-current">@(rawPrice > 0 ? rawPrice.ToString("N0", new System.Globalization.CultureInfo("vi-VN")) + " đ" : "Liên hệ")</span>
                                }
                            </div>
                        </a>

                        @if (activeVariants.Count > 1)
                        {
                            <button type="button" class="btn-home-cart" onclick="openQuickAddModal(this)" data-name="@item.Name" data-img="@(item.MainImage ?? "/images/productDefault.png")" data-variants="@variantJson">
                                <i class="fas fa-shopping-cart"></i> THÊM VÀO GIỎ
                            </button>
                        }
                        else if (activeVariants.Count == 1 && defaultVariant != null && defaultVariant.Stock > 0)
                        {
                            <form action="/Cart/AddToCart" method="post" style="margin: 0; width: 100%;" class="ajax-cart-form">
                                <input type="hidden" name="variantId" value="@defaultVariant.VariantId" />
                                <input type="hidden" name="quantity" value="1" />
                                <button type="submit" class="btn-home-cart">
                                    <i class="fas fa-shopping-cart"></i> THÊM VÀO GIỎ
                                </button>
                            </form>
                        }
                        else
                        {
                            <button type="button" class="btn-home-cart" disabled style="background: #E5E7EB; color: #9CA3AF; cursor: not-allowed;">
                                <i class="fas fa-box-open"></i> HẾT HÀNG
                            </button>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>

<div id="qa-modal" class="qa-modal-overlay" onclick="closeQuickAddModal()">
    <div class="qa-modal-content" onclick="event.stopPropagation()">
        <button class="qa-close-btn" onclick="closeQuickAddModal()">✖</button>

        <div style="display: flex; gap: 15px; margin-bottom: 20px; align-items: flex-end;">
            <img id="qa-image" src="" style="width: 100px; height: 100px; object-fit: contain; border: 1px solid var(--border-color); border-radius: 4px; padding: 4px;" />
            <div>
                <div id="qa-price" style="color: var(--accent-red); font-weight: 700; font-size: 18px; margin-bottom: 4px;"></div>
                <div id="qa-stock" style="font-size: 13px; color: #6B7280;">Vui lòng chọn phân loại</div>
            </div>
        </div>

        <div id="qa-options-container" style="max-height: 300px; overflow-y: auto; margin-bottom: 20px; border-top: 1px solid var(--border-color); padding-top: 15px;">
        </div>

        <form id="qa-form" action="/Cart/AddToCart" method="post" style="display: flex; gap: 10px; border-top: 1px solid var(--border-color); padding-top: 15px;">
            <input type="hidden" name="variantId" id="qa-variantId" value="" />
            <div style="display: flex; align-items: center; border: 1px solid var(--border-color); border-radius: 4px; overflow: hidden; width: 100px;">
                <button type="button" class="chip-btn" style="border: none; width: 30px; padding: 0;" onclick="qaChangeQty(-1)">-</button>
                <input type="number" id="qa-qty" name="quantity" value="1" min="1" style="width: 40px; border: none; text-align: center; font-weight: 700; outline: none;" readonly />
                <button type="button" class="chip-btn" style="border: none; width: 30px; padding: 0;" onclick="qaChangeQty(1)">+</button>
            </div>
            <button type="submit" id="qa-btn-submit" class="btn-dark" disabled style="flex: 1; height: 40px; font-weight: 700; border-radius: 4px;">XÁC NHẬN THÊM</button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // =====================================================================
        // PHẦN 1: LOGIC TRANG CHI TIẾT SẢN PHẨM CHÍNH (MAIN PDP)
        // =====================================================================
        const variantMatrix = @Html.Raw(JsonSerializer.Serialize(Model.Product.ProductVariants.Where(v => v.IsActive == true).Select(v => new {
            v.VariantId, v.Color, v.Storage, v.Ram, v.Price, v.DiscountPrice, v.Stock, v.ImageUrl
        })));

        let selectedRam = "", selectedStorage = "", selectedColor = "";
        let globalMaxStock = 1;

        function changePreviewImage(url, element) {
            if(!url) return;
            document.getElementById('mainProductImage').src = url;
            if(element) {
                document.querySelectorAll('[onclick^="changePreviewImage"]').forEach(div => div.style.borderColor = '#E2E8F0');
                element.style.borderColor = '#0F172A';
            }
        }

        function adjustQty(amount) {
            const input = document.getElementById('pdpMainQty');
            let current = parseInt(input.value) || 1;
            current += amount;
            if(current < 1) current = 1;
            if(current > globalMaxStock) current = globalMaxStock;
            input.value = current;
        }

        function updateMatrixChipsAvailability() {
            document.querySelectorAll('#mainRamOptions .ram-chip').forEach(chip => {
                const val = chip.getAttribute('data-ram');
                const exists = variantMatrix.some(v => v.Ram === val && (!selectedStorage || v.Storage === selectedStorage) && (!selectedColor || v.Color === selectedColor));
                if (exists) chip.classList.remove('disabled-chip'); else chip.classList.add('disabled-chip');
            });

            document.querySelectorAll('#mainStorageOptions .storage-chip').forEach(chip => {
                const val = chip.getAttribute('data-storage');
                const exists = variantMatrix.some(v => v.Storage === val && (!selectedRam || v.Ram === selectedRam) && (!selectedColor || v.Color === selectedColor));
                if (exists) chip.classList.remove('disabled-chip'); else chip.classList.add('disabled-chip');
            });

            document.querySelectorAll('#mainColorOptions .color-chip').forEach(chip => {
                const val = chip.getAttribute('data-color');
                const exists = variantMatrix.some(v => v.Color === val && (!selectedRam || v.Ram === selectedRam) && (!selectedStorage || v.Storage === selectedStorage));
                if (exists) chip.classList.remove('disabled-chip'); else chip.classList.add('disabled-chip');
            });
        }

        function evaluateCurrentSelection() {
            const matched = variantMatrix.find(v => v.Ram === selectedRam && v.Storage === selectedStorage && v.Color === selectedColor);
            
            const priceText = document.getElementById('pdpDisplayPrice');
            const rawPriceText = document.getElementById('pdpRawPrice');
            const stockStatus = document.getElementById('pdpStockStatus');
            const hiddenInput = document.getElementById('selectedVariantIdHidden');
            const btnCart = document.getElementById('btnAddToCartMain');
            const btnBuyNow = document.getElementById('btnBuyNowMain');
            const qtyInput = document.getElementById('pdpMainQty');

            if(matched) {
                hiddenInput.value = matched.VariantId;
                globalMaxStock = matched.Stock ?? 0;
                
                if(matched.ImageUrl) changePreviewImage(matched.ImageUrl, null);

                if(matched.DiscountPrice > 0 && matched.DiscountPrice < matched.Price) {
                    priceText.innerText = matched.DiscountPrice.toLocaleString('vi-VN') + " đ";
                    rawPriceText.innerText = matched.Price.toLocaleString('vi-VN') + " đ";
                    rawPriceText.style.display = 'inline-block';
                } else {
                    priceText.innerText = matched.Price.toLocaleString('vi-VN') + " đ";
                    rawPriceText.style.display = 'none';
                }

                if(globalMaxStock > 0) {
                    if(parseInt(qtyInput.value) > globalMaxStock) qtyInput.value = globalMaxStock;
                    stockStatus.innerHTML = `<span style="color:#0F172A;">Số lượng còn: ${globalMaxStock}</span>`;
                    btnCart.disabled = false; btnBuyNow.disabled = false;
                } else {
                    qtyInput.value = 1;
                    stockStatus.innerHTML = `<span style="color:#DC2626;"><i class="fas fa-times-circle"></i> Tạm hết hàng</span>`;
                    btnCart.disabled = true; btnBuyNow.disabled = true;
                }
            } else {
                hiddenInput.value = "0"; globalMaxStock = 1;
                btnCart.disabled = true; btnBuyNow.disabled = true;
                rawPriceText.style.display = 'none';
                stockStatus.innerHTML = (!selectedRam || !selectedStorage || !selectedColor) 
                    ? `<span style="color:#64748B;">Vui lòng chọn cấu hình để kiểm tra kho.</span>`
                    : `<span style="color:#DC2626;"><i class="fas fa-ban"></i> Cấu hình này không tồn tại.</span>`;
            }
            updateMatrixChipsAvailability();
        }

        // BẮT SỰ KIỆN TÍCH VÀ BỎ TÍCH
        document.querySelectorAll('#mainRamOptions .ram-chip').forEach(btn => {
            btn.addEventListener('click', function() {
                if(this.classList.contains('active')) {
                    this.classList.remove('active'); selectedRam = "";
                } else {
                    document.querySelectorAll('#mainRamOptions .ram-chip').forEach(b => b.classList.remove('active'));
                    this.classList.add('active'); selectedRam = this.getAttribute('data-ram');
                    if(!variantMatrix.some(v => v.Ram === selectedRam && (!selectedStorage || v.Storage === selectedStorage) && (!selectedColor || v.Color === selectedColor))) {
                        selectedStorage = ""; document.querySelectorAll('#mainStorageOptions .storage-chip').forEach(b => b.classList.remove('active'));
                        selectedColor = ""; document.querySelectorAll('#mainColorOptions .color-chip').forEach(b => b.classList.remove('active'));
                    }
                }
                evaluateCurrentSelection();
            });
        });

        document.querySelectorAll('#mainStorageOptions .storage-chip').forEach(btn => {
            btn.addEventListener('click', function() {
                if(this.classList.contains('active')) {
                    this.classList.remove('active'); selectedStorage = "";
                } else {
                    document.querySelectorAll('#mainStorageOptions .storage-chip').forEach(b => b.classList.remove('active'));
                    this.classList.add('active'); selectedStorage = this.getAttribute('data-storage');
                    if(!variantMatrix.some(v => v.Storage === selectedStorage && (!selectedRam || v.Ram === selectedRam) && (!selectedColor || v.Color === selectedColor))) {
                        selectedRam = ""; document.querySelectorAll('#mainRamOptions .ram-chip').forEach(b => b.classList.remove('active'));
                        selectedColor = ""; document.querySelectorAll('#mainColorOptions .color-chip').forEach(b => b.classList.remove('active'));
                    }
                }
                evaluateCurrentSelection();
            });
        });

        document.querySelectorAll('#mainColorOptions .color-chip').forEach(btn => {
            btn.addEventListener('click', function() {
                if(this.classList.contains('active')) {
                    this.classList.remove('active'); selectedColor = "";
                } else {
                    document.querySelectorAll('#mainColorOptions .color-chip').forEach(b => b.classList.remove('active'));
                    this.classList.add('active'); selectedColor = this.getAttribute('data-color');
                    if(!variantMatrix.some(v => v.Color === selectedColor && (!selectedRam || v.Ram === selectedRam) && (!selectedStorage || v.Storage === selectedStorage))) {
                        selectedRam = ""; document.querySelectorAll('#mainRamOptions .ram-chip').forEach(b => b.classList.remove('active'));
                        selectedStorage = ""; document.querySelectorAll('#mainStorageOptions .storage-chip').forEach(b => b.classList.remove('active'));
                    }
                }
                evaluateCurrentSelection();
            });
        });

        document.addEventListener('DOMContentLoaded', () => {
            const autoSelect = variantMatrix.find(v => v.Stock > 0) || variantMatrix[0];
            if (autoSelect) {
                const ramBtn = document.querySelector(`#mainRamOptions .ram-chip[data-ram="${autoSelect.Ram}"]`);
                const storageBtn = document.querySelector(`#mainStorageOptions .storage-chip[data-storage="${autoSelect.Storage}"]`);
                const colorBtn = document.querySelector(`#mainColorOptions .color-chip[data-color="${autoSelect.Color}"]`);

                if (ramBtn) ramBtn.click();
                if (storageBtn) storageBtn.click();
                if (colorBtn) colorBtn.click();
            } else {
                updateMatrixChipsAvailability();
            }
        });

        // AJAX MUA CHÍNH TẠI TRANG PDP (FIX LỖI KẾT NỐI MÁY CHỦ)
        async function executeAddToCart() {
            const variantId = document.getElementById('selectedVariantIdHidden').value;
            const quantity = document.getElementById('pdpMainQty').value;
            if(variantId === "0") return;

            const btnCart = document.getElementById('btnAddToCartMain');
            const originalContent = btnCart.innerHTML;
            btnCart.disabled = true;
            btnCart.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i>...';

            const formData = new FormData();
            formData.append('variantId', variantId);
            formData.append('quantity', quantity);
            formData.append('actionType', 'add'); // Thêm tham số bảo mật

            try {
                const response = await fetch('/Cart/AddToCart', { 
                    method: 'POST', 
                    body: formData,
                    headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }
                });
                
                if(response.ok || response.redirected) {
                    const data = await response.json();
                    if(data.success) {
                        const cartBadge = document.getElementById('header-cart-badge');
                        if (cartBadge) {
                            cartBadge.innerText = data.cartCount;
                            cartBadge.classList.add('has-items');
                        }
                        if (typeof window.showToast === 'function') window.showToast("Đã thêm vào giỏ hàng thành công!", "success");
                    } else {
                        if (typeof window.showToast === 'function') window.showToast(data.message, "error");
                    }
                }
            } catch {
                if (typeof window.showToast === 'function') window.showToast("Lỗi kết nối máy chủ.", "error");
            } finally {
                btnCart.disabled = false;
                btnCart.innerHTML = originalContent;
            }
        }

        // LUỒNG ĐIỀU HƯỚNG MUA NGAY SANG CHECKOUT
        async function executeBuyNowAction() {
            const variantId = document.getElementById('selectedVariantIdHidden').value;
            const quantity = document.getElementById('pdpMainQty').value;
            if(variantId === "0") return;

            const btnBuyNow = document.getElementById('btnBuyNowMain');
            const originalContent = btnBuyNow.innerHTML;
            btnBuyNow.disabled = true;
            btnBuyNow.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i>...';

            const formData = new FormData();
            formData.append('variantId', variantId);
            formData.append('quantity', quantity);
            formData.append('actionType', 'add');

            try {
                const response = await fetch('/Cart/AddToCart', { 
                    method: 'POST', 
                    body: formData,
                    headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }
                });
                if(response.ok || response.redirected) {
                    const data = await response.json();
                    if(data.success) {
                        window.location.href = '/Checkout/Index';
                    } else {
                        if (typeof window.showToast === 'function') window.showToast(data.message, "error");
                    }
                }
            } catch {
                if (typeof window.showToast === 'function') window.showToast("Lỗi kết nối máy chủ.", "error");
            } finally {
                btnBuyNow.disabled = false;
                btnBuyNow.innerHTML = originalContent;
            }
        }

        window.toggleFavorite = function(event, productId) {
            event.preventDefault();
            event.stopPropagation();
            const btn = event.currentTarget; const icon = btn.querySelector('i');
            btn.classList.toggle('active');
            if (btn.classList.contains('active')) { icon.classList.remove('far'); icon.classList.add('fas'); }
            else { icon.classList.remove('fas'); icon.classList.add('far'); }
        };

        // =====================================================================
        // PHẦN 2: LOGIC QUICK ADD MODAL (CHÍNH XÁC NHƯ TRANG CATALOG)
        // =====================================================================
        let qaVariantMatrix = [];
        let qaCurrentSelection = { storage: null, ram: null, color: null };
        let qaMinPrice = 0;

        function openQuickAddModal(btnElement) {
            qaVariantMatrix = JSON.parse(btnElement.getAttribute('data-variants'));
            qaCurrentSelection = { storage: null, ram: null, color: null };
            qaMinPrice = Math.min(...qaVariantMatrix.map(v => v.discountPrice > 0 ? v.discountPrice : v.price));

            document.getElementById('qa-image').src = btnElement.getAttribute('data-img');
            document.getElementById('qa-qty').value = 1;

            const storages = [...new Set(qaVariantMatrix.map(v => v.storage).filter(v => v !== ""))];
            const rams = [...new Set(qaVariantMatrix.map(v => v.ram).filter(v => v !== ""))];
            const colors = [...new Set(qaVariantMatrix.map(v => v.color).filter(v => v !== ""))];

            let html = '';
            if(storages.length > 0) {
                html += '<div style="font-size: 13px; font-weight: 700; margin-bottom: 8px;">Dung lượng</div><div style="display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 15px;">';
                storages.forEach(s => html += `<button type="button" class="chip-btn attr-qa-storage" data-val="${s}" onclick="qaToggleSelection('storage', '${s}', this)">${s}</button>`);
                html += '</div>';
            }
            if(rams.length > 0) {
                html += '<div style="font-size: 13px; font-weight: 700; margin-bottom: 8px;">RAM</div><div style="display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 15px;">';
                rams.forEach(r => html += `<button type="button" class="chip-btn attr-qa-ram" data-val="${r}" onclick="qaToggleSelection('ram', '${r}', this)">${r}</button>`);
                html += '</div>';
            }
            if(colors.length > 0) {
                html += '<div style="font-size: 13px; font-weight: 700; margin-bottom: 8px;">Màu sắc</div><div style="display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 15px;">';
                colors.forEach(c => html += `<button type="button" class="chip-btn attr-qa-color" data-val="${c}" onclick="qaToggleSelection('color', '${c}', this)">${c}</button>`);
                html += '</div>';
            }

            document.getElementById('qa-options-container').innerHTML = html;

            const modal = document.getElementById('qa-modal');
            modal.style.display = 'flex';
            setTimeout(() => modal.classList.add('show'), 10);

            qaEvaluateMatrix();
        }

        function closeQuickAddModal() {
            const modal = document.getElementById('qa-modal');
            modal.classList.remove('show');
            setTimeout(() => modal.style.display = 'none', 300);
        }

        function qaToggleSelection(type, value, element) {
            if (element.classList.contains('disabled-chip')) return;
            if (qaCurrentSelection[type] === value) {
                qaCurrentSelection[type] = null;
                element.classList.remove('active');
            } else {
                qaCurrentSelection[type] = value;
                document.querySelectorAll(`.attr-qa-${type}`).forEach(el => el.classList.remove('active'));
                element.classList.add('active');
            }
            qaEvaluateMatrix();
        }

        function qaEvaluateMatrix() {
            document.querySelectorAll('.attr-qa-storage').forEach(el => qaCheckAvailability('storage', el.getAttribute('data-val'), el));
            document.querySelectorAll('.attr-qa-ram').forEach(el => qaCheckAvailability('ram', el.getAttribute('data-val'), el));
            document.querySelectorAll('.attr-qa-color').forEach(el => qaCheckAvailability('color', el.getAttribute('data-val'), el));
            
            const exactMatch = qaVariantMatrix.find(v =>
                (!qaCurrentSelection.storage || v.storage === qaCurrentSelection.storage) &&
                (!qaCurrentSelection.ram || v.ram === qaCurrentSelection.ram) &&
                (!qaCurrentSelection.color || v.color === qaCurrentSelection.color) &&
                (qaCurrentSelection.storage !== null || v.storage === "") &&
                (qaCurrentSelection.ram !== null || v.ram === "") &&
                (qaCurrentSelection.color !== null || v.color === "")
            );
            
            const formatVND = (num) => new Intl.NumberFormat('vi-VN').format(num) + " đ";
            const btnSubmit = document.getElementById('qa-btn-submit');
            
            if (exactMatch) {
                document.getElementById('qa-variantId').value = exactMatch.variantId;
                const price = (exactMatch.discountPrice > 0) ? exactMatch.discountPrice : exactMatch.price;
                document.getElementById('qa-price').innerText = formatVND(price);
                if (exactMatch.stock > 0) {
                    document.getElementById('qa-stock').innerText = `Kho: ${exactMatch.stock}`;
                    document.getElementById('qa-stock').style.color = "#6B7280";
                    btnSubmit.disabled = false;
                } else {
                    document.getElementById('qa-stock').innerText = "Hết hàng";
                    document.getElementById('qa-stock').style.color = "var(--accent-red)";
                    btnSubmit.disabled = true;
                }
                if (exactMatch.imageUrl) document.getElementById('qa-image').src = exactMatch.imageUrl;
            } else {
                document.getElementById('qa-price').innerText = qaMinPrice > 0 ? formatVND(qaMinPrice) : "Liên hệ";
                document.getElementById('qa-stock').innerText = "Vui lòng chọn phân loại";
                document.getElementById('qa-stock').style.color = "#6B7280";
                btnSubmit.disabled = true;
                document.getElementById('qa-variantId').value = "";
            }
        }

        function qaCheckAvailability(typeToCheck, valueToCheck, element) {
            let testSelection = { ...qaCurrentSelection };
            testSelection[typeToCheck] = valueToCheck;

            const isAvailable = qaVariantMatrix.some(v =>
                (!testSelection.storage || v.storage === testSelection.storage) &&
                (!testSelection.ram || v.ram === testSelection.ram) &&
                (!testSelection.color || v.color === testSelection.color)
            );
            if (isAvailable) {
                element.classList.remove('disabled-chip');
            } else {
                element.classList.add('disabled-chip');
                element.classList.remove('active');
                if (qaCurrentSelection[typeToCheck] === valueToCheck) qaCurrentSelection[typeToCheck] = null;
            }
        }

        function qaChangeQty(change) {
            const input = document.getElementById('qa-qty');
            let newQty = parseInt(input.value) + change;
            if (newQty >= 1) input.value = newQty;
        }

        document.getElementById('qa-form').addEventListener('submit', function(e) {
            e.preventDefault();
            const formData = new FormData(this);
            formData.append('actionType', 'add'); // Fix lỗi máy chủ giống hệt Index

            const btn = document.getElementById('qa-btn-submit');
            const originalText = btn.innerHTML;
            btn.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i>...';

            fetch(this.action, {
                method: this.method, body: formData,
                headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    btn.innerHTML = 'ĐÃ THÊM';
                    btn.style.background = '#10B981';
                    
                    const cartBadge = document.getElementById('header-cart-badge');
                    if (cartBadge) {
                        let currentQty = parseInt(cartBadge.innerText) || 0;
                        let qtyToAdd = parseInt(formData.get('quantity')) || 1;
                        cartBadge.innerText = currentQty + qtyToAdd;
                        cartBadge.classList.add('has-items');
                    }
                    
                    if (typeof window.showToast === 'function') window.showToast("Đã thêm vào giỏ hàng!", "success");

                    setTimeout(() => {
                        closeQuickAddModal();
                        btn.innerHTML = originalText;
                        btn.style.background = '';
                    }, 800);
                } else {
                    if (typeof window.showToast === 'function') window.showToast(data.message, "error");
                }
            }).catch(err => {
                console.error('Lỗi kết nối API:', err);
                if (typeof window.showToast === 'function') window.showToast("Mất kết nối máy chủ.", "error");
            }).finally(() => {
                btn.innerHTML = originalText;
                btn.style.background = '';
            });
        });

        // XỬ LÝ THÊM VÀO GIỎ CHO CÁC SẢN PHẨM GỢI Ý (BẢN CHỈ CÓ 1 BIẾN THỂ)
        document.querySelectorAll('.ajax-cart-form:not(#qa-form)').forEach(form => {
            form.addEventListener('submit', function(e) {
                e.preventDefault();
                const formData = new FormData(this);
                formData.append('actionType', 'add');

                const btn = this.querySelector('button[type="submit"]');
                const originalText = btn.innerHTML;
                btn.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i>...';

                fetch(this.action, {
                    method: this.method, body: formData,
                    headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }
                })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        btn.innerHTML = 'ĐÃ THÊM';
                        btn.style.background = '#10B981';
                        btn.style.color = 'white';
                        
                        const cartBadge = document.getElementById('header-cart-badge');
                        if (cartBadge) {
                            let currentQty = parseInt(cartBadge.innerText) || 0;
                            cartBadge.innerText = currentQty + 1;
                            cartBadge.classList.add('has-items');
                        }

                        if (typeof window.showToast === 'function') window.showToast("Sản phẩm đã được thêm vào Giỏ hàng", "success");
                        
                        setTimeout(() => {
                            btn.innerHTML = originalText;
                            btn.style.background = '';
                            btn.style.color = '';
                        }, 2000);
                    } else {
                        if (typeof window.showToast === 'function') window.showToast(data.message, "error");
                    }
                }).catch(err => {
                    if (typeof window.showToast === 'function') window.showToast("Mất kết nối máy chủ.", "error");
                }).finally(() => {
                    btn.innerHTML = originalText;
                    btn.style.background = '';
                    btn.style.color = '';
                });
            });
        });
    </script>
}