@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Quên mật khẩu";
}

<h2 style="font-size: 28px; margin-bottom: 8px;">Quên mật khẩu?</h2>
<p style="color: var(--auth-text-muted); margin-bottom: 28px;">Nhập email, chúng tôi sẽ gửi hướng dẫn đặt lại mật khẩu</p>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@Html.Raw(TempData["Success"])</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-error">@TempData["Error"]</div>
}

<form method="post" asp-action="ForgotPassword">
    @Html.AntiForgeryToken()

    <div class="form-group">
        <label class="form-label">Email</label>
        <input type="email" name="email" class="form-control" placeholder="name@example.com" required />
    </div>

    <button type="submit" class="btn-auth btn-primary">Gửi yêu cầu</button>

    <div class="auth-links" style="margin-top: 20px;">
        <a href="/Auth/Login">← Quay lại đăng nhập</a>
    </div>
</form>