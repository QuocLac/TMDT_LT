@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Đăng ký";
}

<h2 style="font-size: 28px; margin-bottom: 8px;">Tạo tài khoản</h2>
<p style="color: var(--auth-text-muted); margin-bottom: 28px;">Nhập thông tin của bạn để bắt đầu mua sắm</p>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<form method="post" asp-action="Register">
    @Html.AntiForgeryToken()

    <div class="form-group">
        <label class="form-label">Họ và tên</label>
        <input type="text" name="fullName" class="form-control" placeholder="Nguyễn Văn A" required />
    </div>
    <div class="form-group">
        <label class="form-label">Email</label>
        <input type="email" name="email" class="form-control" placeholder="name@example.com" required />
    </div>
    <div class="form-group">
        <label class="form-label">Số điện thoại</label>
        <input type="tel" name="phone" class="form-control" placeholder="0901234567" />
    </div>
    <div class="form-group">
        <label class="form-label">Mật khẩu</label>
        <input type="password" name="password" class="form-control" placeholder="Ít nhất 6 ký tự" required minlength="6" />
    </div>

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
    {
        <div class="alert alert-error">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <span>@error.ErrorMessage</span>
        
                <br />
            }
        </div>
    }

    <button type="submit" class="btn-auth btn-primary">Đăng ký</button>

    <div class="auth-links" style="margin-top: 20px;">
        Đã có tài khoản? <a href="/Auth/Login">Đăng nhập ngay</a>
    </div>
</form>