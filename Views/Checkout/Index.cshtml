@model TMDT_LT.Models.ViewModels.Storefront.CheckoutVM
@{
    Layout = "_Layout";
    ViewData["Title"] = "Thanh toán đơn hàng";

    // Lấy địa chỉ mặc định để hiển thị đầu tiên
    var defaultAddress = Model.SavedAddresses.FirstOrDefault(a => a.IsDefault == true)
                         ?? Model.SavedAddresses.FirstOrDefault();
}

@section Styles {
    <link rel="stylesheet" href="~/css/storefront/store-home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/storefront/store-checkout.css" asp-append-version="true" />
}

<form asp-controller="Checkout" asp-action="PlaceOrder" method="post" id="formCheckout">
    @Html.AntiForgeryToken()
    <input type="hidden" name="addressId" id="selectedAddressId" value="@(defaultAddress?.AddressId ?? 0)" />

    <div class="checkout-grid">
        <div>
            <div class="checkout-section-box address-box">
                <div class="shopee-address-border"></div>
                <div class="address-content-wrap">

                    <div class="section-title" style="border:none; padding:0; margin-bottom: 16px; color: var(--navy-deep);">
                        <i class="fas fa-map-marker-alt"></i> Địa chỉ nhận hàng
                    </div>

                    @if (defaultAddress != null)
                    {
                        <div id="displayAddressBlock" style="display: flex; justify-content: space-between; align-items: center;">
                            <div>
                                <div style="font-weight: 800; color: var(--navy-deep); font-size: 15px; margin-bottom: 4px;">
                                    <span id="dispName">@(defaultAddress.ReceiverName ?? Model.CustomerName)</span>
                                    <span style="font-weight: 500; color: #6B7280; margin-left: 10px;" id="dispPhone">@(defaultAddress.ReceiverPhone ?? Model.CustomerPhone)</span>
                                </div>
                                <div style="font-size: 14px; color: #475569;" id="dispFullAddress">
                                    @defaultAddress.Street, @defaultAddress.Ward, @defaultAddress.District, @defaultAddress.City
                                </div>
                            </div>
                            <button type="button" class="btn-text-action" onclick="openAddressModal()">THAY ĐỔI</button>
                        </div>
                    }
                    else
                    {
                        <div id="displayAddressBlock" class="empty-address-alert">
                            <i class="fas fa-exclamation-circle" style="font-size: 24px; margin-bottom: 10px; display: block;"></i>
                            Bạn chưa có thông tin nhận hàng.<br>
                            <button type="button" class="btn-dark" style="margin-top: 16px;" onclick="openAddressModal('add')">
                                <i class="fas fa-plus"></i> THÊM ĐỊA CHỈ MỚI
                            </button>
                        </div>
                    }
                </div>
            </div>

            <div class="checkout-section-box">
                <div class="section-title"><i class="fas fa-box"></i> Chi tiết kiện hàng chính hãng</div>
                @foreach (var item in Model.CartItems)
                {
                    <div class="checkout-prod-row">
                        <img src="@item.ImageUrl" class="checkout-prod-img" />
                        <div style="flex: 1;">
                            <div style="font-weight: 700; color: var(--navy-deep); font-size: 14px;">@item.ProductName</div>
                            <div style="font-size: 12px; color: #6B7280; margin-top: 2px;">Cấu hình: @item.Storage | Màu: @item.Color</div>
                        </div>
                        <div style="text-align: right;">
                            <div style="font-weight: 700; color: var(--navy-deep); font-size: 14px;">@string.Format("{0:N0}", item.Price) đ</div>
                            <div style="font-size: 12px; color: #9CA3AF; margin-top: 2px;">Số lượng: x@(item.Quantity)</div>
                        </div>
                    </div>
                }
                <div style="margin-top: 20px;">
                    <label style="font-size: 12px; font-weight: 700; color: var(--navy-medium); display: block; margin-bottom: 6px;">LƯU Ý HOẶC LỜI NHẮN</label>
                    <input type="text" name="note" placeholder="Ví dụ: Giao giờ hành chính..." class="checkout-input" />
                </div>
            </div>

            <div class="checkout-section-box">
                <div class="section-title"><i class="fas fa-credit-card"></i> Phương thức thanh toán bảo mật</div>
                <label class="payment-method-row">
                    <input type="radio" name="paymentMethod" value="COD" checked />
                    <i class="fas fa-truck" style="font-size: 20px; color: #6B7280; width: 24px;"></i>
                    <div>
                        <div style="font-weight: 700; color: var(--navy-deep); font-size: 14px;">Thanh toán khi nhận hàng (COD)</div>
                        <div style="font-size: 12px; color: #6B7280; margin-top: 2px;">Thanh toán bằng tiền mặt khi shipper giao hàng</div>
                    </div>
                </label>
                <label class="payment-method-row">
                    <input type="radio" name="paymentMethod" value="VNPAY" />
                    <i class="fas fa-university" style="font-size: 20px; color: #3B82F6; width: 24px;"></i>
                    <div>
                        <div style="font-weight: 700; color: var(--navy-deep); font-size: 14px;">Liên kết ứng dụng Ngân hàng (VNPAY-QR)</div>
                        <div style="font-size: 12px; color: #6B7280; margin-top: 2px;">Thanh toán trực tuyến để được xử lý hoàn tiền tự động</div>
                    </div>
                </label>
            </div>
        </div>

        <div class="summary-sticky-box">
            <div class="checkout-section-box" style="border-top: 4px solid var(--navy-deep);">
                <div style="font-size: 15px; font-weight: 800; color: var(--navy-deep); margin-bottom: 20px; text-transform: uppercase;">Tóm tắt thanh toán</div>
                <div class="bill-row"><span>Tổng tiền hàng</span><span style="font-weight: 700; color: var(--navy-deep);">@string.Format("{0:N0}", Model.Subtotal) đ</span></div>

                <div class="bill-row">
                    <span>Voucher đã giảm</span>
                    <span style="color: var(--success-green, #059669); font-weight: 700;">-(@string.Format("{0:N0}", Model.DiscountAmount) đ)</span>
                </div>

                <div class="bill-row"><span>Phí vận chuyển</span><span id="lblShippingFee" style="font-weight: 700; color: var(--navy-deep);">@string.Format("{0:N0}", Model.ShippingFee) đ</span></div>

                <div class="bill-total-row">
                    <span>Tổng thanh toán</span>
                    <span id="lblFinalTotal" style="font-size: 20px; color: var(--navy-deep);">@string.Format("{0:N0}", Model.FinalTotal) đ</span>
                </div>
                <button type="submit" id="btnSubmitOrder" class="btn-dark">Đặt hàng ngay</button>
            </div>
        </div>
    </div>
</form>

<div class="store-modal-overlay" id="addressModalOverlay">
    <div class="store-modal-content">
        <div class="store-modal-header">
            <span id="modalTitle">Địa chỉ của tôi</span>
            <button type="button" class="btn-close" onclick="closeAddressModal()"><i class="fas fa-times"></i></button>
        </div>

        <div class="store-modal-body" id="modalViewList">
            <div id="addressListContainer">
                @foreach (var addr in Model.SavedAddresses)
                {
                    <label class="modal-address-item" style="cursor:pointer; display:flex; gap: 12px; width: 100%;">
                        <input type="radio" name="modalAddressSelect" value="@addr.AddressId"
                               data-name="@(addr.ReceiverName ?? Model.CustomerName)"
                               data-phone="@(addr.ReceiverPhone ?? Model.CustomerPhone)"
                               data-street="@addr.Street" data-ward="@addr.Ward" data-district="@addr.District" data-city="@addr.City"
                               style="margin-top: 4px;" @(addr.IsDefault == true ? "checked" : "") />
                        <div style="flex:1;">
                            <div style="font-weight: 700; color: var(--navy-deep); font-size: 14px; margin-bottom: 4px;">
                                @(addr.ReceiverName ?? Model.CustomerName) | @(addr.ReceiverPhone ?? Model.CustomerPhone)
                            </div>
                            <div style="font-size: 13px; color: #475569; margin-bottom: 4px;">@addr.Street, @addr.Ward, @addr.District, @addr.City</div>
                            @if (addr.IsDefault == true)
                            {
                                <span class="badge-default-address" style="margin-left:0;">Mặc định</span>
                            }
                        </div>
                        <button type="button" class="btn-text-action" style="font-size: 12px; color: #94A3B8;" onclick="deleteAddress(@addr.AddressId)">Xóa</button>
                    </label>
                }
            </div>

            <button type="button" class="btn-outline" style="width: 100%; margin-top: 16px; padding: 12px; border-style: dashed;" onclick="switchModalView('form')">
                <i class="fas fa-plus"></i> Thêm Địa Chỉ Mới
            </button>

            <div style="display: flex; gap: 10px; margin-top: 24px;">
                <button type="button" class="btn-outline" style="flex:1;" onclick="closeAddressModal()">Hủy</button>
                <button type="button" class="btn-dark" style="flex:1;" onclick="confirmSelectedAddress()">Xác nhận</button>
            </div>
        </div>

        <div class="store-modal-body" id="modalViewForm" style="display: none;">
            <form id="ajaxAddressForm">
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px;">
                    <input type="text" id="frmName" placeholder="Họ và tên người nhận" class="checkout-input" required />
                    <input type="text" id="frmPhone" placeholder="Số điện thoại" class="checkout-input" required />
                </div>

                <div class="form-grid-3">
                    <select id="ddlProvince" class="checkout-input" onchange="onProvinceChange()" required>
                        <option value="">Tỉnh / Thành</option>
                    </select>
                    <select id="ddlDistrict" class="checkout-input" disabled onchange="onDistrictChange()" required>
                        <option value="">Quận / Huyện</option>
                    </select>
                    <select id="ddlWard" class="checkout-input" disabled required>
                        <option value="">Phường / Xã</option>
                    </select>
                </div>

                <input type="text" id="frmStreet" placeholder="Số nhà, tên đường, tòa nhà..." class="checkout-input" style="margin-top: 12px;" required />

                <label style="display: flex; align-items: center; gap: 8px; margin-top: 16px; cursor: pointer;">
                    <input type="checkbox" id="frmIsDefault" checked /> <span style="font-size: 13px; font-weight: 600;">Đặt làm địa chỉ mặc định</span>
                </label>

                <div style="display: flex; gap: 10px; margin-top: 24px;">
                    <button type="button" class="btn-outline" style="flex:1;" onclick="switchModalView('list')">Trở lại</button>
                    <button type="button" class="btn-dark" style="flex:1;" onclick="saveAddressAjax()">Hoàn thành</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // SỬA LỖI SẬP JAVASCRIPT: In số theo chuẩn quốc tế để JS đọc được
        let baseSubtotal = @Model.Subtotal.ToString(System.Globalization.CultureInfo.InvariantCulture);
        let baseDiscount = @Model.DiscountAmount.ToString(System.Globalization.CultureInfo.InvariantCulture);

        // KIỂM TRA TRẠNG THÁI NÚT ĐẶT HÀNG KHI LOAD TRANG
        document.addEventListener('DOMContentLoaded', () => {
            if(document.getElementById('selectedAddressId').value === "0") {
                document.getElementById('btnSubmitOrder').disabled = true;
                document.getElementById('btnSubmitOrder').style.opacity = 0.5;
            }
            loadProvinces(); // Nạp sẵn API Tỉnh thành ngầm
        });

        // =========================================================
        // ĐỘNG CƠ MODAL QUẢN LÝ ĐỊA CHỈ
        // =========================================================
        function openAddressModal(view = 'list') {
            document.getElementById('addressModalOverlay').classList.add('show');
            switchModalView(view);
        }

        function closeAddressModal() {
            document.getElementById('addressModalOverlay').classList.remove('show');
        }

        function switchModalView(view) {
            if (view === 'list') {
                document.getElementById('modalViewList').style.display = 'block';
                document.getElementById('modalViewForm').style.display = 'none';
                document.getElementById('modalTitle').innerText = 'Địa chỉ của tôi';
            } else {
                document.getElementById('modalViewList').style.display = 'none';
                document.getElementById('modalViewForm').style.display = 'block';
                document.getElementById('modalTitle').innerText = 'Thêm địa chỉ mới';
            }
        }

        function confirmSelectedAddress() {
            const selectedRadio = document.querySelector('input[name="modalAddressSelect"]:checked');
            if (selectedRadio) {
                // Cập nhật Input ẩn
                document.getElementById('selectedAddressId').value = selectedRadio.value;
                // Mở khóa nút thanh toán
                document.getElementById('btnSubmitOrder').disabled = false;
                document.getElementById('btnSubmitOrder').style.opacity = 1;

                // Tạo giao diện Block hiển thị
                const block = document.getElementById('displayAddressBlock');
                block.className = '';
                block.style.cssText = 'display: flex; justify-content: space-between; align-items: center;';
                block.innerHTML = `
                    <div>
                        <div style="font-weight: 800; color: var(--navy-deep); font-size: 15px; margin-bottom: 4px;">
                            <span id="dispName">${selectedRadio.dataset.name}</span>
                            <span style="font-weight: 500; color: #6B7280; margin-left: 10px;" id="dispPhone">${selectedRadio.dataset.phone}</span>
                        </div>
                        <div style="font-size: 14px; color: #475569;" id="dispFullAddress">
                            ${selectedRadio.dataset.street}, ${selectedRadio.dataset.ward}, ${selectedRadio.dataset.district}, ${selectedRadio.dataset.city}
                        </div>
                    </div>
                    <button type="button" class="btn-text-action" onclick="openAddressModal()">THAY ĐỔI</button>
                `;

                closeAddressModal();
                fetchShippingFee(selectedRadio.dataset.district, selectedRadio.dataset.city);
            }
        }

        // =========================================================
        // AJAX CRUD: THÊM / XÓA ĐỊA CHỈ
        // =========================================================
        function saveAddressAjax() {
            const provSelect = document.getElementById('ddlProvince');
            const distSelect = document.getElementById('ddlDistrict');
            const wardSelect = document.getElementById('ddlWard');

            if(!provSelect.value || !distSelect.value || !wardSelect.value || !document.getElementById('frmName').value) {
                alert("Vui lòng điền đầy đủ thông tin!");
                return;
            }

            const formData = new FormData();
            formData.append('addressId', 0);
            formData.append('receiverName', document.getElementById('frmName').value);
            formData.append('receiverPhone', document.getElementById('frmPhone').value);
            formData.append('street', document.getElementById('frmStreet').value);
            formData.append('ward', wardSelect.options[wardSelect.selectedIndex].text);
            formData.append('district', distSelect.options[distSelect.selectedIndex].text);
            formData.append('city', provSelect.options[provSelect.selectedIndex].text);
            formData.append('isDefault', document.getElementById('frmIsDefault').checked);

            fetch('/Checkout/SaveAddressAjax', { method: 'POST', body: formData })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                }
            });
        }

        function deleteAddress(id) {
            if(confirm("Bạn có chắc chắn muốn xóa địa chỉ này?")) {
                const formData = new FormData();
                formData.append('addressId', id);
                fetch('/Checkout/DeleteAddressAjax', { method: 'POST', body: formData })
                .then(res => res.json())
                .then(data => { if(data.success) location.reload(); });
            }
        }

        // =========================================================
        // API TỈNH/THÀNH VÀ PHÍ VẬN CHUYỂN
        // =========================================================
        function loadProvinces() {
            fetch('https://provinces.open-api.vn/api/p/').then(res => res.json()).then(data => {
                const ddl = document.getElementById('ddlProvince');
                data.forEach(p => ddl.innerHTML += `<option value="${p.code}">${p.name}</option>`);
            });
        }

        function onProvinceChange() {
            const pCode = document.getElementById('ddlProvince').value;
            const ddlDist = document.getElementById('ddlDistrict');
            ddlDist.innerHTML = '<option value="">Quận / Huyện</option>';
            document.getElementById('ddlWard').innerHTML = '<option value="">Phường / Xã</option>';
            document.getElementById('ddlWard').disabled = true;
            if (!pCode) { ddlDist.disabled = true; return; }
            fetch(`https://provinces.open-api.vn/api/p/${pCode}?depth=2`).then(res => res.json()).then(data => {
                ddlDist.disabled = false;
                data.districts.forEach(d => ddlDist.innerHTML += `<option value="${d.code}">${d.name}</option>`);
            });
        }

        function onDistrictChange() {
            const dCode = document.getElementById('ddlDistrict').value;
            const ddlWard = document.getElementById('ddlWard');
            ddlWard.innerHTML = '<option value="">Phường / Xã</option>';

            if (!dCode) { ddlWard.disabled = true; return; }
            fetch(`https://provinces.open-api.vn/api/d/${dCode}?depth=2`).then(res => res.json()).then(data => {
                ddlWard.disabled = false;
                data.wards.forEach(w => ddlWard.innerHTML += `<option value="${w.code}">${w.name}</option>`);
            });
        }

        function onWardChange() {
            const provSelect = document.getElementById('ddlProvince');
            const distSelect = document.getElementById('ddlDistrict');

            const cityName = provSelect.options[provSelect.selectedIndex].text;
            const districtName = distSelect.options[distSelect.selectedIndex].text;

            fetchShippingFee(districtName, cityName);
        }

        function fetchShippingFee(district, province) {
            const formData = new FormData();
            formData.append('district', district);
            formData.append('ward', '');
            formData.append('carrierCode', 'GHN');

            fetch('/Checkout/CalculateShippingFee', { method: 'POST', body: formData })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    document.getElementById('lblShippingFee').innerText = data.feeFormatted;
                    let finalTotal = (baseSubtotal - baseDiscount) + data.fee;
                    document.getElementById('lblFinalTotal').innerText = new Intl.NumberFormat('vi-VN').format(finalTotal > 0 ? finalTotal : 0) + " đ";
                }
            });
        }
    </script>
}