@model TMDT_LT.Models.ViewModels.ProfileVM
@{
    Layout = "_Layout";
    ViewData["Title"] = "Thông tin tài khoản";
}

@section Styles {
    <style>
        .profile-container {
            max-width: 1000px;
            margin: 40px auto;
            display: grid;
            grid-template-columns: 300px 1fr;
            gap: 24px;
            padding: 0 16px;
        }

        .profile-card {
            background: #fff;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 24px;
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
        }

        /* Thẻ thành viên (Bên trái) */
        .member-card {
            text-align: center;
        }

        .member-avatar {
            width: 80px;
            height: 80px;
            background: #F1F5F9;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 32px;
            color: var(--navy-deep);
            margin: 0 auto 16px;
        }

        .member-name {
            font-size: 18px;
            font-weight: 700;
            color: var(--navy-deep);
            margin-bottom: 4px;
        }

        .member-tier {
            display: inline-block;
            padding: 4px 12px;
            background: #FEF3C7;
            color: #D97706;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
            margin-bottom: 16px;
        }

        .member-stats {
            display: flex;
            justify-content: space-between;
            border-top: 1px solid var(--border-color);
            padding-top: 16px;
            margin-top: 16px;
        }

        .stat-item {
            text-align: center;
            flex: 1;
        }

        .stat-value {
            font-size: 18px;
            font-weight: 700;
            color: var(--accent-red);
        }

        .stat-label {
            font-size: 12px;
            color: #6B7280;
        }

        /* Form nhập liệu (Bên phải) */
        .form-group {
            margin-bottom: 16px;
        }

        .form-label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            color: var(--navy-deep);
            margin-bottom: 6px;
        }

        .form-control {
            width: 100%;
            padding: 10px 14px;
            border: 1px solid var(--border-color);
            border-radius: 6px;
            font-size: 14px;
            box-sizing: border-box;
            transition: border-color 0.2s;
        }

            .form-control:focus {
                outline: none;
                border-color: var(--navy-deep);
            }

            .form-control:read-only {
                background: #F3F4F6;
                color: #6B7280;
                cursor: not-allowed;
            }

        .btn-submit {
            background: var(--navy-deep);
            color: #fff;
            padding: 12px 24px;
            border: none;
            border-radius: 6px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.2s;
        }

            .btn-submit:hover {
                background: #0f172a;
            }
    </style>
}

<div class="profile-container">
    <div class="profile-card member-card">
        <div class="member-avatar">
            <i class="fas fa-user"></i>
        </div>
        <div class="member-name">@Model.FullName</div>
        <div class="member-tier"><i class="fas fa-crown"></i> Hạng: @Model.CustomerType</div>

        <div class="member-stats">
            <div class="stat-item">
                <div class="stat-value">@string.Format("{0:N0}", Model.RewardPoints)</div>
                <div class="stat-label">Điểm thưởng</div>
            </div>
            <div class="stat-item" style="border-left: 1px solid var(--border-color);">
                <div class="stat-value" style="color: var(--navy-deep);">@(Model.CreatedAt?.ToString("MM/yyyy") ?? "--")</div>
                <div class="stat-label">Tham gia</div>
            </div>
        </div>
    </div>

    <div class="profile-card">
        <h3 style="color: var(--navy-deep); margin-bottom: 24px; border-bottom: 1px solid var(--border-color); padding-bottom: 12px;">Hồ sơ cá nhân</h3>

        <form asp-action="UpdateProfile" asp-controller="Account" method="post">
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                <div class="form-group" style="grid-column: span 2;">
                    <label class="form-label">Địa chỉ Email (Tài khoản đăng nhập)</label>
                    <input type="text" class="form-control" value="@Model.Email" readonly />
                    <span style="font-size: 11px; color: #10B981; margin-top: 4px; display: block;"><i class="fas fa-check-circle"></i> Đã xác thực</span>
                </div>

                <div class="form-group">
                    <label class="form-label">Họ và tên</label>
                    <input type="text" asp-for="FullName" class="form-control" placeholder="Nhập họ và tên..." required />
                </div>

                <div class="form-group">
                    <label class="form-label">Số điện thoại</label>
                    <input type="text" asp-for="Phone" class="form-control" placeholder="Nhập số điện thoại..." />
                </div>

                <div class="form-group">
                    <label class="form-label">Giới tính</label>
                    <select asp-for="Gender" class="form-control">
                        <option value="">-- Chọn giới tính --</option>
                        <option value="Nam">Nam</option>
                        <option value="Nữ">Nữ</option>
                        <option value="Khác">Khác</option>
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label">Ngày sinh</label>
                    <input type="date" asp-for="BirthDate" class="form-control" value="@(Model.BirthDate?.ToString("yyyy-MM-dd"))" />
                </div>
            </div>

            <div style="margin-top: 24px; text-align: right;">
                <button type="submit" class="btn-submit">LƯU THAY ĐỔI</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // Đọc thông báo từ TempData và gọi hàm showToast của _Layout.cshtml
            @if (TempData["Success"] != null)
            {
                    <text>window.showToast('@TempData["Success"]', 'success');</text>
            }
            @if (TempData["Error"] != null)
            {
                    <text>window.showToast('@TempData["Error"]', 'error');</text>
            }
        });
    </script>
}