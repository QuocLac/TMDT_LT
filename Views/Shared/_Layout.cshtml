@using Microsoft.AspNetCore.Http
@using System.Text.Json
@using TMDT_LT.Models.ViewModels.Storefront
@using System.Security.Claims
@inject IHttpContextAccessor HttpContextAccessor

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PHONE.ST</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/storefront/store-root.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/storefront/store-layout.css" asp-append-version="true" />

    <style>
        /* User Menu */
        .user-menu-wrapper {
            position: relative;
            display: inline-block;
        }

            .user-menu-wrapper::after {
                content: '';
                position: absolute;
                top: 100%;
                left: 0;
                width: 100%;
                height: 15px;
            }

            .user-menu-wrapper:hover .user-dropdown {
                opacity: 1;
                visibility: visible;
                transform: translateY(0);
            }

        .user-dropdown {
            position: absolute;
            top: calc(100% + 12px);
            right: 0;
            width: 240px;
            background: #ffffff;
            border-radius: 8px;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
            opacity: 0;
            visibility: hidden;
            transform: translateY(10px);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            z-index: 1000;
            padding: 8px 0;
            border: 1px solid var(--border-color);
        }

        .dropdown-header-user {
            padding: 12px 16px;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .dropdown-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 16px;
            color: var(--navy-deep);
            text-decoration: none;
            font-size: 13px;
            font-weight: 600;
            transition: background 0.2s, color 0.2s;
            cursor: pointer;
            width: 100%;
            border: none;
            background: transparent;
            text-align: left;
            box-sizing: border-box;
        }

            .dropdown-item i {
                font-size: 14px;
                width: 18px;
                text-align: center;
                color: #9CA3AF;
                transition: color 0.2s;
            }

            .dropdown-item:hover {
                background: #F3F4F6;
                color: var(--accent-red);
            }

                .dropdown-item:hover i {
                    color: var(--accent-red);
                }

        .dropdown-divider {
            height: 1px;
            background: var(--border-color);
            margin: 6px 0;
        }

        /* Toast */
        #toast-container {
            position: fixed;
            bottom: 24px;
            right: 24px;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .toast-msg {
            min-width: 280px;
            background: #ffffff;
            color: var(--navy-deep);
            padding: 16px 20px;
            border-radius: 6px;
            box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1);
            display: flex;
            align-items: center;
            gap: 12px;
            font-weight: 600;
            font-size: 14px;
            border-left: 4px solid #10B981;
            transform: translateX(120%);
            transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

            .toast-msg.show {
                transform: translateX(0);
            }

            .toast-msg.success {
                border-left-color: #10B981;
            }

            .toast-msg.error {
                border-left-color: #EF4444;
            }

            .toast-msg i.success-icon {
                color: #10B981;
                font-size: 18px;
            }

            .toast-msg i.error-icon {
                color: #EF4444;
                font-size: 18px;
            }

        /* Cart Badge */
        .cart-badge {
            transition: all 0.3s ease;
            position: absolute;
            top: -6px;
            right: -10px;
            background: var(--navy-deep);
            color: var(--white);
            font-size: 10px;
            font-weight: 700;
            width: 16px;
            height: 16px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: monospace;
        }

            .cart-badge.has-items {
                background-color: var(--accent-red);
                animation: popBadge 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
            }

        @@keyframes popBadge {
            0% {
                transform: scale(1);
            }

            50% {
                transform: scale(1.4);
            }

            100% {
                transform: scale(1);
            }
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @{
        // Đếm số lượng vật phẩm trong giỏ hàng
        int totalCartItems = 0;
        if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            var dbContext = Context.RequestServices.GetService<TMDT_LT.Data.ApplicationDbContext>();
            var customerIdStr = User.FindFirstValue("CustomerId");
            if (int.TryParse(customerIdStr, out int cusId) && dbContext != null)
            {
                totalCartItems = dbContext.CartItems.Where(c => c.CustomerId == cusId).Sum(c => c.Quantity) ?? 0;
            }
        }
        else
        {
            var cartCookie = HttpContextAccessor.HttpContext?.Request.Cookies["PhoneStCartCookie"];
            if (!string.IsNullOrEmpty(cartCookie))
            {
                try
                {
                    var cart = JsonSerializer.Deserialize<List<CartItemVM>>(cartCookie);
                    totalCartItems = cart?.Sum(x => x.Quantity) ?? 0;
                }
                catch { }
            }
        }
    }

    <header class="site-header">
        <div class="header-container">
            <a href="/" class="brand-logo">KingPhone</a>

            <form action="/Store" method="get" class="search-bar-form" id="global-search-form">
                <div class="search-input-group">
                    <input type="text" name="keyword" id="global-search-input"
                           placeholder="Tìm tên máy, thương hiệu, danh mục..." autocomplete="off">
                    <button type="submit" class="search-submit-btn">
                        <i class="fas fa-search"></i>
                    </button>
                    <!-- Dropdown gợi ý -->
                    <div id="global-suggestions-box" class="shopee-search-dropdown-box"></div>
                </div>
            </form>

            <nav class="nav-menu">
                <a href="/" class="nav-link">Trang chủ</a>
                <a href="/Store" class="nav-link">Sản phẩm</a>
                <a href="/Blog" class="nav-link">Tin công nghệ</a>
                <a href="/Home/About" class="nav-link">Giới thiệu</a>
            </nav>

            <div class="action-menu">
                <a href="/Cart" class="action-item" title="Giỏ hàng cá nhân" style="position:relative;">
                    <i class="fas fa-shopping-bag"></i>
                    <span id="header-cart-badge" class="cart-badge @(totalCartItems > 0 ? "has-items" : "")">@totalCartItems</span>
                </a>

                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <div class="user-menu-wrapper">
                        <a href="/Account/Profile" class="action-item" title="Trung tâm tài khoản">
                            <i class="fas fa-user-circle" style="color: var(--navy-deep);"></i>
                        </a>
                        <div class="user-dropdown">
                            <div class="dropdown-header-user">
                                <strong style="font-size: 14px; color: var(--navy-deep);">@User.Identity.Name</strong>
                                <span style="font-size: 11px; color: #10B981; font-weight: 700;"><i class="fas fa-shield-check"></i> Đã xác thực</span>
                            </div>
                            <div class="dropdown-divider"></div>
                            <a href="/Account/Profile" class="dropdown-item">
                                <i class="fas fa-id-card"></i> Thông tin tài khoản
                            </a>
                            <a href="/CustomerWallet" class="dropdown-item"><i class="fas fa-ticket-alt"></i> Ví Voucher của tôi</a>
                            <a href="/Customer/Orders" class="dropdown-item"><i class="fas fa-box-open"></i> Quản lý đơn hàng</a>
                            <a href="/Account/Favorites" class="dropdown-item"><i class="fas fa-heart"></i> Sản phẩm yêu thích</a>
                            <a href="/Account/Notifications" class="dropdown-item"><i class="fas fa-bell"></i> Thông báo hệ thống</a>
                            <div class="dropdown-divider"></div>
                            <form action="/Auth/Logout" method="post" style="margin: 0;">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item"><i class="fas fa-sign-out-alt"></i> Đăng xuất</button>
                            </form>
                        </div>
                    </div>
                }
                else
                {
                    <a href="/Auth/Login" class="action-item" title="Đăng nhập / Đăng ký"><i class="fas fa-user"></i></a>
                }
            </div>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="main-footer">
        <div class="footer-container">
            <div>
                <h4>PHONE.ST STORE</h4>
                <p>Hệ thống bán lẻ thiết bị di động chuẩn công nghệ cao.</p>
            </div>
            <div>
                <h4>Chính sách</h4>
                <p>Bảo hành 12 tháng chính hãng quốc tế.</p>
            </div>
            <div>
                <h4>Liên kết</h4>
                <p>Tuyển dụng nhân sự bảo trì mạng máy tính.</p>
            </div>
            <div>
                <h4>Tổng đài</h4>
                <p style="font-weight:700; color:#fff;">1900.xxxx (8:00 - 21:30)</p>
            </div>
        </div>
    </footer>

    <div id="toast-container"></div>

    <script>
        // Toast
        window.showToast = function(message, type = 'success') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = `toast-msg ${type}`;
            const icon = type === 'success' ? '<i class="fas fa-check-circle success-icon"></i>' : '<i class="fas fa-exclamation-circle error-icon"></i>';
            toast.innerHTML = `${icon} <span>${message}</span>`;
            container.appendChild(toast);
            setTimeout(() => toast.classList.add('show'), 10);
            setTimeout(() => {
                toast.classList.remove('show');
                setTimeout(() => toast.remove(), 400);
            }, 3000);
        };

        // ================================================================
        // TÌM KIẾM GỢI Ý DROPDOWN (KIỂU SHOPEE) - TOÀN CỤC
        // ================================================================
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.getElementById('global-search-input');
            const suggestionsBox = document.getElementById('global-suggestions-box');
            const searchForm = document.getElementById('global-search-form');
            let debounceTimer;

            if (!searchInput || !suggestionsBox) {
                console.warn('Không tìm thấy input hoặc dropdown gợi ý');
                return;
            }

            // Hàm fetch gợi ý từ API
            function fetchSuggestions(query) {
                const url = `/Store/GetSearchSuggestions?q=${encodeURIComponent(query)}`;
                fetch(url)
                    .then(res => {
                        if (!res.ok) throw new Error('HTTP ' + res.status);
                        return res.json();
                    })
                    .then(data => {
                        let html = '';
                        if (data.phrases && data.phrases.length > 0) {
                            data.phrases.forEach(phrase => {
                                const safePhrase = phrase.replace(/'/g, "\\'").replace(/"/g, '&quot;');
                                html += `
                                    <div class="shopee-suggestion-row" onclick="window.applySuggestion('${safePhrase}')">
                                        <i class="fas fa-search"></i>
                                        <span>${phrase}</span>
                                    </div>`;
                            });
                            suggestionsBox.innerHTML = html;
                            suggestionsBox.style.display = 'block';
                        } else {
                            suggestionsBox.style.display = 'none';
                        }
                    })
                    .catch(err => {
                        console.error('Lỗi fetch gợi ý:', err);
                        suggestionsBox.style.display = 'none';
                    });
            }

            // Hàm áp dụng gợi ý (global)
            window.applySuggestion = function(phrase) {
                if (!searchInput) return;
                searchInput.value = phrase;
                suggestionsBox.style.display = 'none';
                if (searchForm) {
                    searchForm.submit();
                } else {
                    const submitBtn = document.querySelector('.search-submit-btn');
                    if (submitBtn) submitBtn.click();
                }
            };

            // Sự kiện focus: hiển thị gợi ý
            searchInput.addEventListener('focus', function() {
                const val = this.value.trim();
                if (val !== '') {
                    fetchSuggestions(val);
                } else {
                    fetchSuggestions(''); // gợi ý hot
                }
            });

            // Sự kiện input: debounce 300ms
            searchInput.addEventListener('input', function() {
                clearTimeout(debounceTimer);
                const val = this.value.trim();
                debounceTimer = setTimeout(() => {
                    fetchSuggestions(val);
                }, 300);
            });

            // Ẩn dropdown khi click ra ngoài
            document.addEventListener('click', function(e) {
                if (!searchInput.contains(e.target) && !suggestionsBox.contains(e.target)) {
                    suggestionsBox.style.display = 'none';
                }
            });

            // Phím ESC để đóng dropdown
            searchInput.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                    suggestionsBox.style.display = 'none';
                }
            });

            // Khi submit form (Enter), đóng dropdown
            if (searchForm) {
                searchForm.addEventListener('submit', function() {
                    suggestionsBox.style.display = 'none';
                });
            }

            // Tự động mở dropdown khi trang load với từ khóa có sẵn (trên trang kết quả)
            if (searchInput.value.trim() !== '') {
                fetchSuggestions(searchInput.value.trim());
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>