@using Microsoft.AspNetCore.Http
@using System.Text.Json
@using TMDT_LT.Models.ViewModels.Storefront
@using System.Security.Claims
@inject IHttpContextAccessor HttpContextAccessor
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KingPhone</title>
    @{
        var gaMeasurementId = Configuration["GoogleAnalytics:MeasurementId"];
        var gaEnabled = string.Equals(Configuration["GoogleAnalytics:Enabled"], "true", System.StringComparison.OrdinalIgnoreCase)
            && !string.IsNullOrWhiteSpace(gaMeasurementId)
            && !gaMeasurementId.Contains("YOUR", System.StringComparison.OrdinalIgnoreCase);
        var commerceCustomerId = User.Identity?.IsAuthenticated == true
            ? (User.FindFirst("CustomerId")?.Value ?? User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "")
            : "";
    }
    @if (gaEnabled)
    {
        <script async src="https://www.googletagmanager.com/gtag/js?id=@gaMeasurementId"></script>
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag(){ dataLayer.push(arguments); }
            gtag('js', new Date());
            gtag('config', '@gaMeasurementId', {
                user_id: '@(User.Identity?.IsAuthenticated == true ? (User.FindFirst("CustomerId")?.Value ?? User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "") : "")',
                currency: 'VND'
            });
        </script>
    }

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/storefront/store-root.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/storefront/store-layout.css" asp-append-version="true" />

    <style>
        /* User Menu */
        .user-menu-wrapper {
            position: relative;
            display: inline-block;
        }

            .user-menu-wrapper::after {
                content: '';
                position: absolute;
                top: 100%;
                left: 0;
                width: 100%;
                height: 15px;
            }

            .user-menu-wrapper:hover .user-dropdown {
                opacity: 1;
                visibility: visible;
                transform: translateY(0);
            }

        .user-dropdown {
            position: absolute;
            top: calc(100% + 12px);
            right: 0;
            width: 240px;
            background: #ffffff;
            border-radius: 8px;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
            opacity: 0;
            visibility: hidden;
            transform: translateY(10px);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            z-index: 1000;
            padding: 8px 0;
            border: 1px solid var(--border-color);
        }

        .dropdown-header-user {
            padding: 12px 16px;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .dropdown-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 16px;
            color: var(--navy-deep);
            text-decoration: none;
            font-size: 13px;
            font-weight: 600;
            transition: background 0.2s, color 0.2s;
            cursor: pointer;
            width: 100%;
            border: none;
            background: transparent;
            text-align: left;
            box-sizing: border-box;
        }

            .dropdown-item i {
                font-size: 14px;
                width: 18px;
                text-align: center;
                color: #9CA3AF;
                transition: color 0.2s;
            }

            .dropdown-item:hover {
                background: #F3F4F6;
                color: var(--accent-red);
            }

                .dropdown-item:hover i {
                    color: var(--accent-red);
                }

        .dropdown-divider {
            height: 1px;
            background: var(--border-color);
            margin: 6px 0;
        }

        /* Toast */
        #toast-container {
            position: fixed;
            bottom: 24px;
            right: 24px;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .toast-msg {
            min-width: 280px;
            background: #ffffff;
            color: var(--navy-deep);
            padding: 16px 20px;
            border-radius: 6px;
            box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1);
            display: flex;
            align-items: center;
            gap: 12px;
            font-weight: 600;
            font-size: 14px;
            border-left: 4px solid #10B981;
            transform: translateX(120%);
            transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

            .toast-msg.show {
                transform: translateX(0);
            }

            .toast-msg.success {
                border-left-color: #10B981;
            }

            .toast-msg.error {
                border-left-color: #EF4444;
            }

            .toast-msg i.success-icon {
                color: #10B981;
                font-size: 18px;
            }

            .toast-msg i.error-icon {
                color: #EF4444;
                font-size: 18px;
            }

        /* Cart Badge */
        .cart-badge {
            transition: all 0.3s ease;
            position: absolute;
            top: -6px;
            right: -10px;
            background: var(--navy-deep);
            color: var(--white);
            font-size: 10px;
            font-weight: 700;
            width: 16px;
            height: 16px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: monospace;
        }

            .cart-badge.has-items {
                background-color: var(--accent-red);
                animation: popBadge 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
            }

        @@keyframes popBadge {
            0% {
                transform: scale(1);
            }

            50% {
                transform: scale(1.4);
            }

            100% {
                transform: scale(1);
            }
        }


        /* Commerce Search Autocomplete */
        .search-input-group {
            position: relative;
        }

        .shopee-search-dropdown-box {
            position: absolute;
            top: calc(100% + 8px);
            left: 0;
            right: 0;
            background: #fff;
            border: 1px solid #E5E7EB;
            box-shadow: 0 18px 40px rgba(15, 23, 42, 0.16);
            border-radius: 10px;
            z-index: 2000;
            display: none;
            overflow: hidden;
            max-height: min(520px, calc(100vh - 130px));
        }

        .commerce-search-panel {
            padding: 8px 0;
            max-height: min(520px, calc(100vh - 130px));
            overflow-y: auto;
            overscroll-behavior: contain;
            -webkit-overflow-scrolling: touch;
            scrollbar-width: thin;
        }

            .commerce-search-panel::-webkit-scrollbar {
                width: 8px;
            }

            .commerce-search-panel::-webkit-scrollbar-thumb {
                background: #CBD5E1;
                border-radius: 999px;
            }

            .commerce-search-panel::-webkit-scrollbar-track {
                background: #F8FAFC;
            }

        .commerce-search-section {
            padding: 6px 0;
        }

        .commerce-search-title {
            padding: 8px 14px 6px;
            font-size: 11px;
            font-weight: 800;
            color: #64748B;
            letter-spacing: .04em;
            text-transform: uppercase;
        }

        .commerce-suggestion-row,
        .commerce-taxonomy-row,
        .commerce-product-row {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 14px;
            cursor: pointer;
            text-decoration: none;
            color: var(--navy-deep);
            border-top: 1px solid transparent;
            border-bottom: 1px solid transparent;
        }

        .commerce-suggestion-row:hover,
        .commerce-taxonomy-row:hover,
        .commerce-product-row:hover,
        .commerce-suggestion-row.active,
        .commerce-taxonomy-row.active,
        .commerce-product-row.active {
            background: #F8FAFC;
            border-color: #EEF2F7;
        }

        .commerce-suggestion-row i,
        .commerce-taxonomy-row i {
            color: #64748B;
            width: 18px;
            text-align: center;
        }

        .commerce-product-thumb {
            width: 46px;
            height: 46px;
            border-radius: 8px;
            object-fit: contain;
            background: #F8FAFC;
            border: 1px solid #E5E7EB;
            padding: 4px;
            flex-shrink: 0;
        }

        .commerce-product-info {
            min-width: 0;
            flex: 1;
        }

        .commerce-product-name {
            font-size: 13px;
            font-weight: 800;
            color: var(--navy-deep);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            margin-bottom: 3px;
        }

        .commerce-product-meta {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 11px;
            color: #64748B;
            flex-wrap: wrap;
        }

        .commerce-product-price {
            color: #DC2626;
            font-weight: 900;
            font-size: 13px;
        }

        .commerce-product-old-price {
            color: #94A3B8;
            text-decoration: line-through;
            font-size: 11px;
        }

        .commerce-sale-badge {
            background: #DC2626;
            color: #fff;
            border-radius: 999px;
            font-size: 10px;
            font-weight: 900;
            padding: 2px 6px;
            white-space: nowrap;
        }

        .commerce-empty-search {
            padding: 18px 14px;
            text-align: center;
            color: #64748B;
            font-size: 13px;
            font-weight: 600;
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @{
        // Đếm số lượng vật phẩm trong giỏ hàng
        string currentHeaderKeyword = Context.Request.Query["keyword"].ToString();
        int totalCartItems = 0;
        if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            var dbContext = Context.RequestServices.GetService<TMDT_LT.Data.ApplicationDbContext>();
            var customerIdStr = User.FindFirstValue("CustomerId");
            if (int.TryParse(customerIdStr, out int cusId) && dbContext != null)
            {
                totalCartItems = dbContext.CartItems.Where(c => c.CustomerId == cusId).Sum(c => c.Quantity) ?? 0;
            }
        }
        else
        {
            var cartCookie = HttpContextAccessor.HttpContext?.Request.Cookies["PhoneStCartCookie"];
            if (!string.IsNullOrEmpty(cartCookie))
            {
                try
                {
                    var cart = JsonSerializer.Deserialize<List<CartItemVM>>(cartCookie);
                    totalCartItems = cart?.Sum(x => x.Quantity) ?? 0;
                }
                catch { }
            }
        }
    }

    <header class="site-header">
        <div class="header-container">
            <a href="/" class="brand-logo">KingPhone</a>

            <form action="/Store" method="get" class="search-bar-form" id="global-search-form">
                <div class="search-input-group">
                    <input type="text" name="keyword" id="global-search-input"
                           placeholder="Tìm iPhone 15 Pro Max, Samsung S24, máy chơi game..."
                           value="@currentHeaderKeyword"
                           autocomplete="off" aria-autocomplete="list" aria-expanded="false">
                    <button type="submit" class="search-submit-btn">
                        <i class="fas fa-search"></i>
                    </button>
                    <!-- Dropdown gợi ý -->
                    <div id="global-suggestions-box" class="shopee-search-dropdown-box"></div>
                </div>
            </form>

            <nav class="nav-menu">
                <a href="/" class="nav-link">Trang chủ</a>
                <a href="/Store" class="nav-link">Sản phẩm</a>
                <a href="/Blog" class="nav-link">Tin công nghệ</a>
                <a href="/Home/About" class="nav-link">Giới thiệu</a>
            </nav>

            <div class="action-menu">
                <a href="/Cart" class="action-item" title="Giỏ hàng cá nhân" style="position:relative;">
                    <i class="fas fa-shopping-bag"></i>
                    <span id="header-cart-badge" class="cart-badge @(totalCartItems > 0 ? "has-items" : "")">@totalCartItems</span>
                </a>

                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <div class="user-menu-wrapper">
                        <a href="/Account/Profile" class="action-item" title="Trung tâm tài khoản">
                            <i class="fas fa-user-circle" style="color: var(--navy-deep);"></i>
                        </a>
                        <div class="user-dropdown">
                            <div class="dropdown-header-user">
                                <strong style="font-size: 14px; color: var(--navy-deep);">@User.Identity.Name</strong>
                                <span style="font-size: 11px; color: #10B981; font-weight: 700;"><i class="fas fa-shield-check"></i> Đã xác thực</span>
                            </div>
                            <div class="dropdown-divider"></div>
                            <a href="/Account/Profile" class="dropdown-item">
                                <i class="fas fa-id-card"></i> Thông tin tài khoản
                            </a>
                            <a href="/CustomerWallet" class="dropdown-item"><i class="fas fa-ticket-alt"></i> Ví Voucher của tôi</a>
                            <a href="/Customer/Orders" class="dropdown-item"><i class="fas fa-box-open"></i> Quản lý đơn hàng</a>
                            <a href="/Account/Favorites" class="dropdown-item"><i class="fas fa-heart"></i> Sản phẩm yêu thích</a>
                            <a href="/Account/Notifications" class="dropdown-item"><i class="fas fa-bell"></i> Thông báo hệ thống</a>
                            <div class="dropdown-divider"></div>
                            <form action="/Auth/Logout" method="post" style="margin: 0;">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item"><i class="fas fa-sign-out-alt"></i> Đăng xuất</button>
                            </form>
                        </div>
                    </div>
                }
                else
                {
                    <a href="/Auth/Login" class="action-item" title="Đăng nhập / Đăng ký"><i class="fas fa-user"></i></a>
                }
            </div>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="main-footer">
        <div class="footer-container">
            <div>
                <h4>PHONE.ST STORE</h4>
                <p>Hệ thống bán lẻ thiết bị di động chuẩn công nghệ cao.</p>
            </div>
            <div>
                <h4>Chính sách</h4>
                <p>Bảo hành 12 tháng chính hãng quốc tế.</p>
            </div>
            <div>
                <h4>Liên kết</h4>
                <p>Tuyển dụng nhân sự bảo trì mạng máy tính.</p>
            </div>
            <div>
                <h4>Tổng đài</h4>
                <p style="font-weight:700; color:#fff;">1900.xxxx (8:00 - 21:30)</p>
            </div>
        </div>
    </footer>

    <div id="toast-container"></div>

    <script>
        // Toast
        window.showToast = function(message, type = 'success') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = `toast-msg ${type}`;
            const icon = type === 'success' ? '<i class="fas fa-check-circle success-icon"></i>' : '<i class="fas fa-exclamation-circle error-icon"></i>';
            toast.innerHTML = `${icon} <span>${message}</span>`;
            container.appendChild(toast);
            setTimeout(() => toast.classList.add('show'), 10);
            setTimeout(() => {
                toast.classList.remove('show');
                setTimeout(() => toast.remove(), 400);
            }, 3000);
        };


        // ================================================================
        // COMMERCE ANALYTICS - SESSION + GA4 EVENT BRIDGE
        // ================================================================
        (function () {
            const customerId = '@(User.Identity?.IsAuthenticated == true ? (User.FindFirst("CustomerId")?.Value ?? User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "") : "")';
            const visitorKey = 'phone_st_visitor_id';
            const sessionKey = 'phone_st_session_id';

            function uuid(prefix) {
                if (window.crypto && crypto.randomUUID) return prefix + '_' + crypto.randomUUID();
                return prefix + '_' + Date.now().toString(36) + '_' + Math.random().toString(36).substring(2, 12);
            }

            function getVisitorId() {
                let id = localStorage.getItem(visitorKey);
                if (!id) { id = uuid('vis'); localStorage.setItem(visitorKey, id); }
                return id;
            }

            function getSessionId() {
                let id = sessionStorage.getItem(sessionKey);
                if (!id) { id = uuid('sess'); sessionStorage.setItem(sessionKey, id); }
                return id;
            }

            function normalizeEventName(eventName) {
                return String(eventName || '').trim().toLowerCase().replace(/[^a-z0-9_]/g, '_');
            }

            function sendGaEvent(eventName, payload) {
                if (typeof window.gtag !== 'function') return;
                const gaPayload = Object.assign({}, payload || {});
                delete gaPayload.sessionId;
                delete gaPayload.visitorId;
                delete gaPayload.productId;
                delete gaPayload.variantId;
                delete gaPayload.targetProductId;
                delete gaPayload.orderId;
                delete gaPayload.metadata;
                window.gtag('event', eventName, gaPayload);
            }

            window.phoneCommerceAnalytics = {
                visitorId: getVisitorId(),
                sessionId: getSessionId(),
                track: function (eventName, data) {
                    const normalized = normalizeEventName(eventName);
                    if (!normalized) return;

                    const payload = Object.assign({
                        eventName: normalized,
                        visitorId: this.visitorId,
                        sessionId: this.sessionId,
                        pagePath: window.location.pathname + window.location.search,
                        referrer: document.referrer || ''
                    }, data || {});

                    try {
                        fetch('/Analytics/Track', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(payload),
                            keepalive: true
                        }).catch(() => {});
                    } catch { }

                    const gaEvents = ['view_item', 'view_item_list', 'select_item', 'add_to_cart', 'begin_checkout', 'purchase', 'search', 'add_to_wishlist'];
                    if (gaEvents.includes(normalized)) sendGaEvent(normalized, payload);
                }
            };

            document.addEventListener('DOMContentLoaded', function () {
                window.phoneCommerceAnalytics.track('page_view_internal', {
                    metadata: { title: document.title, customerId: customerId || null }
                });
            });
        })();

        // ================================================================
        // TÌM KIẾM GỢI Ý THƯƠNG MẠI - TOÀN CỤC
        // ================================================================
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('global-search-input');
            const suggestionsBox = document.getElementById('global-suggestions-box');
            const searchForm = document.getElementById('global-search-form');
            let debounceTimer;
            let activeIndex = -1;

            if (!searchInput || !suggestionsBox) return;

            function escapeHtml(value) {
                return String(value ?? '')
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#039;');
            }

            function formatCurrency(value) {
                const number = Number(value || 0);
                return number.toLocaleString('vi-VN') + ' đ';
            }

            function closeSuggestions() {
                suggestionsBox.style.display = 'none';
                suggestionsBox.innerHTML = '';
                activeIndex = -1;
                searchInput.setAttribute('aria-expanded', 'false');
            }

            function openSuggestions() {
                suggestionsBox.style.display = 'block';
                searchInput.setAttribute('aria-expanded', 'true');
            }

            function renderKeywordSection(items, title) {
                if (!items || items.length === 0) return '';
                const rows = items.map(item => `
                    <a class="commerce-suggestion-row commerce-search-option" href="${escapeHtml(item.url)}" data-label="${escapeHtml(item.label)}">
                        <i class="fas fa-search"></i>
                        <span>${escapeHtml(item.label)}</span>
                    </a>`).join('');
                return `<div class="commerce-search-section"><div class="commerce-search-title">${escapeHtml(title)}</div>${rows}</div>`;
            }

            function renderProductSection(items) {
                if (!items || items.length === 0) return '';
                const rows = items.map(item => {
                    const oldPrice = item.oldPrice ? `<span class="commerce-product-old-price">${formatCurrency(item.oldPrice)}</span>` : '';
                    const badge = item.isFlashSale ? '<span class="commerce-sale-badge">FLASH SALE</span>' : (item.hasSale ? '<span class="commerce-sale-badge">ƯU ĐÃI</span>' : '');
                    return `
                        <a class="commerce-product-row commerce-search-option" href="${escapeHtml(item.url)}" data-label="${escapeHtml(item.name)}">
                            <img class="commerce-product-thumb" src="${escapeHtml(item.imageUrl)}" alt="${escapeHtml(item.name)}" loading="lazy" />
                            <div class="commerce-product-info">
                                <div class="commerce-product-name">${escapeHtml(item.name)}</div>
                                <div class="commerce-product-meta">
                                    <span class="commerce-product-price">${formatCurrency(item.price)}</span>
                                    ${oldPrice}
                                    ${badge}
                                    <span>${escapeHtml(item.stockText)}</span>
                                </div>
                            </div>
                        </a>`;
                }).join('');
                return `<div class="commerce-search-section"><div class="commerce-search-title">Sản phẩm phù hợp</div>${rows}</div>`;
            }

            function renderTaxonomySection(items) {
                if (!items || items.length === 0) return '';
                const rows = items.map(item => `
                    <a class="commerce-taxonomy-row commerce-search-option" href="${escapeHtml(item.url)}" data-label="${escapeHtml(item.label)}">
                        <i class="fas ${escapeHtml(item.icon || 'fa-tag')}"></i>
                        <div>
                            <div style="font-size:13px;font-weight:800;">${escapeHtml(item.label)}</div>
                            <div style="font-size:11px;color:#64748B;font-weight:700;">${escapeHtml(item.subLabel)}</div>
                        </div>
                    </a>`).join('');
                return `<div class="commerce-search-section"><div class="commerce-search-title">Thương hiệu & danh mục</div>${rows}</div>`;
            }

            function renderSuggestions(data) {
                const sections = data.sections || {};
                let html = '<div class="commerce-search-panel">';
                html += renderKeywordSection(sections.keywords, data.isBlank ? 'Từ khóa thịnh hành' : 'Gợi ý tìm kiếm');
                html += renderProductSection(sections.products);
                html += renderTaxonomySection(sections.taxonomy);
                html += '</div>';

                if (!sections.keywords?.length && !sections.products?.length && !sections.taxonomy?.length) {
                    html = '<div class="commerce-empty-search">Không có gợi ý phù hợp. Nhấn Enter để xem toàn bộ kết quả.</div>';
                }

                suggestionsBox.innerHTML = html;
                openSuggestions();
            }

            function fetchSuggestions(query) {
                const url = `/Store/GetSearchSuggestions?q=${encodeURIComponent(query || '')}`;
                fetch(url)
                    .then(res => {
                        if (!res.ok) throw new Error('HTTP ' + res.status);
                        return res.json();
                    })
                    .then(renderSuggestions)
                    .catch(err => {
                        console.error('Lỗi gợi ý tìm kiếm:', err);
                        closeSuggestions();
                    });
            }

            window.applySuggestion = function (phrase) {
                searchInput.value = phrase;
                closeSuggestions();
                if (searchForm) searchForm.submit();
            };

            searchInput.addEventListener('focus', function () {
                fetchSuggestions(this.value.trim());
            });

            searchInput.addEventListener('input', function () {
                clearTimeout(debounceTimer);
                const value = this.value.trim();
                debounceTimer = setTimeout(() => fetchSuggestions(value), 220);
            });

            searchInput.addEventListener('keydown', function (e) {
                const options = Array.from(suggestionsBox.querySelectorAll('.commerce-search-option'));
                if (e.key === 'Escape') {
                    closeSuggestions();
                    return;
                }
                if (!options.length) return;

                if (e.key === 'ArrowDown') {
                    e.preventDefault();
                    activeIndex = (activeIndex + 1) % options.length;
                } else if (e.key === 'ArrowUp') {
                    e.preventDefault();
                    activeIndex = (activeIndex - 1 + options.length) % options.length;
                } else if (e.key === 'Enter' && activeIndex >= 0) {
                    e.preventDefault();
                    options[activeIndex].click();
                    return;
                } else {
                    return;
                }

                options.forEach(item => item.classList.remove('active'));
                options[activeIndex].classList.add('active');
                options[activeIndex].scrollIntoView({ block: 'nearest' });
            });

            suggestionsBox.addEventListener('wheel', function (e) {
                const panel = suggestionsBox.querySelector('.commerce-search-panel');
                if (!panel) return;

                const atTop = panel.scrollTop <= 0;
                const atBottom = Math.ceil(panel.scrollTop + panel.clientHeight) >= panel.scrollHeight;

                // Giữ thao tác cuộn nằm trong khung gợi ý, tránh kéo cả trang khi danh sách còn nội dung.
                if ((e.deltaY < 0 && !atTop) || (e.deltaY > 0 && !atBottom)) {
                    e.stopPropagation();
                }
            }, { passive: true });

            suggestionsBox.addEventListener('click', function (e) {
                const option = e.target.closest('.commerce-search-option');
                if (!option) return;
                const label = option.getAttribute('data-label');
                if (label) searchInput.value = label;
                closeSuggestions();
            });

            document.addEventListener('click', function (e) {
                if (!searchInput.contains(e.target) && !suggestionsBox.contains(e.target)) {
                    closeSuggestions();
                }
            });

            if (searchForm) {
                searchForm.addEventListener('submit', function () {
                    const keyword = searchInput.value.trim();
                    if (keyword && window.phoneCommerceAnalytics) {
                        window.phoneCommerceAnalytics.track('search', {
                            searchKeyword: keyword,
                            metadata: { source: 'header_search' }
                        });
                    }
                    closeSuggestions();
                });
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>