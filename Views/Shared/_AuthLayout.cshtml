<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KingPhone</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet">

    <!-- Global CSS (bao gồm biến màu) -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Auth-specific CSS -->
    <style>
        :root {
            --auth-primary: #0F172A;
            --auth-primary-hover: #1E293B;
            --auth-accent: #3B82F6;
            --auth-bg: #F8FAFC;
            --auth-card-bg: #FFFFFF;
            --auth-border: #E2E8F0;
            --auth-text: #0F172A;
            --auth-text-muted: #64748B;
            --auth-error: #EF4444;
            --auth-success: #10B981;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--auth-bg);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .auth-container {
            width: 100%;
            max-width: 480px;
            margin: 0 auto;
        }

        .brand-header {
            text-align: center;
            margin-bottom: 32px;
        }

        .brand-logo {
            font-size: 32px;
            font-weight: 800;
            text-decoration: none;
            color: var(--auth-primary);
            letter-spacing: -0.5px;
        }

            .brand-logo span {
                color: var(--auth-accent);
            }

        .auth-card {
            background: var(--auth-card-bg);
            border-radius: 24px;
            box-shadow: 0 20px 35px -8px rgba(0, 0, 0, 0.1);
            padding: 32px;
            border: 1px solid var(--auth-border);
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-label {
            display: block;
            font-size: 14px;
            font-weight: 600;
            color: var(--auth-text);
            margin-bottom: 8px;
        }

        .form-control {
            width: 100%;
            padding: 12px 16px;
            font-size: 14px;
            border: 1px solid var(--auth-border);
            border-radius: 12px;
            transition: all 0.2s;
            background: #fff;
        }

            .form-control:focus {
                outline: none;
                border-color: var(--auth-accent);
                box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
            }

        .btn-auth {
            width: 100%;
            padding: 12px;
            font-size: 16px;
            font-weight: 600;
            border: none;
            border-radius: 40px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .btn-primary {
            background: var(--auth-primary);
            color: white;
        }

            .btn-primary:hover {
                background: var(--auth-primary-hover);
                transform: translateY(-1px);
            }

        .auth-links {
            margin-top: 24px;
            text-align: center;
            font-size: 14px;
            color: var(--auth-text-muted);
        }

            .auth-links a {
                color: var(--auth-accent);
                text-decoration: none;
                font-weight: 600;
            }

                .auth-links a:hover {
                    text-decoration: underline;
                }

        .alert {
            padding: 12px 16px;
            border-radius: 12px;
            margin-bottom: 20px;
            font-size: 14px;
        }

        .alert-success {
            background: #D1FAE5;
            color: #065F46;
            border: 1px solid #A7F3D0;
        }

        .alert-error {
            background: #FEE2E2;
            color: #991B1B;
            border: 1px solid #FECACA;
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="auth-container">
        <div class="brand-header">
            <a href="/" class="brand-logo">King<span>Phone</span></a>
        </div>
        <div class="auth-card">
            @RenderBody()
        </div>
        <div class="auth-links" style="margin-top: 24px;">
            <a href="/">← Quay lại trang chủ</a>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>