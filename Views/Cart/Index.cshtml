@model List<TMDT_LT.Models.ViewModels.Storefront.CartItemVM>
@using TMDT_LT.Models.ViewModels.Storefront
@{
    Layout = "_Layout";
    ViewData["Title"] = "Giỏ hàng của bạn";

    var voucherStates = ViewBag.VoucherStates as List<CartVoucherStateVM>;
    var bestVoucher = voucherStates?.FirstOrDefault();
    decimal currentSubtotal = ViewBag.Subtotal ?? 0;
}

@section Styles {
    <link rel="stylesheet" href="~/css/storefront/store-home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/storefront/store-cart.css" asp-append-version="true" />
}

<div class="cart-layout-grid">
    <div class="cart-items-container">
        <h2 class="cart-title-main">Giỏ hàng của bạn (@Model.Count() sản phẩm)</h2>

        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <div class="cart-item-row" id="item-row-@item.VariantId">
                    <img src="@item.ImageUrl" alt="@item.ProductName" class="cart-item-img" />

                    <div>
                        <a href="/Store/Product/@item.VariantId" class="cart-item-title">@item.ProductName</a>
                        <div class="cart-item-variant">Phân loại: @item.Storage - @item.Color</div>
                        @if (item.Stock < 5)
                        {
                            <div class="cart-stock-warning">Chỉ còn @item.Stock sản phẩm</div>
                        }
                    </div>

                    <div class="qty-control">
                        <button type="button" class="qty-btn" onclick="updateQty(@item.VariantId, -1)">-</button>
                        <input type="number" id="qty-@item.VariantId" class="qty-input" value="@item.Quantity" readonly />
                        <button type="button" class="qty-btn" onclick="updateQty(@item.VariantId, 1)">+</button>
                    </div>

                    <div class="cart-item-price" id="price-@item.VariantId">
                        @string.Format("{0:N0}", item.TotalPrice) đ
                    </div>

                    <form action="/Cart/RemoveItem" method="post" class="cart-remove-form">
                        <input type="hidden" name="variantId" value="@item.VariantId" />
                        <button type="submit" class="cart-remove-btn" title="Xoá khỏi giỏ">
                            <i class="fas fa-trash-alt"></i>
                        </button>
                    </form>
                </div>
            }
        }
        else
        {
            <div class="cart-empty-wrapper">
                <i class="fas fa-shopping-basket" class="cart-empty-icon"></i>
                <h3 class="cart-empty-title">Giỏ hàng trống</h3>
                <p class="cart-empty-text">Hãy quay lại cửa hàng để chọn cho mình những sản phẩm ưng ý nhé.</p>
                <a href="/Store" class="btn-dark cart-empty-link">TIẾP TỤC MUA SẮM</a>
            </div>
        }
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="cart-summary-box">

            <div class="smart-voucher-box" id="smartVoucherContainer" style="@(bestVoucher == null ? "display:none;" : "")">
                <div class="voucher-header">
                    <i class="fas fa-ticket-alt"></i> Ưu đãi từ PHONE.ST
                </div>

                <div id="voucherHintText" class="voucher-hint">
                    @if (bestVoucher != null)
                    {
                        if (bestVoucher.IsEligible)
                        {
                            <text>Tuyệt vời! Bạn đã đủ điều kiện sử dụng mã <strong>@bestVoucher.Code</strong>.</text>
                        }
                        else
                        {
                            string discountDisplay = bestVoucher.DiscountType == 1 ? $"{string.Format("{0:N0}", bestVoucher.DiscountValue)} đ" : $"{bestVoucher.DiscountValue}%";
                            <text>Mua thêm <strong id="gapAmountDisplay">@string.Format("{0:N0}", bestVoucher.GapAmount) đ</strong> để áp dụng mã <strong>@bestVoucher.Code</strong> (Giảm @discountDisplay).</text>
                        }
                    }
                </div>

                <div class="progress-bar-bg">
                    @{
                        double initialPercent = 0;
                        if (bestVoucher != null && bestVoucher.MinOrderValue > 0)
                        {
                            initialPercent = bestVoucher.IsEligible ? 100 : (double)(currentSubtotal / bestVoucher.MinOrderValue) * 100;
                        }
                    }
                    <div id="voucherProgressBar" class="progress-bar-fill" style="width: @initialPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%;"></div>
                </div>
            </div>

            @{
                decimal discountAmount = (bestVoucher != null && bestVoucher.IsEligible) ? bestVoucher.EstimatedDiscountAmount : 0;
                decimal finalTotal = currentSubtotal - discountAmount;
                if (finalTotal < 0) finalTotal = 0;
            }

            <div class="summary-row">
                <span>Tạm tính</span>
                <strong class="summary-val-dark" id="summarySubtotal">@string.Format("{0:N0}", currentSubtotal) đ</strong>
            </div>

            <div class="summary-row">
                <span>Giảm giá khuyến mãi</span>
                <span class="summary-val-discount" id="summaryDiscount" style="@(discountAmount > 0 ? "color:#DC2626; font-weight:700;" : "")">
                    @(discountAmount > 0 ? "- " + string.Format("{0:N0}", discountAmount) + " đ" : "Chưa tính")
                </span>
            </div>

            <div class="summary-total">
                <span>Tổng cộng</span>
                <span id="summaryTotal">@string.Format("{0:N0}", finalTotal) đ</span>
            </div>

            <a href="/Checkout" class="btn-dark btn-checkout-flat">
                Tiến hành thanh toán
            </a>
        </div>
    }
</div>

@section Scripts {
    <script>
        function updateQty(variantId, change) {
            const input = document.getElementById(`qty-${variantId}`);
            let newQty = parseInt(input.value) + change;
            if (newQty < 1) newQty = 1;

            const formData = new FormData();
            formData.append('variantId', variantId);
            formData.append('quantity', newQty);

            fetch('/Cart/UpdateQuantity', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    input.value = newQty;
                    document.getElementById(`price-${variantId}`).innerText = data.itemTotalPrice;
                    document.getElementById('summarySubtotal').innerText = data.subtotal;

                    // Gọi hàm cập nhật Giao diện Khuyến mãi + Tổng tiền
                    updateSmartVoucherUI(data.vouchers, data.subtotal);
                } else {
                    alert(data.message);
                }
            })
            .catch(error => console.error('Lỗi kết nối API:', error));
        }

        function updateSmartVoucherUI(vouchers, rawSubtotalStr) {
            const container = document.getElementById('smartVoucherContainer');
            const hintText = document.getElementById('voucherHintText');
            const progressBar = document.getElementById('voucherProgressBar');

            const discountElement = document.getElementById('summaryDiscount');
            const totalElement = document.getElementById('summaryTotal');

            const currentSubtotal = parseInt(rawSubtotalStr.replace(/[^0-9]/g, ''));

            if (!vouchers || vouchers.length === 0) {
                container.style.display = 'none';
                discountElement.innerText = "Chưa tính";
                discountElement.style.color = "";
                discountElement.style.fontWeight = "normal";
                totalElement.innerText = new Intl.NumberFormat('vi-VN').format(currentSubtotal) + " đ";
                return;
            }

            container.style.display = 'block';
            const bestVoucher = vouchers[0];
            let discountAmount = 0;

            if (bestVoucher.isEligible) {
                progressBar.style.width = '100%';
                progressBar.style.background = '#10B981';
                hintText.innerHTML = `Tuyệt vời! Bạn đã đủ điều kiện sử dụng mã <strong>${bestVoucher.code}</strong>.`;

                // Lấy trực tiếp số tiền giảm từ thuật toán Backend trả về! Không cần tự tính JS nữa.
                discountAmount = bestVoucher.estimatedDiscountAmount;
            } else {
                let percent = (currentSubtotal / bestVoucher.minOrderValue) * 100;
                if (percent > 100) percent = 100;

                progressBar.style.width = percent + '%';
                progressBar.style.background = '#EA580C';

                const formatGap = new Intl.NumberFormat('vi-VN').format(bestVoucher.gapAmount);
                const discountDisplay = bestVoucher.discountType === 1
                    ? new Intl.NumberFormat('vi-VN').format(bestVoucher.discountValue) + " đ"
                    : bestVoucher.discountValue + "%";

                hintText.innerHTML = `Mua thêm <strong>${formatGap} đ</strong> để áp dụng mã <strong>${bestVoucher.code}</strong> (Giảm ${discountDisplay}).`;
            }

            // Cập nhật text tiền giảm giá
            if (discountAmount > 0) {
                discountElement.innerText = "- " + new Intl.NumberFormat('vi-VN').format(discountAmount) + " đ";
                discountElement.style.color = "#DC2626";
                discountElement.style.fontWeight = "700";
            } else {
                discountElement.innerText = "Chưa tính";
                discountElement.style.color = "";
                discountElement.style.fontWeight = "normal";
            }

            // Cập nhật text Tiền tổng cộng
            let finalTotal = currentSubtotal - discountAmount;
            if (finalTotal < 0) finalTotal = 0;
            totalElement.innerText = new Intl.NumberFormat('vi-VN').format(finalTotal) + " đ";
        }
    </script>
}