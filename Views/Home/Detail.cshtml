@model TMDT_LT.Models.Products
@{
    ViewData["Title"] = Model.Name;
    
    var defaultVariant = Model.ProductVariants.FirstOrDefault(v => v.Stock > 0) 
                         ?? Model.ProductVariants.FirstOrDefault();
    
    // Tính toán giá trị hiển thị ban đầu
    decimal displayPrice = 0;
    decimal displayOldPrice = 0;
    
    if (defaultVariant != null)
    {
        if (defaultVariant.DiscountPrice.HasValue)
        {
            displayPrice = defaultVariant.DiscountPrice.Value;
            displayOldPrice = defaultVariant.Price ?? 0;
        }
        else
        {
            displayPrice = defaultVariant.Price ?? 0;
        }
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/detail.css" asp-append-version="true" />
}

<div style="margin-bottom: 20px; font-size: 13px; color: var(--text-gray);">
    <a asp-action="Index" style="color: var(--neutral-black); text-decoration: none;">Trang chủ</a> /
    <span>@Model.Category?.CategoryName</span> /
    <span style="font-weight: 600;">@Model.Name</span>
</div>

<div class="detail-layout">

    <div class="gallery-section">
        <img id="main-product-img" src="@(defaultVariant?.ImageUrl ?? Model.MainImage)" alt="@Model.Name" onerror="this.src='/images/default-phone.jpg';" />
    </div>

    <div class="info-section">
        <h1>@Model.Name</h1>

        <div class="meta-info">
            Thương hiệu: <strong style="color: var(--neutral-black);">@Model.Brand?.BrandName</strong> |
            Mã SP: #@Model.ProductId
        </div>

        <div class="price-display">
            @if (defaultVariant != null)
            {
                <span id="ui-current-price" class="current-price">@string.Format("{0:N0}", displayPrice) đ</span>
                <span id="ui-old-price" class="old-price">@(displayOldPrice > 0 ? string.Format("{0:N0}", displayOldPrice) + " đ" : "")</span>
            }
            else
            {
                <span class="current-price" style="color: var(--text-gray); font-size: 20px;">Sản phẩm đang cập nhật</span>
            }
        </div>

        @if (Model.ProductVariants.Any())
        {
            <h4 style="font-size: 15px; margin-bottom: 12px;">Chọn phiên bản (Màu & Bộ nhớ)</h4>
            <div class="variant-options">
                @foreach (var variant in Model.ProductVariants)
                {
                    // Truyền thông tin của từng biến thể vào JavaScript thông qua hàm onclick
                    decimal currentVal = variant.DiscountPrice ?? variant.Price ?? 0;
                    decimal oldVal = variant.DiscountPrice.HasValue ? (variant.Price ?? 0) : 0;

                    <div class="variant-btn @(variant == defaultVariant ? "active" : "")"
                         onclick="selectVariant(this, @variant.VariantId, @currentVal, @oldVal, '@(variant.ImageUrl ?? Model.MainImage)', @variant.Stock)">
                        <div class="v-storage">@variant.Storage - @variant.Ram</div>
                        <div class="v-color">@variant.Color</div>
                    </div>
                }
            </div>

            <form asp-controller="Cart" asp-action="AddToCart" method="post" style="margin-top: 30px;">
                <input type="hidden" name="variantId" id="input-variant-id" value="@defaultVariant?.VariantId" />
                <input type="hidden" name="quantity" value="1" />

                <button type="submit" id="btn-submit-cart" class="add-to-cart-btn" @(defaultVariant?.Stock <= 0 ? "disabled" : "")>
                    @(defaultVariant?.Stock > 0 ? "Thêm vào giỏ hàng" : "Tạm hết hàng")
                </button>
            </form>
        }

        <h4 style="font-size: 16px; margin-top: 40px; border-bottom: 2px solid var(--neutral-black); padding-bottom: 8px; display: inline-block;">Thông số kỹ thuật</h4>
        <table class="specs-table">
            <tr>
                <th>Kích thước màn hình</th>
                <td>@Model.ScreenSize inch</td>
            </tr>
            <tr>
                <th>Công nghệ màn hình</th>
                <td>@Model.ScreenTech, Tần số quét @Model.RefreshRate Hz</td>
            </tr>
            <tr>
                <th>Vi xử lý (CPU)</th>
                <td>@Model.Chipset</td>
            </tr>
            <tr>
                <th>Hệ điều hành</th>
                <td>@Model.OperatingSystem</td>
            </tr>
            <tr>
                <th>Camera sau</th>
                <td>@Model.RearCamera</td>
            </tr>
            <tr>
                <th>Pin & Sạc</th>
                <td>@Model.BatteryCapacity mAh @(Model.ChargerIncluded == true ? "- Có kèm sạc" : "- Không kèm sạc")</td>
            </tr>
            <tr>
                <th>Trọng lượng</th>
                <td>@Model.Weight g</td>
            </tr>
        </table>
    </div>
</div>

@{
    var relatedProducts = ViewBag.RelatedProducts as IEnumerable<TMDT_LT.Models.Products>;
    var reviews = ViewBag.Reviews as IEnumerable<TMDT_LT.Models.ReviewDetails>;
    double avgRating = ViewBag.AverageRating;
    int totalReviews = ViewBag.TotalReviews;
}

<h3 class="section-heading">Đánh giá & Nhận xét (@totalReviews)</h3>

<div class="rating-summary-box">
    <div class="rating-score">
        <h2>@avgRating.ToString("0.0")</h2>
        <div class="stars">
            @for (int i = 1; i <= 5; i++)
            {
                if (i <= Math.Round(avgRating))
                {
                    <span>★</span>
                }
                else
                {

                    <span style="color: #ccc;">☆</span>
                }
            }
        </div>
        <div style="font-size: 13px; color: var(--text-gray);">@totalReviews đánh giá</div>
    </div>

    <div style="flex: 1;">
        <p style="color: var(--text-gray); font-size: 15px;">
            Hệ thống đánh giá sản phẩm dành riêng cho khách hàng đã trải nghiệm mua sắm thiết bị. Chúng tôi cam kết 100% đánh giá là sự thật.
        </p>
        <button class="add-to-cart-btn" style="width: auto; padding: 10px 20px; font-size: 14px; margin-top: 15px;" onclick="alert('Tính năng yêu cầu đăng nhập mua hàng thành công!')">Gửi đánh giá của bạn</button>
    </div>
</div>

<div class="review-list">
    @if (reviews != null && reviews.Any())
    {
        foreach (var review in reviews)
        {
            <div class="review-item">
                <div class="review-header">
                    <div>
                        <div class="reviewer-name">@review.Review?.Customer?.FullName</div>
                        <div class="review-variant">Đã mua: @review.Variant?.Storage - @review.Variant?.Color</div>
                    </div>
                    <div class="review-date">@review.Review?.CreatedAt?.ToString("dd/MM/yyyy")</div>
                </div>
                <div style="color: var(--neutral-black); font-size: 14px;">
                    @for (int i = 1; i <= 5; i++)
                    {
                        if (i <= review.Rating)
                        {
                            <span>★</span>
                        }
                        else
                        {

                            <span style="color: #ccc;">☆</span>
                        }
                    }
                </div>
                <div class="review-content">
                    @review.Comment
                </div>
            </div>
        }
    }
    else
    {
        <div style="text-align: center; color: var(--text-muted); padding: 20px;">Chưa có đánh giá nào cho sản phẩm này.</div>
    }
</div>

@if (relatedProducts != null && relatedProducts.Any())
{
    <h3 class="section-heading">Sản phẩm tương tự</h3>
    <div class="related-grid">
        @foreach (var p in relatedProducts)
        {
            var firstVar = p.ProductVariants.FirstOrDefault();
            <a class="phone-card" asp-controller="Home" asp-action="Detail" asp-route-id="@p.ProductId">
                <div>
                    <div class="phone-card-img" style="height: 150px;">
                        <img src="@p.MainImage" alt="@p.Name" onerror="this.src='/images/default-phone.jpg';" />
                    </div>
                    <div class="phone-card-name" style="font-size: 13px;">@p.Name</div>
                </div>
                <div class="phone-card-price">
                    @if (firstVar != null)
                    {
                        <span class="price-now" style="font-size: 14px;">@string.Format("{0:N0}", firstVar.DiscountPrice ?? firstVar.Price) đ</span>
                    }
                </div>
            </a>
        }
    </div>
}

@section Scripts {
    <script>
        function selectVariant(element, variantId, currentPrice, oldPrice, imageUrl, stockAmount) {
            // Đổi trạng thái highlight của nút
            document.querySelectorAll('.variant-btn').forEach(btn => btn.classList.remove('active'));
            element.classList.add('active');

            // Cập nhật giá trị ID cho Form mua hàng
            document.getElementById('input-variant-id').value = variantId;

            // Format tiền tệ chuẩn Việt Nam (VND)
            const formatter = new Intl.NumberFormat('vi-VN');

            document.getElementById('ui-current-price').innerText = formatter.format(currentPrice) + ' đ';

            if (oldPrice > 0) {
                document.getElementById('ui-old-price').innerText = formatter.format(oldPrice) + ' đ';
            } else {
                document.getElementById('ui-old-price').innerText = '';
            }

            // Đổi ảnh minh họa mượt mà
            if (imageUrl) {
                const imgElement = document.getElementById('main-product-img');
                imgElement.style.opacity = 0.5;
                setTimeout(() => {
                    imgElement.src = imageUrl;
                    imgElement.style.opacity = 1;
                }, 150);
            }

            // Xử lý nút Thêm vào giỏ hàng dựa trên số lượng tồn kho (Stock)
            const btnCart = document.getElementById('btn-submit-cart');
            if (stockAmount > 0) {
                btnCart.disabled = false;
                btnCart.innerText = "Thêm vào giỏ hàng";
            } else {
                btnCart.disabled = true;
                btnCart.innerText = "Tạm hết hàng";
            }
        }
    </script>
}