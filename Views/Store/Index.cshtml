@model TMDT_LT.Models.ViewModels.Storefront.CatalogVM
@{
    Layout = "_Layout";
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.Keyword) ? "Danh mục thiết bị" : $"Kết quả tìm kiếm: {Model.Keyword}";
}

@section Styles {
    <link rel="stylesheet" href="~/css/storefront/store-home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/storefront/store-catalog.css" asp-append-version="true" />
    <style>
        /* CSS CHO BỘ NÚT CHỌN BIẾN THỂ TRONG MODAL */
        .chip-btn {
            padding: 8px 16px;
            border: 1px solid var(--border-color);
            background: white;
            color: var(--navy-deep);
            border-radius: 4px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
        }

            .chip-btn:hover {
                border-color: var(--navy-deep);
            }

            .chip-btn.active {
                border-color: var(--accent-red);
                color: var(--accent-red);
                background: #FEF2F2;
            }

            .chip-btn.disabled-chip {
                opacity: 0.3;
                cursor: not-allowed;
                border-color: #E5E7EB;
                background: #F9FAFB;
                color: #9CA3AF;
            }

                .chip-btn.disabled-chip:hover {
                    border-color: #E5E7EB;
                    color: #9CA3AF;
                }

        /* CSS CHO MODAL QUICK ADD (SHOPEE STYLE) */
        .qa-modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.6);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 1000;
            opacity: 0;
            transition: opacity 0.3s;
        }

            .qa-modal-overlay.show {
                display: flex;
                opacity: 1;
            }

        .qa-modal-content {
            background: white;
            border-radius: 8px;
            width: 90%;
            max-width: 480px;
            padding: 20px;
            position: relative;
            transform: translateY(20px);
            transition: transform 0.3s;
        }

        .qa-modal-overlay.show .qa-modal-content {
            transform: translateY(0);
        }

        .qa-close-btn {
            position: absolute;
            top: 15px;
            right: 15px;
            background: none;
            border: none;
            font-size: 20px;
            color: #9CA3AF;
            cursor: pointer;
        }

            .qa-close-btn:hover {
                color: var(--accent-red);
            }

        /* CSS CHO NÚT YÊU THÍCH */
        .btn-favorite {
            position: absolute;
            top: 10px;
            right: 10px;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.9);
            border: 1px solid var(--border-color);
            color: #9CA3AF;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            z-index: 10;
            transition: all 0.3s ease;
        }

            .btn-favorite:hover {
                color: var(--accent-red);
                border-color: var(--accent-red);
                transform: scale(1.1);
            }

            .btn-favorite.active {
                color: var(--accent-red);
                border-color: var(--accent-red);
                background: #FEF2F2;
            }

        /* CSS MỚI BỔ SUNG: VÙNG HIỂN THỊ CÁC SUGGESTION SEARCH TAGS */
        .search-suggestion-wrapper {
            background: #FFFFFF;
            padding: 16px 20px;
            border-radius: 8px;
            border: 1px solid #E2E8F0;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .suggestion-title {
            font-size: 13px;
            font-weight: 700;
            color: #64748B;
            text-transform: uppercase;
        }

        .suggestion-tag-item {
            background: #F1F5F9;
            color: #334155;
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
            border: 1px solid transparent;
        }

            .suggestion-tag-item:hover {
                background: #FEF2F2;
                color: var(--accent-red);
                border-color: var(--accent-red);
            }

        /* CSS KHU VỰC TAG THÔNG SỐ CẤU HÌNH BIẾN THỂ TRÊN CARD SẢN PHẨM */
        .product-variant-badges {
            display: flex;
            flex-wrap: wrap;
            gap: 4px;
            margin: 6px 12px;
            min-height: 22px;
        }

        .variant-spec-badge {
            background: #F1F5F9;
            color: #475569;
            font-size: 11px;
            font-weight: 700;
            padding: 2px 6px;
            border-radius: 4px;
            border: 1px solid #E2E8F0;
        }
    </style>
}

<form id="catalogMainForm" method="get" action="/Store">
    <input type="hidden" name="keyword" id="catalogKeywordInput" value="@Model.Keyword" />
    <input type="hidden" name="page" id="pageInput" value="@Model.CurrentPage" />

    <div class="catalog-layout-grid">
        <aside class="catalog-sidebar">
            <div class="filter-group-box">
                <div class="filter-title-flat">Danh mục sản phẩm</div>
                <div class="filter-list-inputs">
                    @foreach (var cat in Model.AvailableCategories)
                    {
                        bool isChecked = Model.SelectedCategoryIds.Contains(cat.CategoryId);
                        <label class="checkbox-label-flat">
                            <input type="checkbox" name="categoryIds" value="@cat.CategoryId" @(isChecked ? "checked" : "") onchange="triggerSubmitForm()" />
                            <span>@cat.CategoryName</span>
                        </label>
                    }
                </div>
            </div>

            <div class="filter-group-box">
                <div class="filter-title-flat">Hãng sản xuất</div>
                <div class="filter-list-inputs">
                    @foreach (var brand in Model.AvailableBrands)
                    {
                        bool isChecked = Model.SelectedBrandIds.Contains(brand.BrandId);
                        <label class="checkbox-label-flat">
                            <input type="checkbox" name="brandIds" value="@brand.BrandId" @(isChecked ? "checked" : "") onchange="triggerSubmitForm()" />
                            <span>@brand.BrandName</span>
                        </label>
                    }
                </div>
            </div>

            <div class="filter-group-box">
                <div class="filter-title-flat">Khoảng giá (đ)</div>

                <select id="priceRangeSelector" onchange="toggleCustomPrice()" style="margin-bottom: 12px; width: 100%; border: 1px solid var(--border-color); border-radius: 4px; padding: 10px; font-size: 13px; font-weight: 600; color: var(--navy-deep); outline: none;">
                    <option value="">Tất cả mức giá</option>
                    <option value="0-5000000">Dưới 5 triệu</option>
                    <option value="5000000-10000000">Từ 5 triệu - 10 triệu</option>
                    <option value="10000000-20000000">Từ 10 triệu - 20 triệu</option>
                    <option value="20000000-">Trên 20 triệu</option>
                    <option value="custom">Nhập giá khác...</option>
                </select>

                <div id="customPriceInputs" class="price-range-inputs" style="display: none; align-items: center; gap: 8px; margin-bottom: 12px;">
                    <input type="number" id="inputMinPrice" name="minPrice" value="@(Model.MinPrice)" placeholder="Từ giá" min="0" step="50000" style="width: 100%; height: 36px; border: 1px solid var(--border-color); border-radius: 4px; padding: 0 10px; font-size: 12px; outline: none;" />
                    <span style="color: var(--border-color)">-</span>
                    <input type="number" id="inputMaxPrice" name="maxPrice" value="@(Model.MaxPrice)" placeholder="Đến giá" min="0" step="50000" style="width: 100%; height: 36px; border: 1px solid var(--border-color); border-radius: 4px; padding: 0 10px; font-size: 12px; outline: none;" />
                </div>

                <button type="button" class="btn-dark" style="width: 100%; height: 36px; font-size: 12px; font-weight: 700; border-radius: 4px;" onclick="applyPriceFilter()">
                    ÁP DỤNG LỌC
                </button>
            </div>

            <a href="/Store" class="btn-home-cart" style="text-decoration: none; text-align: center; margin-top: 10px; font-size: 11px;">
                <i class="fas fa-undo"></i> XOÁ TẤT CẢ BỘ LỌC
            </a>
        </aside>

        <main class="catalog-content-area">


            <div class="catalog-toolbar-top">
                <div class="result-counter-txt">
                    @if (!string.IsNullOrWhiteSpace(Model.Keyword))
                    {
                        <span>Tìm thấy <strong>@Model.TotalResults</strong> kết quả cho <span style="color: var(--accent-red)">"@Model.Keyword"</span></span>
                    }
                    else
                    {
                        <span>Hiển thị <strong>@Model.TotalResults</strong> sản phẩm phân phối chính hãng</span>
                    }
                </div>

                <div>
                    <select name="sort" class="select-sort-flat" onchange="triggerSubmitForm()">
                        <option value="newest" selected="@(Model.SortBy == "newest")">Mới ra mắt</option>
                        <option value="bestseller-desc" selected="@(Model.SortBy == "bestseller-desc")">Bán chạy nhất</option>
                        <option value="price_asc" selected="@(Model.SortBy == "price_asc")">Giá tăng dần</option>
                        <option value="price_desc" selected="@(Model.SortBy == "price_desc")">Giá giảm dần</option>
                    </select>
                </div>
            </div>

            @if (Model.Products != null && Model.Products.Any())
            {
                <div class="catalog-products-grid">
                    @foreach (var searchItem in Model.Products)
                    {
                        var item = searchItem.Product;
                        var activeVariants = item.ProductVariants?.Where(v => v.IsActive == true).ToList() ?? new List<TMDT_LT.Models.ProductVariants>();
                        int variantCount = activeVariants.Count;
                        var defaultVariant = activeVariants.OrderBy(v => v.Price).FirstOrDefault();

                        <div class="market-product-card">
                            <button type="button" class="btn-favorite" onclick="toggleFavorite(event, this, @(defaultVariant?.VariantId ?? 0))" title="Thêm vào yêu thích">
                                <i class="far fa-heart"></i>
                            </button>

                            <a href="/Store/Product/@item.ProductId" style="text-decoration: none; color: inherit; display: flex; flex-direction: column; flex: 1;">
                                <img src="@item.MainImage" alt="@item.Name" class="product-card-img" onerror="this.src='https://via.placeholder.com/200?text=No+Image'" />
                                <div class="product-card-name">@item.Name</div>

                                <div class="product-variant-badges">
                                    @{
                                        // Gộp tất cả RAM, Storage hợp lệ không phải N/A hoặc rỗng
                                        var specBadges = activeVariants
                                        .SelectMany(v => new[] { v.Ram, v.Storage })
                                        .Where(s => !string.IsNullOrWhiteSpace(s) && !s.Equals("N/A", StringComparison.OrdinalIgnoreCase))
                                        .Distinct(StringComparer.OrdinalIgnoreCase)
                                        .ToList();

                                        foreach (var spec in specBadges)
                                        {
                                            <span class="variant-spec-badge">@spec</span>
                                        }
                                    }
                                </div>

                                <div class="price-group-market">
                                    @if (defaultVariant != null)
                                    {
                                        var currentPrice = defaultVariant.DiscountPrice > 0 ? defaultVariant.DiscountPrice : defaultVariant.Price;
                                        <span class="price-market-current">@string.Format("{0:N0}", currentPrice) đ</span>
                                        if (defaultVariant.DiscountPrice > 0 && defaultVariant.DiscountPrice < defaultVariant.Price)
                                        {
                                            <span class="price-market-old">@string.Format("{0:N0}", defaultVariant.Price) đ</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="price-market-current">Liên hệ</span>
                                    }
                                </div>
                            </a>

                            @if (variantCount > 1)
                            {
                                var variantJson = System.Text.Json.JsonSerializer.Serialize(activeVariants.Select(v => new
                                {
                                    variantId = v.VariantId,
                                    color = v.Color ?? "",
                                    ram = v.Ram ?? "",
                                    storage = v.Storage ?? "",
                                    price = v.Price,
                                    discountPrice = v.DiscountPrice,
                                    stock = v.Stock,
                                    imageUrl = !string.IsNullOrEmpty(v.ImageUrl) ? v.ImageUrl : item.MainImage
                                }));
                                <button type="button" class="btn-home-cart" onclick="openQuickAddModal(this)" data-name="@item.Name" data-img="@item.MainImage" data-variants="@variantJson">
                                    <i class="fas fa-shopping-cart"></i> THÊM VÀO GIỎ
                                </button>
                            }
                            else if (variantCount == 1 && defaultVariant != null && defaultVariant.Stock > 0)
                            {
                                <form action="/Cart/AddToCart" method="post" style="margin: 0; width: 100%;" class="ajax-cart-form">
                                    <input type="hidden" name="variantId" value="@defaultVariant.VariantId" />
                                    <input type="hidden" name="quantity" value="1" />
                                    <button type="submit" class="btn-home-cart">
                                        <i class="fas fa-shopping-cart"></i> THÊM VÀO GIỎ
                                    </button>
                                </form>
                            }
                            else
                            {
                                <button type="button" class="btn-home-cart" disabled style="background: #E5E7EB; color: #9CA3AF; cursor: not-allowed;">
                                    <i class="fas fa-box-open"></i> HẾT HÀNG
                                </button>
                            }

                            @if (!string.IsNullOrWhiteSpace(Model.Keyword))
                            {
                                <div class="score-badge-dev">Độ liên quan: @searchItem.RelevanceScore pts</div>
                            }
                        </div>
                    }
                </div>

                @if (Model.TotalPages > 1)
                {
                    int maxPagesToShow = 3;
                    int startPage = Math.Max(1, Model.CurrentPage - maxPagesToShow / 2);
                    int endPage = Math.Min(Model.TotalPages, startPage + maxPagesToShow - 1);
                    if (endPage - startPage + 1 < maxPagesToShow)
                    {
                        startPage = Math.Max(1, endPage - maxPagesToShow + 1);
                    }

                    <div class="catalog-pagination">
                        <button type="button" class="page-btn" onclick="goToPage(@(Model.CurrentPage - 1))" @(Model.CurrentPage == 1 ? "disabled" : "")><i class="fas fa-chevron-left"></i></button>
                        @if (startPage > 1)
                        {
                            <button type="button" class="page-btn" onclick="goToPage(1)">1</button>
                            if (startPage > 2)
                            {
                                <span class="page-dots">...</span>
                            }
                        }
                        @for (int i = startPage; i <= endPage; i++)
                        {
                            <button type="button" class="page-btn @(i == Model.CurrentPage ? "active" : "")" onclick="goToPage(@i)">@i</button>
                        }
                        @if (endPage < Model.TotalPages)
                        {
                            if (endPage < Model.TotalPages - 1)
                            {
                                <span class="page-dots">...</span>
                            }
                            <button type="button" class="page-btn" onclick="goToPage(@Model.TotalPages)">@Model.TotalPages</button>
                        }
                        <button type="button" class="page-btn" onclick="goToPage(@(Model.CurrentPage + 1))" @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")><i class="fas fa-chevron-right"></i></button>
                    </div>
                }
            }
            else
            {
                <div style="text-align: center; padding: 60px 0; background: var(--navy-light); border-radius: 6px; border: 1px dashed var(--border-color);">
                    <i class="fas fa-search" style="font-size: 40px; color: #CBD5E1; margin-bottom: 16px;"></i>
                    <h3 style="color: var(--navy-deep); font-size: 16px; margin-bottom: 6px;">Không tìm thấy thiết bị phù hợp!</h3>
                    <p style="color: var(--navy-medium); font-size: 13px; margin: 0;">Vui lòng thử điều chỉnh lại khoảng giá hoặc tích chọn hãng sản xuất khác.</p>
                </div>
            }
        </main>
    </div>
</form>

<div id="qa-modal" class="qa-modal-overlay" onclick="closeQuickAddModal()">
    <div class="qa-modal-content" onclick="event.stopPropagation()">
        <button class="qa-close-btn" onclick="closeQuickAddModal()">✖</button>

        <div style="display: flex; gap: 15px; margin-bottom: 20px; align-items: flex-end;">
            <img id="qa-image" src="" style="width: 100px; height: 100px; object-fit: contain; border: 1px solid var(--border-color); border-radius: 4px; padding: 4px;" />
            <div>
                <div id="qa-price" style="color: var(--accent-red); font-weight: 700; font-size: 18px; margin-bottom: 4px;"></div>
                <div id="qa-stock" style="font-size: 13px; color: #6B7280;">Vui lòng chọn phân loại</div>
            </div>
        </div>

        <div id="qa-options-container" style="max-height: 300px; overflow-y: auto; margin-bottom: 20px; border-top: 1px solid var(--border-color); padding-top: 15px;">
        </div>

        <form id="qa-form" action="/Cart/AddToCart" method="post" style="display: flex; gap: 10px; border-top: 1px solid var(--border-color); padding-top: 15px;">
            <input type="hidden" name="variantId" id="qa-variantId" value="" />
            <div style="display: flex; align-items: center; border: 1px solid var(--border-color); border-radius: 4px; overflow: hidden; width: 100px;">
                <button type="button" class="chip-btn" style="border: none; width: 30px; padding: 0;" onclick="qaChangeQty(-1)">-</button>
                <input type="number" id="qa-qty" name="quantity" value="1" min="1" style="width: 40px; border: none; text-align: center; font-weight: 700; outline: none;" readonly />
                <button type="button" class="chip-btn" style="border: none; width: 30px; padding: 0;" onclick="qaChangeQty(1)">+</button>
            </div>
            <button type="submit" id="qa-btn-submit" class="btn-dark" disabled style="flex: 1; height: 40px; font-weight: 700; border-radius: 4px;">XÁC NHẬN THÊM</button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function triggerSubmitForm() { document.getElementById('pageInput').value = 1; document.getElementById('catalogMainForm').submit(); }
        function goToPage(pageNum) { document.getElementById('pageInput').value = pageNum; document.getElementById('catalogMainForm').submit(); }

        function submitSearchWithTag(tagText) {
            document.getElementById('catalogKeywordInput').value = tagText;
            document.getElementById('pageInput').value = 1;
            document.getElementById('catalogMainForm').submit();
        }

        let qaVariantMatrix = [];
        let qaCurrentSelection = { storage: null, ram: null, color: null };
        let qaMinPrice = 0;

        function openQuickAddModal(btnElement) {
            qaVariantMatrix = JSON.parse(btnElement.getAttribute('data-variants'));
            qaCurrentSelection = { storage: null, ram: null, color: null };
            qaMinPrice = Math.min(...qaVariantMatrix.map(v => v.discountPrice > 0 ? v.discountPrice : v.price));

            document.getElementById('qa-image').src = btnElement.getAttribute('data-img');
            document.getElementById('qa-qty').value = 1;

            const storages = [...new Set(qaVariantMatrix.map(v => v.storage).filter(v => v !== ""))];
            const rams = [...new Set(qaVariantMatrix.map(v => v.ram).filter(v => v !== ""))];
            const colors = [...new Set(qaVariantMatrix.map(v => v.color).filter(v => v !== ""))];

            let html = '';
            if(storages.length > 0) {
                html += '<div style="font-size: 13px; font-weight: 700; margin-bottom: 8px;">Dung lượng</div><div style="display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 15px;">';
                storages.forEach(s => html += `<button type="button" class="chip-btn attr-qa-storage" data-val="${s}" onclick="qaToggleSelection('storage', '${s}', this)">${s}</button>`);
                html += '</div>';
            }
            if(rams.length > 0) {
                html += '<div style="font-size: 13px; font-weight: 700; margin-bottom: 8px;">RAM</div><div style="display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 15px;">';
                rams.forEach(r => html += `<button type="button" class="chip-btn attr-qa-ram" data-val="${r}" onclick="qaToggleSelection('ram', '${r}', this)">${r}</button>`);
                html += '</div>';
            }
            if(colors.length > 0) {
                html += '<div style="font-size: 13px; font-weight: 700; margin-bottom: 8px;">Màu sắc</div><div style="display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 15px;">';
                colors.forEach(c => html += `<button type="button" class="chip-btn attr-qa-color" data-val="${c}" onclick="qaToggleSelection('color', '${c}', this)">${c}</button>`);
                html += '</div>';
            }

            document.getElementById('qa-options-container').innerHTML = html;

            const modal = document.getElementById('qa-modal');
            modal.style.display = 'flex';
            setTimeout(() => modal.classList.add('show'), 10);

            qaEvaluateMatrix();
        }

        function closeQuickAddModal() {
            const modal = document.getElementById('qa-modal');
            modal.classList.remove('show');
            setTimeout(() => modal.style.display = 'none', 300);
        }

        function qaToggleSelection(type, value, element) {
            if (element.classList.contains('disabled-chip')) return;
            if (qaCurrentSelection[type] === value) {
                qaCurrentSelection[type] = null;
                element.classList.remove('active');
            } else {
                qaCurrentSelection[type] = value;
                document.querySelectorAll(`.attr-qa-${type}`).forEach(el => el.classList.remove('active'));
                element.classList.add('active');
            }
            qaEvaluateMatrix();
        }

        function qaEvaluateMatrix() {
            document.querySelectorAll('.attr-qa-storage').forEach(el => qaCheckAvailability('storage', el.getAttribute('data-val'), el));
            document.querySelectorAll('.attr-qa-ram').forEach(el => qaCheckAvailability('ram', el.getAttribute('data-val'), el));
            document.querySelectorAll('.attr-qa-color').forEach(el => qaCheckAvailability('color', el.getAttribute('data-val'), el));
            const exactMatch = qaVariantMatrix.find(v =>
                (!qaCurrentSelection.storage || v.storage === qaCurrentSelection.storage) &&
                (!qaCurrentSelection.ram || v.ram === qaCurrentSelection.ram) &&
                (!qaCurrentSelection.color || v.color === qaCurrentSelection.color) &&
                (qaCurrentSelection.storage !== null || v.storage === "") &&
                (qaCurrentSelection.ram !== null || v.ram === "") &&
                (qaCurrentSelection.color !== null || v.color === "")
            );
            const formatVND = (num) => new Intl.NumberFormat('vi-VN').format(num) + " đ";
            const btnSubmit = document.getElementById('qa-btn-submit');
            if (exactMatch) {
                document.getElementById('qa-variantId').value = exactMatch.variantId;
                const price = (exactMatch.discountPrice > 0) ? exactMatch.discountPrice : exactMatch.price;
                document.getElementById('qa-price').innerText = formatVND(price);
                if (exactMatch.stock > 0) {
                    document.getElementById('qa-stock').innerText = `Kho: ${exactMatch.stock}`;
                    btnSubmit.disabled = false;
                } else {
                    document.getElementById('qa-stock').innerText = "Hết hàng";
                    document.getElementById('qa-stock').style.color = "var(--accent-red)";
                    btnSubmit.disabled = true;
                }

                if (exactMatch.imageUrl) {
                    document.getElementById('qa-image').src = exactMatch.imageUrl;
                }
            } else {
                document.getElementById('qa-price').innerText = qaMinPrice > 0 ? formatVND(qaMinPrice) : "Liên hệ";
                document.getElementById('qa-stock').innerText = "Vui lòng chọn phân loại";
                document.getElementById('qa-stock').style.color = "#6B7280";
                btnSubmit.disabled = true;
                document.getElementById('qa-variantId').value = "";
            }
        }

        function qaCheckAvailability(typeToCheck, valueToCheck, element) {
            let testSelection = { ...qaCurrentSelection };
            testSelection[typeToCheck] = valueToCheck;

            const isAvailable = qaVariantMatrix.some(v =>
                (!testSelection.storage || v.storage === testSelection.storage) &&
                (!testSelection.ram || v.ram === testSelection.ram) &&
                (!testSelection.color || v.color === testSelection.color)
            );
            if (isAvailable) {
                element.classList.remove('disabled-chip');
            } else {
                element.classList.add('disabled-chip');
                element.classList.remove('active');
                if (qaCurrentSelection[typeToCheck] === valueToCheck) qaCurrentSelection[typeToCheck] = null;
            }
        }

        function qaChangeQty(change) {
            const input = document.getElementById('qa-qty');
            let newQty = parseInt(input.value) + change;
            if (newQty >= 1) input.value = newQty;
        }

        document.getElementById('qa-form').addEventListener('submit', function(e) {
            e.preventDefault();
            const formData = new FormData(this);
            formData.append('actionType', 'add');

            const btn = document.getElementById('qa-btn-submit');
            const originalText = btn.innerHTML;
            btn.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i>...';

            fetch(this.action, {
                method: this.method, body: formData,
                headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    btn.innerHTML = 'ĐÃ THÊM';
                    btn.style.background = '#10B981';
                    updateCartBadge(data.cartCount);
                    showShopeeToast("Đã thêm vào giỏ hàng");

                    setTimeout(() => {
                        closeQuickAddModal();
                        btn.innerHTML = originalText;
                        btn.style.background = '';
                    }, 800);
                }
            }).catch(err => console.error('Lỗi kết nối API:', err));
        });

        document.querySelectorAll('.ajax-cart-form:not(#qa-form)').forEach(form => {
            form.addEventListener('submit', function(e) {
                e.preventDefault();
                const formData = new FormData(this);
                formData.append('actionType', 'add');

                const btn = this.querySelector('button[type="submit"]');
                const originalText = btn.innerHTML;
                btn.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i>...';

                fetch(this.action, {
                    method: this.method, body: formData,
                    headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }
                })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        btn.innerHTML = 'ĐÃ THÊM';
                        btn.style.background = '#10B981';
                        btn.style.color = 'white';
                        updateCartBadge(data.cartCount);
                        showShopeeToast("Sản phẩm đã được thêm vào Giỏ hàng");
                        setTimeout(() => {
                            btn.innerHTML = originalText;
                            btn.style.background = '';
                            btn.style.color = '';
                        }, 2000);
                    }
                }).catch(err => console.error('Lỗi kết nối API:', err));
            });
        });

        function updateCartBadge(count) {
            const badge = document.querySelector('.cart-badge');
            if (badge) {
                badge.innerText = count;
                badge.classList.add('has-items'); badge.style.animation = 'none';
                badge.offsetHeight; badge.style.animation = 'popBadge 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards';
            }
        }

        function showShopeeToast(message) {
            let toast = document.getElementById('shopee-toast');
            if (!toast) {
                toast = document.createElement('div');
                toast.id = 'shopee-toast';
                toast.innerHTML = `<i class="fas fa-check-circle" style="font-size:36px; color:#10B981; margin-bottom:12px; display:block;"></i><span style="font-size:14px; font-weight:700;">${message}</span>`;
                toast.style.cssText = "position:fixed; top:50%; left:50%; transform:translate(-50%,-50%); background:rgba(0,0,0,0.85); color:#fff; padding:30px 40px; border-radius:8px; text-align:center; z-index:9999; opacity:0; visibility:hidden; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); box-shadow: 0 10px 25px rgba(0,0,0,0.2);";
                document.body.appendChild(toast);
            }
            toast.style.visibility = 'visible'; toast.style.opacity = '1';
            toast.style.transform = 'translate(-50%, -50%) scale(1.05)';
            setTimeout(() => { toast.style.transform = 'translate(-50%, -50%) scale(1)'; }, 50);
            setTimeout(() => { toast.style.opacity = '0'; setTimeout(() => toast.style.visibility = 'hidden', 300); }, 1800);
        }

        window.toggleFavorite = async function(event, btnElement, variantId) {
            event.preventDefault();
            event.stopPropagation();

            if (variantId === 0) {
                if(typeof window.showToast === 'function') window.showToast("Sản phẩm này hiện chưa có biến thể cụ thể.", "error");
                else alert("Sản phẩm này hiện chưa có biến thể cụ thể.");
                return;
            }

            const icon = btnElement.querySelector('i');
            const isCurrentlyActive = btnElement.classList.contains('active');
            btnElement.classList.toggle('active');
            icon.className = isCurrentlyActive ? 'far fa-heart' : 'fas fa-heart';
            try {
                const formData = new FormData();
                formData.append('variantId', variantId);

                const response = await fetch('/Favorite/Toggle', {
                    method: 'POST',
                    body: formData
                });
                const data = await response.json();

                if (data.success) {
                    if(typeof window.showToast === 'function') window.showToast(data.message, 'success');
                    if (data.isAdded) {
                        btnElement.classList.add('active');
                        icon.className = 'fas fa-heart';
                    } else {
                        btnElement.classList.remove('active');
                        icon.className = 'far fa-heart';
                    }
                } else {
                    btnElement.classList.toggle('active');
                    icon.className = isCurrentlyActive ? 'fas fa-heart' : 'far fa-heart';

                    if (data.requireLogin) {
                        if (confirm(data.message + " Chuyển đến trang đăng nhập?")) {
                            window.location.href = '/Auth/Login?returnUrl=' + encodeURIComponent(window.location.pathname + window.location.search);
                        }
                    } else {
                        if(typeof window.showToast === 'function') window.showToast(data.message, 'error');
                    }
                }
            } catch (e) {
                btnElement.classList.toggle('active');
                icon.className = isCurrentlyActive ? 'fas fa-heart' : 'far fa-heart';
                if(typeof window.showToast === 'function') window.showToast('Lỗi kết nối đến máy chủ.', 'error');
            }
        };

        function toggleCustomPrice() {
            const selector = document.getElementById('priceRangeSelector').value;
            const customContainer = document.getElementById('customPriceInputs');

            if (selector === 'custom') {
                customContainer.style.display = 'flex';
            } else {
                customContainer.style.display = 'none';
            }
        }

        function applyPriceFilter() {
            const selector = document.getElementById('priceRangeSelector').value;
            const inputMin = document.getElementById('inputMinPrice');
            const inputMax = document.getElementById('inputMaxPrice');

            if (selector && selector !== 'custom') {
                const parts = selector.split('-');
                inputMin.value = parts[0] ? parts[0] : '';
                inputMax.value = parts[1] ? parts[1] : '';
            } else if (!selector) {
                inputMin.value = '';
                inputMax.value = '';
            }

            triggerSubmitForm();
        }

        document.addEventListener("DOMContentLoaded", function() {
            const minVal = document.getElementById('inputMinPrice').value;
            const maxVal = document.getElementById('inputMaxPrice').value;
            const selector = document.getElementById('priceRangeSelector');

            if (minVal || maxVal) {
                const rangeVal = `${minVal}-${maxVal}`;
                let optionExists = Array.from(selector.options).some(opt => opt.value === rangeVal);

                if (optionExists) {
                    selector.value = rangeVal;
                    document.getElementById('customPriceInputs').style.display = 'none';
                } else {
                    selector.value = 'custom';
                    document.getElementById('customPriceInputs').style.display = 'flex';
                }
            }
        });
    </script>
}