@model TMDT_LT.Models.ViewModels.Storefront.ProductDetailVM
@{
    Layout = "_Layout";
    ViewData["Title"] = Model.Product.Name;

    // Trích xuất các tập hợp phân loại độc lập để vẽ giao diện chọn
    var uniqueStorages = Model.Product.ProductVariants.Where(v => v.IsActive == true && !string.IsNullOrEmpty(v.Storage)).Select(v => v.Storage).Distinct().ToList();
    var uniqueRams = Model.Product.ProductVariants.Where(v => v.IsActive == true && !string.IsNullOrEmpty(v.Ram)).Select(v => v.Ram).Distinct().ToList();
    var uniqueColors = Model.Product.ProductVariants.Where(v => v.IsActive == true && !string.IsNullOrEmpty(v.Color)).Select(v => v.Color).Distinct().ToList();

    var minPrice = Model.Product.ProductVariants.Where(v => v.IsActive == true).Min(v => v.DiscountPrice > 0 ? v.DiscountPrice : v.Price);
    string displayPrice = minPrice != null ? ((decimal)minPrice).ToString("N0", new System.Globalization.CultureInfo("vi-VN")) + " đ" : "Liên hệ";
}

@section Styles {
    <link rel="stylesheet" href="~/css/storefront/store-pdp.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/storefront/store-home.css" asp-append-version="true" />
    <style>
        /* CSS cho nút thuộc tính bị vô hiệu hóa chéo */
        .chip-btn.disabled-chip {
            opacity: 0.3;
            cursor: not-allowed;
            border-color: #E5E7EB;
            background: #F9FAFB;
            color: #9CA3AF;
        }
        .chip-btn.disabled-chip:hover {
            border-color: #E5E7EB;
            color: #9CA3AF;
        }
    </style>
}

<div class="pdp-grid-wrapper">
    <div class="pdp-gallery-block">
        <div class="pdp-main-viewport">
            <img id="mainPdpImage" src="@Model.Product.MainImage" alt="@Model.Product.Name" />
        </div>
        <div class="pdp-thumbnail-strip">
            <div class="pdp-thumb-item active" onclick="changeGalleryImage('@Model.Product.MainImage', this)">
                <img src="@Model.Product.MainImage" alt="Main" />
            </div>
            @if (Model.Product.ProductImages != null)
            {
                foreach (var img in Model.Product.ProductImages)
                {
                    <div class="pdp-thumb-item" onclick="changeGalleryImage('@img.ImageUrl', this)">
                        <img src="@img.ImageUrl" alt="Gallery item" />
                    </div>
                }
            }
        </div>
    </div>

    <div class="pdp-info-block">
        <div class="pdp-brand-tag">Hãng sản xuất: @Model.Product.Brand?.BrandName</div>
        <h1 class="pdp-meta-title">@Model.Product.Name</h1>
        
        <div class="pdp-price-box">
            <span class="pdp-price-current" id="lblCurrentPrice">@displayPrice</span>
            <span class="pdp-price-old" id="lblOldPrice" style="display:none;">0 đ</span>
        </div>

        @if (uniqueStorages.Any())
        {
            <div class="variant-selector-group">
                <div class="variant-label">Chọn Dung Lượng</div>
                <div class="variant-chips-flex">
                    @foreach (var storage in uniqueStorages)
                    {
                        <button type="button" class="chip-btn attr-storage" data-val="@storage" onclick="toggleSelection('storage', '@storage', this)">@storage</button>
                    }
                </div>
            </div>
        }

        @if (uniqueRams.Any())
        {
            <div class="variant-selector-group" style="margin-top: 15px;">
                <div class="variant-label">Chọn RAM</div>
                <div class="variant-chips-flex">
                    @foreach (var ram in uniqueRams)
                    {
                        <button type="button" class="chip-btn attr-ram" data-val="@ram" onclick="toggleSelection('ram', '@ram', this)">@ram</button>
                    }
                </div>
            </div>
        }

        @if (uniqueColors.Any())
        {
            <div class="variant-selector-group" style="margin-top: 15px;">
                <div class="variant-label">Chọn Màu Sắc</div>
                <div class="variant-chips-flex">
                    @foreach (var color in uniqueColors)
                    {
                        <button type="button" class="chip-btn attr-color" data-val="@color" onclick="toggleSelection('color', '@color', this)">@color</button>
                    }
                </div>
            </div>
        }

        <div style="margin-top: 30px; border-top: 1px solid var(--border-color); padding-top: 24px;">
            <div id="lblStockStatus" style="font-size: 13px; font-weight: 700; margin-bottom: 16px; color: #94A3B8;">
                Vui lòng chọn cấu hình sản phẩm
            </div>
            
            <form action="/Cart/AddToCart" method="post" id="formAddToCart" style="display: flex; gap: 12px; align-items: stretch;">
                <input type="hidden" name="variantId" id="hiddenVariantId" value="" />
                <input type="number" name="quantity" value="1" min="1" class="form-control" style="width: 70px; height: 50px; text-align: center; font-weight: 700; border-radius: 4px; border: 1px solid var(--border-color);" />
                
                <button type="submit" name="actionType" value="add" id="btnSubmitCart" disabled style="flex: 1; height: 50px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; border: 2px solid var(--navy-deep); color: var(--navy-deep); background: white; border-radius: 4px; cursor: pointer; transition: all 0.2s;">
                    Thêm vào giỏ
                </button>
                <button type="submit" name="actionType" value="buy" id="btnBuyNow" disabled style="flex: 1; height: 50px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; background: var(--accent-red, #DC2626); color: white; border: none; border-radius: 4px; cursor: pointer; transition: all 0.2s;">
                    Mua ngay
                </button>
            </form>
        </div>

        <div class="pdp-specs-container">
            <div class="variant-label" style="margin-bottom: 16px;">Thông số kỹ thuật cốt lõi</div>
            <table class="specs-table-flat">
                @if (!string.IsNullOrEmpty(Model.Product.Chipset)) { <tr><td>Chip xử lý (CPU)</td><td>@Model.Product.Chipset</td></tr> }
                @if (!string.IsNullOrEmpty(Model.Product.OperatingSystem)) { <tr><td>Hệ điều hành</td><td>@Model.Product.OperatingSystem</td></tr> }
                @if (Model.Product.ScreenSize != null) { <tr><td>Kích thước màn hình</td><td>@Model.Product.ScreenSize inch</td></tr> }
                @if (!string.IsNullOrEmpty(Model.Product.ScreenTech)) { <tr><td>Công nghệ nền nền</td><td>@Model.Product.ScreenTech</td></tr> }
                @if (Model.Product.RefreshRate != null) { <tr><td>Tần số quét hình</td><td>@Model.Product.RefreshRate Hz</td></tr> }
                @if (Model.Product.BatteryCapacity != null) { <tr><td>Dung lượng Pin</td><td>@Model.Product.BatteryCapacity mAh</td></tr> }
                @if (!string.IsNullOrEmpty(Model.Product.RearCamera)) { <tr><td>Camera sau</td><td>@Model.Product.RearCamera</td></tr> }
            </table>
        </div>
    </div>
</div>

<div class="pdp-reviews-container">
    <div class="section-wrapper" style="margin-top: 0;">
        <div class="section-header-title">Đánh giá từ khách hàng</div>
        
        <div class="review-summary-box">
            <div class="rating-overview">
                <h3>@Model.AverageRating</h3>
                <div class="rating-stars-big">
                    @for (int i = 1; i <= 5; i++)
                    {
                        if (i <= Math.Round(Model.AverageRating)) { <i class="fas fa-star"></i> }
                        else { <i class="far fa-star"></i> }
                    }
                </div>
                <div style="font-size: 12px; color: var(--navy-medium);">@Model.TotalReviews đánh giá</div>
            </div>
            
            <div class="rating-bars">
                @for (int i = 5; i >= 1; i--)
                {
                    int count = Model.StarCounts[i - 1];
                    double percentage = Model.TotalReviews > 0 ? ((double)count / Model.TotalReviews) * 100 : 0;
                    <div class="rating-bar-row">
                        <span>@i <i class="fas fa-star" style="color: #F59E0B; font-size: 10px;"></i></span>
                        <div class="progress-track">
                            <div class="progress-fill" style="width: @percentage.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%;"></div>
                        </div>
                        <span style="min-width: 30px; text-align: right;">@count</span>
                    </div>
                }
            </div>
        </div>

        <div class="review-list">
            @if (Model.ApprovedReviews != null && Model.ApprovedReviews.Any())
            {
                foreach (var review in Model.ApprovedReviews)
                {
                    <div class="review-item">
                        <div class="review-header">
                            <div class="reviewer-name">
                                @(review.Customer?.FullName ?? "Khách hàng")
                                @if (review.OrderId != null)
                                {
                                    <span class="verified-badge"><i class="fas fa-check-circle"></i> Đã mua hàng</span>
                                }
                            </div>
                            <div class="review-date">@review.CreatedAt?.ToString("dd/MM/yyyy HH:mm")</div>
                        </div>
                        <div class="review-stars">
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= review.Rating) { <i class="fas fa-star"></i> }
                                else { <i class="far fa-star"></i> }
                            }
                        </div>
                        <div class="review-body">@review.Comment</div>
                        
                        @if (!string.IsNullOrEmpty(review.AdminReply))
                        {
                            <div class="admin-reply-box">
                                <strong>Phản hồi từ PHONE.ST:</strong>
                                <p>@review.AdminReply</p>
                            </div>
                        }
                    </div>
                }
            }
            else
            {
                <div style="text-align: center; padding: 40px; color: var(--navy-medium); background: var(--navy-light); border-radius: 8px;">
                    Chương trình chưa ghi nhận đánh giá nào cho thiết bị này.
                </div>
            }
        </div>
        
        @if (User.Identity.IsAuthenticated)
        {
            <div class="review-form-wrapper">
                <h4 style="margin-top: 0; color: var(--navy-deep);">Gửi đánh giá của bạn</h4>
                <form action="/Review/Submit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ProductId" value="@Model.Product.ProductId" />
                    
                    <div style="margin-bottom: 16px;">
                        <label style="display: block; font-size: 13px; font-weight: 700; margin-bottom: 8px;">Mức độ hài lòng:</label>
                        <div class="star-rating-input">
                            <input type="radio" id="star5" name="Rating" value="5" checked />
                            <label for="star5" title="5 sao"><i class="fas fa-star"></i></label>
                            <input type="radio" id="star4" name="Rating" value="4" />
                            <label for="star4" title="4 sao"><i class="fas fa-star"></i></label>
                            <input type="radio" id="star3" name="Rating" value="3" />
                            <label for="star3" title="3 sao"><i class="fas fa-star"></i></label>
                            <input type="radio" id="star2" name="Rating" value="2" />
                            <label for="star2" title="2 sao"><i class="fas fa-star"></i></label>
                            <input type="radio" id="star1" name="Rating" value="1" />
                            <label for="star1" title="1 sao"><i class="fas fa-star"></i></label>
                        </div>
                    </div>
                    
                    <div style="margin-bottom: 16px;">
                        <textarea name="Comment" rows="3" class="form-control" placeholder="Chia sẻ cảm nhận của bạn về chất lượng sản phẩm..." style="width: 100%; padding: 12px; border: 1px solid var(--border-color); border-radius: 4px; font-family: inherit; font-size: 13px;" required></textarea>
                    </div>
                    
                    <button type="submit" class="btn-dark" style="padding: 10px 24px; font-weight: 700; border-radius: 4px;">GỬI ĐÁNH GIÁ</button>
                </form>
            </div>
        }
    </div>
</div>

<div class="section-wrapper" style="margin-top: 40px; border-top: 1px solid var(--border-color); padding-top: 40px;">
    <div class="section-header-title">Khám phá các phiên bản tương đương</div>
    <div class="product-scroll-container">
        @foreach (var item in Model.UpSellProducts)
        {
            var itemVariant = item.ProductVariants?.OrderBy(v => v.Price).FirstOrDefault();
            <a href="/Store/Product/@item.ProductId" class="market-product-card">
                <img src="@item.MainImage" alt="@item.Name" class="product-card-img" onerror="this.src='https://via.placeholder.com/200?text=No+Image'" />
                <div class="product-card-name">@item.Name</div>
                <div class="price-group-market">
                    @if (itemVariant != null)
                    {
                        <span class="price-market-current">@string.Format("{0:N0}", itemVariant.DiscountPrice ?? itemVariant.Price) đ</span>
                    }
                </div>
            </a>
        }
    </div>
</div>

@section Scripts {
    <script>
        // TẢI DỮ LIỆU MA TRẬN BIẾN THỂ TỪ BACKEND
        const variantMatrix = @Html.Raw(Json.Serialize(Model.Product.ProductVariants.Where(v => v.IsActive == true).Select(v => new {
            variantId = v.VariantId,
            color = v.Color ?? "",
            ram = v.Ram ?? "",
            storage = v.Storage ?? "",
            price = v.Price,
            discountPrice = v.DiscountPrice,
            stock = v.Stock,
            imageUrl = v.ImageUrl
        })));

        const minPriceFromServer = @((minPrice ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture));
        
        let currentSelection = { storage: null, ram: null, color: null };

        // ĐỘNG CƠ KHÓA CHÉO (CROSS-LOCKING ENGINE)
        function toggleSelection(type, value, element) {
            if (element.classList.contains('disabled-chip')) return;

            if (currentSelection[type] === value) {
                currentSelection[type] = null;
                element.classList.remove('active');
            } else {
                currentSelection[type] = value;
                document.querySelectorAll(`.attr-${type}`).forEach(el => el.classList.remove('active'));
                element.classList.add('active');
            }

            evaluateMatrix();
        }

        function evaluateMatrix() {
            // Quét và làm mờ các tổ hợp không tồn tại
            document.querySelectorAll('.attr-storage').forEach(el => checkAvailability('storage', el.getAttribute('data-val'), el));
            document.querySelectorAll('.attr-ram').forEach(el => checkAvailability('ram', el.getAttribute('data-val'), el));
            document.querySelectorAll('.attr-color').forEach(el => checkAvailability('color', el.getAttribute('data-val'), el));

            // Kiểm tra xem tổ hợp khách vừa bấm có tạo ra ID cuối cùng không
            const exactMatch = variantMatrix.find(v => 
                (!currentSelection.storage || v.storage === currentSelection.storage) &&
                (!currentSelection.ram || v.ram === currentSelection.ram) &&
                (!currentSelection.color || v.color === currentSelection.color) &&
                (currentSelection.storage !== null || v.storage === "") &&
                (currentSelection.ram !== null || v.ram === "") &&
                (currentSelection.color !== null || v.color === "")
            );

            updateUIPanel(exactMatch);
        }

        function checkAvailability(typeToCheck, valueToCheck, element) {
            let testSelection = { ...currentSelection };
            testSelection[typeToCheck] = valueToCheck;

            const isAvailable = variantMatrix.some(v => 
                (!testSelection.storage || v.storage === testSelection.storage) &&
                (!testSelection.ram || v.ram === testSelection.ram) &&
                (!testSelection.color || v.color === testSelection.color)
            );

            if (isAvailable) {
                element.classList.remove('disabled-chip');
            } else {
                element.classList.add('disabled-chip');
                element.classList.remove('active');
                if (currentSelection[typeToCheck] === valueToCheck) currentSelection[typeToCheck] = null;
            }
        }

        function updateUIPanel(match) {
            const lblPrice = document.getElementById('lblCurrentPrice');
            const lblOldPrice = document.getElementById('lblOldPrice');
            const lblStock = document.getElementById('lblStockStatus');
            const hiddenId = document.getElementById('hiddenVariantId');
            const btnSubmitCart = document.getElementById('btnSubmitCart');
            const btnBuyNow = document.getElementById('btnBuyNow');
            const formatVND = (num) => new Intl.NumberFormat('vi-VN').format(num) + " đ";

            if (match) {
                hiddenId.value = match.variantId;
                const currentPrice = (match.discountPrice > 0) ? match.discountPrice : match.price;

                lblPrice.innerText = formatVND(currentPrice);
                if (match.discountPrice > 0 && match.discountPrice < match.price) {
                    lblOldPrice.innerText = formatVND(match.price);
                    lblOldPrice.style.display = "inline";
                } else {
                    lblOldPrice.style.display = "none";
                }

                if (match.stock > 0) {
                    lblStock.innerText = `Còn hàng (Kho: ${match.stock})`;
                    lblStock.style.color = "var(--navy-deep)";
                    btnSubmitCart.disabled = false;
                    btnBuyNow.disabled = false;
                } else {
                    lblStock.innerText = "Phiên bản này hiện đã hết hàng";
                    lblStock.style.color = "var(--accent-red)";
                    btnSubmitCart.disabled = true;
                    btnBuyNow.disabled = true;
                }

                if (match.imageUrl) changeGalleryImage(match.imageUrl, document.querySelector('.pdp-thumb-item'));
            } else {
                lblPrice.innerText = minPriceFromServer > 0 ? formatVND(minPriceFromServer) : "Liên hệ";
                lblOldPrice.style.display = "none";
                lblStock.innerText = "Vui lòng chọn cấu hình và màu sắc";
                lblStock.style.color = "#94A3B8";
                btnSubmitCart.disabled = true;
                btnBuyNow.disabled = true;
                hiddenId.value = "";
            }
        }

        function changeGalleryImage(src, element) {
            const mainImg = document.getElementById('mainPdpImage');
            mainImg.style.opacity = 0.3;
            setTimeout(() => { mainImg.src = src; mainImg.style.opacity = 1; }, 150);
            if(element) {
                document.querySelectorAll('.pdp-thumb-item').forEach(item => item.classList.remove('active'));
                element.classList.add('active');
            }
        }

        // ĐỘNG CƠ AJAX SUBMIT CHO CẢ MUA NGAY VÀ THÊM VÀO GIỎ
        let submitActionType = 'add';
        document.getElementById('btnSubmitCart')?.addEventListener('click', () => submitActionType = 'add');
        document.getElementById('btnBuyNow')?.addEventListener('click', () => submitActionType = 'buy');

        document.getElementById('formAddToCart')?.addEventListener('submit', function(e) {
            e.preventDefault(); 
            const formData = new FormData(this);
            formData.set('actionType', submitActionType);

            fetch(this.action, {
                method: this.method,
                body: formData,
                headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    if (data.action === 'redirect') {
                        window.location.href = data.url;
                    } else {
                        updateCartBadge(data.cartCount);
                        showShopeeToast("Sản phẩm đã được thêm vào Giỏ hàng");
                    }
                }
            }).catch(err => console.error('Lỗi truyền tải AJAX:', err));
        });

        function updateCartBadge(count) {
            const badge = document.querySelector('.cart-badge');
            if (badge) {
                badge.innerText = count;
                badge.classList.add('has-items');
                badge.style.animation = 'none';
                badge.offsetHeight; 
                badge.style.animation = 'popBadge 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards';
            }
        }

        function showShopeeToast(message) {
            let toast = document.getElementById('shopee-toast');
            if (!toast) {
                toast = document.createElement('div');
                toast.id = 'shopee-toast';
                toast.innerHTML = `<i class="fas fa-check-circle" style="font-size:36px; color:#10B981; margin-bottom:12px; display:block;"></i><span style="font-size:14px; font-weight:700;">${message}</span>`;
                toast.style.cssText = "position:fixed; top:50%; left:50%; transform:translate(-50%,-50%); background:rgba(0,0,0,0.85); color:#fff; padding:30px 40px; border-radius:8px; text-align:center; z-index:9999; opacity:0; visibility:hidden; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); box-shadow: 0 10px 25px rgba(0,0,0,0.2);";
                document.body.appendChild(toast);
            }
            toast.style.visibility = 'visible';
            toast.style.opacity = '1';
            toast.style.transform = 'translate(-50%, -50%) scale(1.05)';
            setTimeout(() => { toast.style.transform = 'translate(-50%, -50%) scale(1)'; }, 50);
            setTimeout(() => {
                toast.style.opacity = '0';
                setTimeout(() => toast.style.visibility = 'hidden', 300);
            }, 1800);
        }

        // Tự động kiểm tra và khóa các thuộc tính khi tải trang lần đầu
        document.addEventListener('DOMContentLoaded', () => {
            evaluateMatrix();
        });
    </script>
}