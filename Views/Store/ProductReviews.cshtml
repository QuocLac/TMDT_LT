@model IEnumerable<TMDT_LT.Models.Reviews>
@{
    Layout = "_Layout";
    var product = ViewBag.Product as TMDT_LT.Models.Products;
    double avgRating = ViewBag.AverageRating ?? 0;
    int totalReviews = ViewBag.TotalReviews ?? 0;
    var starCounts = ViewBag.StarCounts as Dictionary<int, int>;
    int? selectedStar = ViewBag.SelectedStar;
    ViewData["Title"] = "Đánh giá chi tiết " + product?.Name;
}

@section Styles {
    <link rel="stylesheet" href="~/css/storefront/store-checkout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/storefront/store-orders.css" asp-append-version="true" />
    <style>
        .filter-star-btn {
            padding: 8px 16px;
            border: 1px solid #E2E8F0;
            background: #FFFFFF;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 700;
            color: #475569;
            cursor: pointer;
            text-decoration: none;
            transition: all 0.2s ease;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

            .filter-star-btn:hover, .filter-star-btn.active {
                background: var(--navy-deep, #0F172A);
                color: #FFFFFF;
                border-color: var(--navy-deep, #0F172A);
            }

        /* CSS ICON SAO TRẮNG VIỀN VÀNG */
        .star-custom {
            color: #FFFFFF !important;
            -webkit-text-stroke: 1.5px #F59E0B;
            font-size: 15px;
        }

            .star-custom.filled {
                color: #F59E0B !important;
                -webkit-text-stroke: 1px #F59E0B;
            }

        .rating-bar-wrapper {
            flex: 1;
            height: 8px;
            background: #E2E8F0;
            border-radius: 4px;
            overflow: hidden;
        }

        .rating-bar-progress {
            height: 100%;
            background: var(--navy-deep, #0F172A);
            border-radius: 4px;
            transition: width 0.4s ease;
        }

        /* PHẢN HỒI ADMIN */
        .admin-reply-box {
            margin-top: 12px;
            padding: 12px 16px;
            background: #EFF6FF;
            border-left: 4px solid #3B82F6;
            border-radius: 6px;
        }

            .admin-reply-box .admin-reply-header {
                display: flex;
                align-items: center;
                gap: 8px;
                margin-bottom: 6px;
            }

                .admin-reply-box .admin-reply-header i {
                    color: #3B82F6;
                }

                .admin-reply-box .admin-reply-header span {
                    font-weight: 700;
                    color: #1E40AF;
                    font-size: 13px;
                }

            .admin-reply-box .admin-reply-content {
                font-size: 13px;
                color: #1E3A8A;
                margin: 0;
                line-height: 1.6;
            }
    </style>
}

<div class="orders-page-container" style="max-width: 1000px; margin: 40px auto; padding: 0 20px;">

    <a href="/Store/Product/@product?.ProductId" style="display: inline-flex; align-items: center; gap: 8px; color: #64748B; text-decoration: none; font-size: 14px; font-weight: 700; margin-bottom: 24px;">
        <i class="fas fa-arrow-left"></i> Quay lại trang chi tiết sản phẩm
    </a>

    <div style="background: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 12px; padding: 32px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.02);">
        <h2 style="font-size: 20px; font-weight: 900; color: var(--navy-deep, #0F172A); margin-bottom: 24px; text-transform: uppercase;">
            Đánh giá chuyên sâu - @product?.Name
        </h2>

        <div style="display: grid; grid-template-columns: 1fr 2fr; gap: 40px; align-items: center; border-bottom: 1px solid #F1F5F9; padding-bottom: 32px; margin-bottom: 32px;">
            <div style="text-align: center; border-right: 1px solid #E2E8F0; padding-right: 40px;">
                <div style="font-size: 54px; font-weight: 900; color: var(--navy-deep, #0F172A); line-height: 1;">@avgRating.ToString("0.0")</div>
                <div style="margin: 10px 0; font-size: 18px;">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <i class="fas fa-star star-custom @(i <= Math.Round(avgRating) ? "filled" : "")"></i>
                    }
                </div>
                <div style="font-size: 13px; color: #64748B; font-weight: 600;">@totalReviews nhận xét từ khách mua thực tế</div>
            </div>

            <div>
                @for (int i = 5; i >= 1; i--)
                {
                    int count = starCounts != null && starCounts.ContainsKey(i) ? starCounts[i] : 0;
                    double percent = totalReviews > 0 ? ((double)count / totalReviews) * 100 : 0;
                    <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 8px; font-size: 13px; font-weight: 700; color: #475569;">
                        <span style="width: 45px; text-align: right;">@i sao</span>
                        <div class="rating-bar-wrapper">
                            <div class="rating-bar-progress" style="width: @(percent)%;"></div>
                        </div>
                        <span style="width: 40px; color: #94A3B8; margin-left: 4px;">@count</span>
                    </div>
                }
            </div>
        </div>

        <div style="margin-bottom: 32px;">
            <div style="font-size: 14px; font-weight: 800; color: var(--navy-deep, #0F172A); margin-bottom: 12px;">LỌC THEO SỐ SAO TIÊU CHÍ:</div>
            <div style="display: flex; flex-wrap: wrap; gap: 10px;">
                <a href="/Store/Product/@product?.ProductId/Reviews" class="filter-star-btn @(!selectedStar.HasValue ? "active" : "")">Tất cả</a>
                @for (int i = 5; i >= 1; i--)
                {
                    <a href="/Store/Product/@product?.ProductId/Reviews?starFilter=@i" class="filter-star-btn @(selectedStar == i ? "active" : "")">
                        @i Sao (@(starCounts?.ContainsKey(i) == true ? starCounts[i] : 0))
                    </a>
                }
            </div>
        </div>

        <div class="reviews-extended-list">
            @if (Model != null && Model.Any())
            {
                foreach (var rev in Model)
                {
                    var details = rev.ReviewDetails?.FirstOrDefault();
                    <div style="padding: 24px 0; border-bottom: 1px solid #F1F5F9;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                            <div style="display: flex; align-items: center; gap: 10px;">
                                <strong style="color: var(--navy-deep, #0F172A); font-size: 15px;">@rev.Customer?.FullName</strong>
                                <span style="font-size: 11px; font-weight: 800; background: #DCFCE7; color: #15803D; padding: 2px 8px; border-radius: 4px; text-transform: uppercase;">
                                    <i class="fas fa-check-circle"></i> Xác thực đã mua hàng
                                </span>
                            </div>
                            <span style="font-size: 12px; color: #94A3B8; font-weight: 600;">@(rev.CreatedAt?.ToString("dd/MM/yyyy HH:mm"))</span>
                        </div>
                        <div style="margin-bottom: 12px;">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <i class="fas fa-star star-custom @(i <= (rev.Rating ?? 5) ? "filled" : "")"></i>
                            }
                            @if (details?.Variant != null)
                            {
                                <span style="color: #64748B; font-size: 12px; font-weight: 700; margin-left: 12px;">
                                    Phân loại: @(details.Variant.Ram)/@(details.Variant.Storage) - @details.Variant.Color
                                </span>
                            }
                        </div>

                        @* KẾT XUẤT ĐỊNH DẠNG BÌNH LUẬN & MULTIMEDIA (SHOPEE STYLE) *@
                        @{
                            var commentLines = rev.Comment?.Split('\n') ?? new string[0];
                        }
                        <div style="background: #F8FAFC; padding: 16px; border-radius: 8px; border: 1px solid #F1F5F9;">
                            @foreach (var line in commentLines)
                            {
                                <p style="font-size: 14px; color: #334155; line-height: 1.6; margin: 0 0 6px 0;">@line</p>
                            }

                            @* =========================================================
                               PHẢN HỒI CỦA ADMIN - HIỂN THỊ NGAY DƯỚI BÌNH LUẬN KHÁCH HÀNG
                               ========================================================= *@
                            @if (!string.IsNullOrEmpty(rev.AdminReply))
                            {
                                <div class="admin-reply-box">
                                    <div class="admin-reply-header">
                                        <i class="fas fa-store"></i>
                                        <span>Phản hồi từ cửa hàng KingPhone:</span>
                                    </div>
                                    <p class="admin-reply-content">@rev.AdminReply</p>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(details?.MediaUrls))
                            {
                                var medias = details.MediaUrls.Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries);
                                if (medias.Any())
                                {
                                    <div style="display: flex; gap: 8px; flex-wrap: wrap; margin-top: 12px;">
                                        @foreach (var m in medias)
                                        {
                                            if (m.EndsWith(".mp4", StringComparison.OrdinalIgnoreCase) || m.EndsWith(".mov", StringComparison.OrdinalIgnoreCase) || m.EndsWith(".avi", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <video src="@m" style="width: 80px; height: 80px; object-fit: cover; border-radius: 6px; border: 1px solid #E2E8F0;" controls></video>
                                            }
                                            else
                                            {
                                                <a href="@m" target="_blank">
                                                    <img src="@m" style="width: 80px; height: 80px; object-fit: cover; border-radius: 6px; border: 1px solid #E2E8F0; cursor: pointer; transition: 0.2s;" onmouseover="this.style.opacity='0.8'" onmouseout="this.style.opacity='1'" />
                                                </a>
                                            }
                                        }
                                    </div>
                                }
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div style="text-align: center; padding: 40px 20px; color: #94A3B8; font-size: 14px; font-style: italic;">
                    Không tìm thấy bài đánh giá nào khớp với tiêu chí số sao được lọc này.
                </div>
            }
        </div>
    </div>
</div>