@model TMDT_LT.Models.Orders
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>In mã vận đơn #ORD-@Model.OrderId</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            color: #000;
            margin: 15px;
            font-size: 13px;
            line-height: 1.4;
        }

        .text-center {
            text-align: center;
        }

        .text-right {
            text-align: right;
        }

        .invoice-title {
            font-size: 18px;
            font-weight: bold;
            text-transform: uppercase;
            margin-bottom: 5px;
        }

        .meta-table, .items-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
        }

            .items-table th, .items-table td {
                border: 1px solid #000;
                padding: 6px;
                text-align: left;
            }

            .items-table th {
                background-color: #F2F2F2;
                font-size: 11px;
                text-transform: uppercase;
            }

        .divider {
            border-top: 1px dashed #000;
            margin: 12px 0;
        }
    </style>
</head>
<body>

    <div class="text-center">
        <div class="invoice-title">Phiếu đóng gói kiêm vận đơn hàng</div>
        <div>Mã chứng từ: <strong>#ORD-@Model.OrderId</strong></div>
        <div style="font-size: 11px; margin-top: 3px;">Thời gian in phiếu: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</div>
    </div>

    <div class="divider"></div>

    <table class="meta-table">
        <tr>
            <td style="width: 50%;"><strong>Đơn vị xuất kho:</strong> Cửa hàng Công nghệ TMDT-LT</td>
            <td style="width: 50%;"><strong>Khách hàng người nhận:</strong> @Model.ShippingFullName</td>
        </tr>
        <tr>
            <td><strong>Đối tác giao vận:</strong> @(Model.Shipping?.FirstOrDefault()?.Carrier ?? "Nội bộ")</td>
            <td><strong>Số điện thoại:</strong> @Model.ShippingPhone</td>
        </tr>
        <tr>
            <td colspan="2"><strong>Địa chỉ giao hàng:</strong> @Model.ShippingStreet, @Model.ShippingDistrict, @Model.ShippingCity</td>
        </tr>
        @if (Model.Shipping?.FirstOrDefault()?.TrackingNumber != null)
        {
            <tr>
                <td colspan="2" style="padding-top: 5px; font-size: 14px;"><strong>MÃ VẬN ĐƠN TRA CỨU:</strong> <span style="font-family: monospace; font-weight: bold;">@Model.Shipping.FirstOrDefault().TrackingNumber</span></td>
            </tr>
        }
    </table>

    <table class="items-table">
        <thead>
            <tr>
                <th>Tên sản phẩm thiết bị & Cấu hình</th>
                <th style="text-align: center; width: 10%;">SL</th>
                <th style="text-align: right; width: 20%;">Đơn giá</th>
                <th style="text-align: right; width: 25%;">Thành tiền</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model.OrderDetails)
            {
                decimal subTotal = (d.Quantity ?? 0) * (d.UnitPrice ?? 0);
                <tr>
                    <td>
                        <strong>@d.Variant?.Product?.Name</strong>
                        <div style="font-size: 11px; color: #333;">Bản @d.Variant?.Storage | Màu @d.Variant?.Color</div>
                    </td>
                    <td class="text-center">@d.Quantity</td>
                    <td class="text-right">@string.Format("{0:N0}", d.UnitPrice)</td>
                    <td class="text-right">@string.Format("{0:N0}", subTotal)</td>
                </tr>
            }
            <tr>
                <td colspan="3" class="text-right" style="font-weight: bold;">Tổng số tiền cần thu:</td>
                <td class="text-right" style="font-weight: bold; font-size: 14px;">@string.Format("{0:N0}", Model.TotalAmount) đ</td>
            </tr>
        </tbody>
    </table>

    <div class="divider" style="margin-top: 25px;"></div>

    <table class="meta-table" style="text-align: center; margin-top: 5px; font-size: 12px;">
        <tr>
            <td style="width: 33%;"><strong>Nhân viên kho lập phiếu</strong><br><br><br><br><i>(Ký, ghi rõ họ tên)</i></td>
            <td style="width: 34%;"><strong>Nhân viên giao nhận</strong><br><br><br><br><i>(Ký, ghi rõ họ tên)</i></td>
            <td style="width: 33%;"><strong>Người nhận hàng kiểm hàng</strong><br><br><br><br><i>(Ký, ghi rõ họ tên)</i></td>
        </tr>
    </table>

    <script>
        window.onload = function () {
            window.print();
            window.onafterprint = function () { window.close(); }
        }
    </script>
</body>
</html>