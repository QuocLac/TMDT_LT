@model TMDT_LT.Models.FlashSales
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Điều chỉnh chương trình Flash Sale";
    dynamic policy = ViewBag.EditPolicy;
    bool canEditCampaign = policy?.CanEditCampaign ?? false;
    bool canEditStartTime = policy?.CanEditStartTime ?? false;
    bool canEditPrice = policy?.CanEditPrice ?? false;
    bool canAddOrRemoveItems = policy?.CanAddOrRemoveItems ?? false;
    bool canEndEarly = policy?.CanEndEarly ?? false;
}

<style>
    .fs-card { background:#fff; border:1px solid #E5E7EB; border-radius:10px; padding:22px; margin-bottom:20px; }
    .fs-title { font-size:14px; text-transform:uppercase; font-weight:800; color:#111827; margin-bottom:14px; }
    .fs-grid { display:grid; grid-template-columns:repeat(2, minmax(0,1fr)); gap:16px; }
    .fs-field label { display:block; font-size:12px; font-weight:800; color:#475569; margin-bottom:6px; }
    .fs-field input, .fs-field textarea, .fs-field select { width:100%; border:1px solid #CBD5E1; border-radius:8px; padding:10px 12px; font-size:14px; outline:none; }
    .fs-field input:disabled { background:#F8FAFC; color:#94A3B8; cursor:not-allowed; }
    .policy-box { background:#FFFBEB; border:1px solid #FDE68A; color:#92400E; padding:14px 16px; border-radius:8px; font-size:13px; font-weight:600; margin-bottom:18px; }
    .policy-box.locked { background:#FEF2F2; border-color:#FECACA; color:#991B1B; }
    .item-card { border:1px solid #E5E7EB; border-radius:10px; padding:16px; margin-bottom:14px; background:#FFFFFF; }
    .item-head { display:flex; justify-content:space-between; gap:15px; align-items:flex-start; margin-bottom:12px; }
    .muted { color:#64748B; font-size:12px; }
    .danger-text { color:#DC2626; font-weight:800; font-size:12px; }
    .btn-mini { border:1px solid #CBD5E1; background:#fff; border-radius:7px; padding:7px 10px; font-size:12px; font-weight:800; cursor:pointer; }
    .btn-danger-mini { border:1px solid #FECACA; color:#DC2626; background:#FEF2F2; border-radius:7px; padding:7px 10px; font-size:12px; font-weight:800; cursor:pointer; }
    .switch-line { display:flex; align-items:center; gap:8px; font-size:12px; font-weight:700; color:#475569; }
</style>

<div style="display:flex; justify-content:space-between; align-items:flex-end; gap:20px; margin-bottom:25px;">
    <div>
        <a asp-action="Details" asp-route-id="@Model.FlashSaleId" style="text-decoration:none; color:#6B7280; font-size:13px; font-weight:700; display:inline-block; margin-bottom:8px;">← Quay lại báo cáo</a>
        <h2 style="margin:0; font-weight:900; color:#111827;">Điều chỉnh chương trình Flash Sale</h2>
        <p style="margin:4px 0 0; color:#64748B; font-size:14px;">Mọi điều chỉnh sau khi công bố đều được lưu vào lịch sử vận hành để phục vụ đối soát.</p>
    </div>
    @if (canEndEarly)
    {
        <button type="button" class="btn-danger-mini" onclick="endNow()">Dừng chương trình</button>
    }
</div>

<div class="policy-box @(canEditCampaign ? "" : "locked")">
    <div style="font-weight:900; margin-bottom:4px;">Trạng thái vận hành: @(policy?.Mode ?? "Không xác định")</div>
    <div>
        Sắp mở bán: có thể điều chỉnh thông tin niêm yết. Đang mở bán: chỉ điều chỉnh trong phạm vi không ảnh hưởng đơn đã phát sinh. Đã chốt chương trình: khóa toàn bộ dữ liệu giá, số lượng và thời gian để bảo toàn lịch sử giao dịch.
    </div>
    @if (!canEditCampaign)
    {
        <div style="margin-top:8px; font-weight:800;">Chương trình đã chốt sổ. Vui lòng dùng trang báo cáo để xem hiệu quả bán hàng thay vì chỉnh sửa dữ liệu cũ.</div>
    }
</div>

<div class="fs-card">
    <div class="fs-title">Thông tin chương trình</div>
    <div class="fs-grid">
        <div class="fs-field">
            <label>Tên chương trình</label>
            <input id="fsName" value="@Model.Name" @(canEditCampaign ? "" : "disabled") />
        </div>
        <div class="fs-field">
            <label>Trạng thái</label>
            <select id="fsIsActive" @(canEditCampaign ? "" : "disabled")>
                @if (Model.IsActive)
                {
                    <option value="true" selected>Đang mở bán</option>
                    <option value="false">Tạm dừng bán</option>
                }
                else
                {
                    <option value="true">Đang mở bán</option>
                    <option value="false" selected>Tạm dừng bán</option>
                }
            </select>
        </div>
        <div class="fs-field">
            <label>Thời gian bắt đầu</label>
            <input type="datetime-local" id="fsStartTime" value="@Model.StartTime.ToString("yyyy-MM-ddTHH:mm")" @((canEditCampaign && canEditStartTime) ? "" : "disabled") />
        </div>
        <div class="fs-field">
            <label>Thời gian kết thúc</label>
            <input type="datetime-local" id="fsEndTime" value="@Model.EndTime.ToString("yyyy-MM-ddTHH:mm")" @(canEditCampaign ? "" : "disabled") />
        </div>
    </div>
    <div class="fs-field" style="margin-top:16px;">
        <label>Lý do điều chỉnh <span style="color:#DC2626;">*</span></label>
        <textarea id="changeReason" rows="3" placeholder="VD: Gia hạn khung bán do nhu cầu tăng / Bổ sung suất bán theo tồn kho mới / Dừng bán để kiểm tra giá niêm yết..." @(canEditCampaign ? "" : "disabled")></textarea>
    </div>
</div>

<div class="fs-card">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
        <div class="fs-title" style="margin:0;">Sản phẩm mở bán</div>
        @if (canAddOrRemoveItems)
        {
            <button type="button" class="btn-mini" onclick="addManualItem()">+ Thêm sản phẩm theo VariantId</button>
        }
    </div>
    <div id="itemsWrap"></div>
</div>

<div style="display:flex; justify-content:flex-end; gap:10px; margin-bottom:40px;">
    <a asp-action="Details" asp-route-id="@Model.FlashSaleId" class="btn-outline">Hủy</a>
    <button type="button" class="btn-dark" onclick="saveEdit()" @(canEditCampaign ? "" : "disabled")>@(canEditCampaign ? "Lưu điều chỉnh" : "Chương trình đã chốt sổ")</button>
</div>

<script>
    const canEditCampaign = @canEditCampaign.ToString().ToLower();
    const canEditPrice = @canEditPrice.ToString().ToLower();
    const canAddOrRemoveItems = @canAddOrRemoveItems.ToString().ToLower();
    const flashSaleId = @Model.FlashSaleId;
    let items = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.FlashSaleItems.Select(i => new {
        itemId = i.ItemId,
        variantId = i.VariantId,
        productName = i.Variant != null && i.Variant.Product != null ? i.Variant.Product.Name : "Sản phẩm",
        color = i.Variant != null ? i.Variant.Color : "",
        storage = i.Variant != null ? i.Variant.Storage : "",
        flashSalePrice = i.FlashSalePrice,
        quantity = i.Quantity,
        sold = i.Sold,
        maxPerUser = i.MaxPerUser,
        useAllStock = false,
        isUnlimitedPerUser = i.MaxPerUser <= 0
    })));

    function moneyInputValue(value) {
        return Number(value || 0).toString();
    }

    function renderItems() {
        const wrap = document.getElementById('itemsWrap');
        wrap.innerHTML = '';
        if (!items.length) {
            wrap.innerHTML = '<div style="padding:30px; text-align:center; color:#94A3B8;">Chưa có sản phẩm nào.</div>';
            return;
        }

        items.forEach((item, index) => {
            const isSold = Number(item.sold || 0) > 0;
            const lockVariant = !canAddOrRemoveItems || isSold;
            const lockPrice = !canEditPrice || isSold;
            const removable = canAddOrRemoveItems && !isSold;
            const unlimitedChecked = item.isUnlimitedPerUser ? 'checked' : '';
            const useAllStockChecked = item.useAllStock ? 'checked' : '';
            const maxDisabled = item.isUnlimitedPerUser ? 'disabled' : '';
            const quantityDisabled = item.useAllStock ? 'disabled' : '';

            wrap.insertAdjacentHTML('beforeend', `
                <div class="item-card" data-index="${index}">
                    <div class="item-head">
                        <div>
                            <strong style="color:#111827;">${item.productName}</strong>
                            <div class="muted">${item.storage || ''} ${item.color ? '- ' + item.color : ''} · VariantId #${item.variantId} · Đã bán ${item.sold || 0}</div>
                            ${isSold ? '<div class="danger-text">Đã phát sinh đơn: khóa sản phẩm và giá bán để giữ đúng lịch sử giao dịch</div>' : ''}
                        </div>
                        ${removable ? `<button type="button" class="btn-danger-mini" onclick="removeItem(${index})">Xóa</button>` : ''}
                    </div>
                    <div class="fs-grid">
                        <div class="fs-field">
                            <label>VariantId</label>
                            <input type="number" value="${item.variantId}" ${lockVariant ? 'disabled' : ''} onchange="updateItem(${index}, 'variantId', this.value)" />
                        </div>
                        <div class="fs-field">
                            <label>Giá Flash Sale</label>
                            <input type="number" min="1" value="${moneyInputValue(item.flashSalePrice)}" ${lockPrice ? 'disabled' : ''} onchange="updateItem(${index}, 'flashSalePrice', this.value)" />
                        </div>
                        <div class="fs-field">
                            <label>Tổng suất mở bán</label>
                            <input type="number" min="${item.sold || 0}" value="${item.quantity}" ${quantityDisabled} onchange="updateItem(${index}, 'quantity', this.value)" />
                            <label class="switch-line" style="margin-top:8px;"><input type="checkbox" ${useAllStockChecked} onchange="toggleUseAllStock(${index}, this.checked)" /> Dùng toàn bộ tồn kho còn khả dụng</label>
                        </div>
                        <div class="fs-field">
                            <label>Giới hạn mua mỗi khách</label>
                            <input type="number" min="0" value="${item.maxPerUser || 0}" ${maxDisabled} onchange="updateItem(${index}, 'maxPerUser', this.value)" />
                            <label class="switch-line" style="margin-top:8px;"><input type="checkbox" ${unlimitedChecked} onchange="toggleUnlimited(${index}, this.checked)" /> Không giới hạn theo khách</label>
                        </div>
                    </div>
                </div>
            `);
        });
    }

    function updateItem(index, field, value) {
        const numberFields = ['variantId', 'flashSalePrice', 'quantity', 'maxPerUser'];
        items[index][field] = numberFields.includes(field) ? Number(value || 0) : value;
    }

    function toggleUseAllStock(index, checked) {
        items[index].useAllStock = checked;
        renderItems();
    }

    function toggleUnlimited(index, checked) {
        items[index].isUnlimitedPerUser = checked;
        if (checked) items[index].maxPerUser = 0;
        renderItems();
    }

    function removeItem(index) {
        items.splice(index, 1);
        renderItems();
    }

    function addManualItem() {
        items.push({
            itemId: 0,
            variantId: 0,
            productName: 'Biến thể mới',
            color: '',
            storage: '',
            flashSalePrice: 0,
            quantity: 1,
            sold: 0,
            maxPerUser: 0,
            useAllStock: false,
            isUnlimitedPerUser: true
        });
        renderItems();
    }

    async function saveEdit() {
        const reason = document.getElementById('changeReason').value.trim();
        if (!reason) {
            alert('Vui lòng nhập lý do điều chỉnh để phục vụ đối soát vận hành.');
            return;
        }

        const payload = {
            flashSaleId,
            name: document.getElementById('fsName').value.trim(),
            startTime: document.getElementById('fsStartTime').value,
            endTime: document.getElementById('fsEndTime').value,
            isActive: document.getElementById('fsIsActive').value === 'true',
            reason,
            items: items.map(i => ({
                itemId: Number(i.itemId || 0),
                variantId: Number(i.variantId || 0),
                flashSalePrice: Number(i.flashSalePrice || 0),
                quantity: Number(i.quantity || 0),
                useAllStock: !!i.useAllStock,
                isUnlimitedPerUser: !!i.isUnlimitedPerUser,
                maxPerUser: Number(i.maxPerUser || 0)
            }))
        };

        const res = await fetch('@Url.Action("UpdateCampaign", "FlashSale", new { area = "Admin" })', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (!data.success) {
            alert(data.message || 'Không thể cập nhật chương trình.');
            return;
        }
        alert(data.message || 'Cập nhật chương trình thành công.');
        window.location.href = '@Url.Action("Details", "FlashSale", new { area = "Admin", id = Model.FlashSaleId })';
    }

    async function endNow() {
        const reason = prompt('Nhập lý do dừng chương trình:');
        if (!reason || !reason.trim()) return;
        const res = await fetch('@Url.Action("EndNow", "FlashSale", new { area = "Admin" })', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ flashSaleId, reason: reason.trim() })
        });
        const data = await res.json();
        if (!data.success) {
            alert(data.message || 'Không thể dừng chương trình.');
            return;
        }
        alert(data.message || 'Đã dừng chương trình.');
        window.location.href = '@Url.Action("Details", "FlashSale", new { area = "Admin", id = Model.FlashSaleId })';
    }

    renderItems();
</script>
