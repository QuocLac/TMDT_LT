@using TMDT_LT.Models
@model TMDT_LT.Models.FlashSales
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Báo cáo Flash Sale: " + Model.Name;
    var changeLogs = ViewBag.ChangeLogs as List<FlashSaleChangeLogs> ?? new List<FlashSaleChangeLogs>();
    dynamic policy = ViewBag.EditPolicy;
}

<style>
    .kpi-card { background: #FFFFFF; border: 1px solid #E5E7EB; border-radius: 8px; padding: 20px; flex: 1; border-top: 4px solid #111827; }
    .kpi-label { font-size: 12px; font-weight: 700; color: #6B7280; text-transform: uppercase; margin-bottom: 8px; }
    .kpi-value { font-size: 24px; font-weight: 800; color: #111827; font-family: monospace; }
    .progress-track { width: 100%; height: 6px; background: #F1F5F9; border-radius: 4px; margin-top: 6px; overflow: hidden; }
    .progress-fill { height: 100%; background: #DC2626; border-radius: 4px; transition: width 0.5s ease; }
    .audit-badge { display: inline-flex; padding: 4px 8px; border-radius: 999px; background: #EEF2FF; color: #3730A3; font-size: 11px; font-weight: 800; }
</style>

<div style="margin-bottom: 25px; display:flex; justify-content:space-between; align-items:flex-end; gap:20px;">
    <div>
        <a asp-action="Index" style="text-decoration: none; color: #6B7280; font-size: 13px; font-weight: 600; margin-bottom: 10px; display: inline-block;">← Quay lại danh sách</a>
        <h2 style="margin: 0; font-weight: 800; color: #111827;">Báo cáo: @Model.Name</h2>
        <p style="color: #6B7280; font-size: 14px; margin-top: 4px;">Thời gian: @Model.StartTime.ToString("dd/MM/yyyy HH:mm") - @Model.EndTime.ToString("dd/MM/yyyy HH:mm")</p>
        <span class="audit-badge">Trạng thái chỉnh sửa: @(policy?.Mode ?? "Không xác định")</span>
    </div>
    <a asp-action="Edit" asp-route-id="@Model.FlashSaleId" class="btn-dark">Chỉnh sửa có kiểm soát</a>
</div>

<div style="display: flex; gap: 20px; margin-bottom: 25px;">
    <div class="kpi-card"><div class="kpi-label">Tổng Doanh Thu Thực</div><div class="kpi-value" style="color: #059669;">@string.Format("{0:N0}", ViewBag.TotalRevenue) đ</div></div>
    <div class="kpi-card" style="border-top-color: #DC2626;"><div class="kpi-label">Lợi Nhuận Gộp Thực</div><div class="kpi-value">@string.Format("{0:N0}", ViewBag.TotalProfit) đ</div></div>
    <div class="kpi-card" style="border-top-color: #3B82F6;"><div class="kpi-label">Tốc độ tiêu thụ</div><div class="kpi-value">@ViewBag.SellThroughRate%</div><div style="font-size: 12px; color: #64748B; margin-top: 4px;">(Đã bán @ViewBag.TotalSold / @ViewBag.TotalQuantity)</div></div>
</div>

<div class="admin-card" style="padding: 0; overflow: hidden; margin-bottom: 25px;">
    <div style="padding: 16px 24px; background: #F8FAFC; border-bottom: 1px solid #E5E7EB;">
        <h3 style="margin: 0; font-size: 14px; font-weight: 700; text-transform: uppercase;">Chi tiết sản phẩm Sale</h3>
    </div>
    <table class="data-table">
        <thead>
            <tr>
                <th style="width: 32%;">Sản phẩm & Biến thể</th>
                <th style="width: 15%;">Giá Sale / Vốn</th>
                <th style="width: 25%;">Tiến độ</th>
                <th style="width: 13%; text-align:center;">Giới hạn</th>
                <th style="width: 15%; text-align: right;">Doanh thu / Lãi</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.FlashSaleItems)
            {
                decimal itemRev = item.Sold * item.FlashSalePrice;
                decimal itemProfit = item.Sold * (item.FlashSalePrice - (item.Variant?.CostPrice ?? 0));
                double percent = item.Quantity > 0 ? Math.Min(100, ((double)item.Sold / item.Quantity) * 100) : 0;
                string profitColor = itemProfit < 0 ? "#DC2626" : "#059669";
                <tr>
                    <td><strong style="font-size: 13px; color: #111827;">@item.Variant?.Product?.Name</strong><br /><span style="font-size: 12px; color: #6B7280;">@item.Variant?.Storage - @item.Variant?.Color</span></td>
                    <td><strong style="font-size: 13px;">@string.Format("{0:N0}", item.FlashSalePrice)đ</strong><br /><span style="font-size: 12px; color: #9CA3AF;">Vốn: @string.Format("{0:N0}", item.Variant?.CostPrice ?? 0)đ</span></td>
                    <td>
                        <div style="display: flex; justify-content: space-between; font-size: 12px; font-weight: 600;"><span style="color: #DC2626;">Đã bán: @item.Sold</span><span style="color: #6B7280;">Tổng suất: @item.Quantity</span></div>
                        <div class="progress-track"><div class="progress-fill" style="width: @percent%;"></div></div>
                    </td>
                    <td style="text-align:center; font-size:12px; font-weight:700;">@(item.MaxPerUser > 0 ? item.MaxPerUser + " / khách" : "Không giới hạn")</td>
                    <td style="text-align: right;"><strong style="font-size: 14px; color: #111827; font-family: monospace;">@string.Format("{0:N0}", itemRev)đ</strong><br /><span style="font-size: 12px; font-weight: 700; color: @profitColor;">Lãi: @string.Format("{0:N0}", itemProfit)đ</span></td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="admin-card" style="padding: 0; overflow: hidden;">
    <div style="padding: 16px 24px; background: #F8FAFC; border-bottom: 1px solid #E5E7EB; display:flex; justify-content:space-between; align-items:center;">
        <h3 style="margin: 0; font-size: 14px; font-weight: 700; text-transform: uppercase;">Nhật ký chỉnh sửa minh bạch</h3>
        <span style="font-size:12px; color:#64748B;">Lưu 100 thay đổi gần nhất</span>
    </div>
    <table class="data-table">
        <thead>
            <tr>
                <th>Thời gian</th>
                <th>Hành động</th>
                <th>Trường</th>
                <th>Giá trị cũ</th>
                <th>Giá trị mới</th>
                <th>Lý do</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var log in changeLogs)
            {
                <tr>
                    <td style="font-size:12px; color:#64748B;">@log.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                    <td><span class="audit-badge">@log.ActionType</span></td>
                    <td style="font-weight:700;">@log.FieldName</td>
                    <td style="font-size:12px; color:#6B7280;">@log.OldValue</td>
                    <td style="font-size:12px; color:#111827; font-weight:700;">@log.NewValue</td>
                    <td style="font-size:12px; color:#4B5563;">@log.Reason</td>
                </tr>
            }
            @if (!changeLogs.Any())
            {
                <tr><td colspan="6" style="text-align:center; padding:30px; color:#9CA3AF;">Chưa có lịch sử chỉnh sửa.</td></tr>
            }
        </tbody>
    </table>
</div>
