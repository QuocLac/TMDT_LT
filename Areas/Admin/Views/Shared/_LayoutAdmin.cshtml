<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hệ thống Quản trị</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <link rel="stylesheet" href="~/css/admin-root.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-components.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        /* CSS CHO ADMIN HEADER (CÔNG CỤ & TÀI KHOẢN) */
        .admin-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 24px;
            height: 64px;
            background-color: #FFFFFF;
            border-bottom: 1px solid #E5E7EB;
            position: sticky;
            top: 0;
            z-index: 50;
            box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
        }

        /* Khung tìm kiếm bên trái */
        .header-search {
            position: relative;
            width: 350px;
        }

            .header-search input {
                width: 100%;
                padding: 8px 16px 8px 40px;
                border: 1px solid #D1D5DB;
                border-radius: 6px;
                font-size: 13px;
                background-color: #F9FAFB;
                transition: all 0.2s;
            }

                .header-search input:focus {
                    outline: none;
                    border-color: #3B82F6;
                    background-color: #FFFFFF;
                    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
                }

            .header-search i {
                position: absolute;
                left: 14px;
                top: 50%;
                transform: translateY(-50%);
                color: #9CA3AF;
            }

        /* Các công cụ bên phải */
        .header-actions {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .action-btn {
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            color: #4B5563;
            background: transparent;
            border: none;
            cursor: pointer;
            transition: background 0.2s;
            text-decoration: none;
            position: relative;
        }

            .action-btn:hover {
                background-color: #F3F4F6;
                color: #111827;
            }

        /* Chấm đỏ thông báo */
        .notification-badge {
            position: absolute;
            top: 4px;
            right: 4px;
            width: 8px;
            height: 8px;
            background-color: #EF4444;
            border-radius: 50%;
            border: 2px solid #FFFFFF;
        }

        /* Đường kẻ chia cách */
        .header-divider {
            width: 1px;
            height: 24px;
            background-color: #E5E7EB;
            margin: 0 4px;
        }

        /* Khu vực Avatar & Dropdown */
        .header-profile {
            display: flex;
            align-items: center;
            gap: 12px;
            cursor: pointer;
            padding: 4px 8px;
            border-radius: 6px;
            transition: background 0.2s;
            position: relative;
        }

            .header-profile:hover {
                background-color: #F3F4F6;
            }

        .profile-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            object-fit: cover;
            border: 1px solid #E5E7EB;
        }

        .profile-info {
            display: flex;
            flex-direction: column;
        }

        .profile-name {
            font-size: 13px;
            font-weight: 600;
            color: #111827;
            line-height: 1.2;
        }

        .profile-role {
            font-size: 11px;
            color: #6B7280;
        }

        /* Menu Dropdown ẩn */
        .profile-dropdown {
            display: none;
            position: absolute;
            top: 110%;
            right: 0;
            width: 200px;
            background: #FFFFFF;
            border: 1px solid #E5E7EB;
            border-radius: 6px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            padding: 8px 0;
            z-index: 100;
        }

        .dropdown-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 16px;
            font-size: 13px;
            color: #374151;
            text-decoration: none;
            transition: background 0.2s;
        }

            .dropdown-item:hover {
                background-color: #F9FAFB;
                color: #111827;
            }

            .dropdown-item i {
                width: 16px;
                color: #9CA3AF;
                text-align: center;
            }

        .dropdown-divider {
            height: 1px;
            background-color: #E5E7EB;
            margin: 4px 0;
        }

        .text-danger:hover {
            color: #DC2626 !important;
        }

            .text-danger:hover i {
                color: #DC2626;
            }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="admin-layout-wrapper">

        <aside class="admin-sidebar">
            <div class="sidebar-header">
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="sidebar-brand">
                    PHONE.ST ADMIN
                </a>
            </div>

            <nav class="sidebar-nav">
                <div class="nav-section-title">Tổng quan</div>
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="nav-item">Báo cáo doanh thu</a>

                <div class="nav-section-title">Quản lý bán hàng</div>
                <a asp-area="Admin" asp-controller="Order" asp-action="Index" class="nav-item">Xử lý đơn hàng</a>
                <a asp-area="Admin" asp-controller="Review" asp-action="Index" class="nav-item">Đánh giá khách hàng</a>
                <a asp-area="Admin" asp-controller="Customer" asp-action="Index" class="nav-item">Khách hàng & Thành viên</a>

                <div class="nav-section-title">Kho hàng & Sản phẩm</div>
                <a asp-area="Admin" asp-controller="Product" asp-action="Index" class="nav-item">Danh sách sản phẩm</a>
                <a asp-area="Admin" asp-controller="Inventory" asp-action="Index" class="nav-item">Kiểm soát tồn kho</a>
                <a asp-area="Admin" asp-controller="Supplier" asp-action="Index" class="nav-item">Nhà phân phối</a>

                <div class="nav-section-title">Cấu hình hệ thống</div>
                <a asp-area="Admin" asp-controller="Category" asp-action="Index" class="nav-item">Danh mục sản phẩm</a>
                <a asp-area="Admin" asp-controller="Brand" asp-action="Index" class="nav-item">Thương hiệu phân phối</a>
                <a asp-area="Admin" asp-controller="Shipping" asp-action="Index" class="nav-item">Đơn vị vận chuyển</a>
                <a asp-area="Admin" asp-controller="Campaign" asp-action="Index" class="nav-item">Quản lý Chiến dịch</a>
                <a asp-area="Admin" asp-controller="Promotions" asp-action="Index" class="nav-item">Quản lý Khuyến mãi</a>
                <a asp-area="Admin" asp-controller="Blogs" asp-action="Index" class="nav-item">Quản lý Blogs</a>
            </nav>
        </aside>

        <main class="admin-main-content">

            <header class="admin-header">
                <div class="header-search">
                    <i class="fas fa-search"></i>
                    <input type="text" placeholder="Tìm kiếm đơn hàng, sản phẩm (Phát triển sau)...">
                </div>

                <div class="header-actions">
                    <a asp-area="" asp-controller="Home" asp-action="Index" target="_blank" class="action-btn" title="Xem cửa hàng khách">
                        <i class="fas fa-store"></i>
                    </a>

                    <button class="action-btn" title="Chế độ tối (Phát triển sau)">
                        <i class="fas fa-moon"></i>
                    </button>

                    <button class="action-btn" title="Thông báo hệ thống (Phát triển sau)">
                        <i class="fas fa-bell"></i>
                        <span class="notification-badge"></span>
                    </button>

                    <div class="header-divider"></div>

                    <div class="header-profile" id="userProfileToggle">
                        <img src="https://ui-avatars.com/api/?name=Admin&background=111827&color=fff" alt="Admin Avatar" class="profile-avatar">

                        <div class="profile-info">
                            <span class="profile-name">Quản trị viên</span>
                            <span class="profile-role">Super Admin</span>
                        </div>
                        <i class="fas fa-chevron-down" style="font-size: 10px; color: #9CA3AF; margin-left: 4px;"></i>

                        <div class="profile-dropdown" id="userProfileMenu">
                            <a href="#" class="dropdown-item">
                                <i class="fas fa-id-card"></i> Hồ sơ tài khoản
                            </a>
                            <a href="#" class="dropdown-item">
                                <i class="fas fa-cog"></i> Cài đặt hệ thống
                            </a>
                            <div class="dropdown-divider"></div>
                            <a href="/Home/Index" class="dropdown-item text-danger">
                                <i class="fas fa-sign-out-alt"></i> Đăng xuất
                            </a>
                        </div>
                    </div>
                </div>
            </header>

            <div class="content-wrapper">
                @RenderBody()
            </div>

        </main>
    </div>

    <script>
        // Bật tắt menu dropdown khi click vào avatar
        document.getElementById('userProfileToggle').addEventListener('click', function(e) {
            e.stopPropagation();
            const menu = document.getElementById('userProfileMenu');
            menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
        });

        // Bấm ra ngoài không gian khác thì tự động đóng menu
        document.addEventListener('click', function() {
            const menu = document.getElementById('userProfileMenu');
            if(menu) menu.style.display = 'none';
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>