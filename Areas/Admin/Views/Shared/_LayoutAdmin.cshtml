@using System.Security.Claims
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hệ thống Quản trị</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/admin/admin-root.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/admin-layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/admin-components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/admin.css" asp-append-version="true" />

    <style>
        /* KHÓA CỨNG KHUNG LAYOUT TOÀN MÀN HÌNH */
        .admin-layout-wrapper {
            display: flex;
            width: 100vw;
            height: 100vh;
            overflow: hidden;
            background-color: #F3F4F6;
        }

        /* SIDEBAR CỐ ĐỊNH BÊN TRÁI KHÔNG CUỘN THEO TRANG */
        .admin-sidebar {
            width: 260px;
            background-color: #111827;
            flex-shrink: 0;
            display: flex;
            flex-direction: column;
            height: 100vh;
            overflow-y: auto;
            border-right: 1px solid #1F2937;
        }

        .sidebar-header {
            height: 64px;
            display: flex;
            align-items: center;
            padding: 0 24px;
            border-bottom: 1px solid #1F2937;
            flex-shrink: 0;
        }

        .sidebar-brand {
            color: #FFFFFF;
            font-weight: 800;
            font-size: 16px;
            text-decoration: none;
            letter-spacing: 0.5px;
        }

            .sidebar-brand:hover {
                color: #FFFFFF;
            }

        .sidebar-nav {
            padding: 16px 12px;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .nav-item {
            display: block;
            padding: 10px 16px;
            color: #9CA3AF;
            text-decoration: none;
            font-size: 13px;
            font-weight: 500;
            border-radius: 6px;
            transition: all 0.2s ease;
        }

            .nav-item:hover, .nav-item.active {
                background-color: #1F2937;
                color: #FFFFFF;
            }

        .nav-section-title {
            color: #4B5563;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.75px;
            margin: 18px 0 6px 16px;
        }

        /* KHU VỰC NỘI DUNG CHÍNH CUỘN ĐỘC LẬP */
        .admin-main-content {
            flex: 1;
            display: flex;
            flex-direction: column;
            height: 100vh;
            overflow: hidden;
            position: relative;
        }

        /* HEADER DI DỜI SANG PHẢI KHỚP KHUNG NHÌN */
        .admin-header {
            display: flex;
            justify-content: flex-end;
            align-items: center;
            padding: 0 30px;
            height: 64px;
            background-color: #FFFFFF;
            border-bottom: 1px solid #E5E7EB;
            flex-shrink: 0;
            box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.03);
        }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .action-btn {
            padding: 6px 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 6px;
            color: #4B5563;
            background: transparent;
            border: none;
            cursor: pointer;
            transition: background 0.2s;
            text-decoration: none;
            position: relative;
            font-size: 13px;
        }

            .action-btn:hover {
                background-color: #F3F4F6;
                color: #111827;
            }

        .notification-badge {
            position: absolute;
            top: 2px;
            right: 2px;
            width: 8px;
            height: 8px;
            background-color: #EF4444;
            border-radius: 50%;
            border: 2px solid #FFFFFF;
        }

        .header-divider {
            width: 1px;
            height: 20px;
            background-color: #E5E7EB;
            margin: 0 8px;
        }

        .header-profile {
            display: flex;
            align-items: center;
            gap: 12px;
            cursor: pointer;
            padding: 6px 10px;
            border-radius: 6px;
            transition: background 0.2s;
            position: relative;
            user-select: none;
        }

            .header-profile:hover {
                background-color: #F3F4F6;
            }

        .profile-avatar {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            object-fit: cover;
            border: 1px solid #E5E7EB;
        }

        .profile-info {
            display: flex;
            flex-direction: column;
        }

        .profile-name {
            font-size: 13px;
            font-weight: 600;
            color: #111827;
            line-height: 1.2;
        }

        .profile-role {
            font-size: 11px;
            color: #6B7280;
        }

        .profile-dropdown {
            display: none;
            position: absolute;
            top: calc(100% + 6px);
            right: 0;
            width: 210px;
            background: #FFFFFF;
            border: 1px solid #E5E7EB;
            border-radius: 8px;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
            padding: 6px 0;
            z-index: 110;
        }

        .dropdown-item {
            display: flex;
            align-items: center;
            padding: 10px 16px;
            font-size: 13px;
            color: #374151;
            text-decoration: none;
            transition: background 0.2s;
        }

            .dropdown-item:hover {
                background-color: #F9FAFB;
                color: #111827;
            }

        .dropdown-divider {
            height: 1px;
            background-color: #E5E7EB;
            margin: 6px 0;
        }

        .text-danger:hover {
            color: #DC2626 !important;
        }

        /* KHU VỰC CHỨA VIEW CON TRƯỢT ĐỘC LẬP */
        .content-wrapper {
            flex: 1;
            padding: 30px;
            overflow-y: auto;
            background-color: #F9FAFB;
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="admin-layout-wrapper">

        <aside class="admin-sidebar">
            <div class="sidebar-header">
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="sidebar-brand">
                    KINGPHONE ADMIN
                </a>
            </div>

            <nav class="sidebar-nav">
                <div class="nav-section-title">Tổng quan</div>
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="nav-item">Báo cáo doanh thu</a>

                <div class="nav-section-title">Quản lý bán hàng</div>
                <a asp-area="Admin" asp-controller="Order" asp-action="Index" class="nav-item">Xử lý đơn hàng</a>
                <a asp-area="Admin" asp-controller="Review" asp-action="Index" class="nav-item">Đánh giá khách hàng</a>
                <a asp-area="Admin" asp-controller="Customer" asp-action="Index" class="nav-item">Khách hàng & Thành viên</a>

                <div class="nav-section-title">Kho hàng & Sản phẩm</div>
                <a asp-area="Admin" asp-controller="Product" asp-action="Index" class="nav-item">Danh sách sản phẩm</a>
                <a asp-area="Admin" asp-controller="Inventory" asp-action="Index" class="nav-item">Kiểm soát kho</a>
                <a asp-area="Admin" asp-controller="Supplier" asp-action="Index" class="nav-item">Nhà phân phối</a>

                <div class="nav-section-title">Cấu hình hệ thống</div>
                <a asp-area="Admin" asp-controller="Category" asp-action="Index" class="nav-item">Danh mục sản phẩm</a>
                <a asp-area="Admin" asp-controller="Brand" asp-action="Index" class="nav-item">Thương hiệu phân phối</a>
                <a asp-area="Admin" asp-controller="Shipping" asp-action="Index" class="nav-item">Đơn vị vận chuyển</a>
                <a asp-area="Admin" asp-controller="Campaign" asp-action="Index" class="nav-item">Quản lý Chiến dịch</a>
                <a asp-area="Admin" asp-controller="Promotions" asp-action="Index" class="nav-item">Quản lý Khuyến mãi</a>
                <a asp-area="Admin" asp-controller="CrossSell" asp-action="Index" class="nav-item">Gợi ý mua kèm</a>
                <a asp-area="Admin" asp-controller="FlashSale" asp-action="Index" class="nav-item">
                    Giờ Vàng
                </a>
                <a asp-area="Admin" asp-controller="Blogs" asp-action="Index" class="nav-item">Quản lý Blogs</a>
            </nav>
        </aside>

        <main class="admin-main-content">

            <header class="admin-header">
                <div class="header-actions">
                    <a asp-area="" asp-controller="Home" asp-action="Index" target="_blank" class="action-btn" title="Xem cửa hàng khách">
                        Xem cửa hàng
                    </a>

                    <button type="button" class="action-btn" title="Chế độ tối (Phát triển sau)">
                        Chế độ tối
                    </button>

                    <button type="button" class="action-btn" title="Thông báo hệ thống (Phát triển sau)">
                        Thông báo
                        <span class="notification-badge"></span>
                    </button>

                    <div class="header-divider"></div>

                    <div class="header-profile" id="userProfileToggle">
                        <img src="https://ui-avatars.com/api/?name=Admin&background=111827&color=fff" alt="Admin Avatar" class="profile-avatar">

                        <div class="profile-info">
                            <span class="profile-name">Quản trị viên</span>
                            <span class="profile-role">Super Admin</span>
                        </div>

                        <div class="profile-dropdown" id="userProfileMenu">
                            <a href="#" class="dropdown-item">Hồ sơ tài khoản</a>
                            <a href="#" class="dropdown-item">Cài đặt hệ thống</a>
                            <div class="dropdown-divider"></div>
                            <form action="/Auth/Logout" method="post" style="margin:0;">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item text-danger" style="border:none; background:transparent; width:100%; text-align:left; font-weight: 600;">
                                    Đăng xuất
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </header>

            <div class="content-wrapper">
                @RenderBody()
            </div>

        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Bật tắt menu dropdown khi click vào profile
        document.getElementById('userProfileToggle').addEventListener('click', function(e) {
            e.stopPropagation();
            const menu = document.getElementById('userProfileMenu');
            menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
        });

        // Bấm ra ngoài vùng menu thì tự động đóng lại ẩn đi
        document.addEventListener('click', function() {
            const menu = document.getElementById('userProfileMenu');
            if(menu) menu.style.display = 'none';
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
