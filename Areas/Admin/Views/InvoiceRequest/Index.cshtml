@using TMDT_LT.Models
@model System.Collections.Generic.IReadOnlyList<TMDT_LT.Models.OrderInvoiceRequests>
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Yêu cầu hóa đơn";
    string currentStatus = ViewBag.Status as string ?? string.Empty;
    string search = ViewBag.Search as string ?? string.Empty;

    string FriendlyStatus(string status) => status switch
    {
        InvoiceRequestStatuses.Issued => "Đã phát hành",
        InvoiceRequestStatuses.Rejected => "Đã từ chối",
        InvoiceRequestStatuses.Cancelled => "Đã hủy",
        _ => "Chờ xử lý"
    };

    string FriendlyBuyerType(string buyerType) =>
        buyerType == InvoiceBuyerTypes.Organization
            ? "Tổ chức"
            : "Cá nhân";
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">Yêu cầu xuất hóa đơn</h1>
            <p class="text-secondary mb-0">
                Dữ liệu người mua được snapshot tại lúc checkout.
            </p>
        </div>
        <span class="badge text-bg-dark px-3 py-2">
            @Model.Count yêu cầu
        </span>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <form method="get"
          class="card card-body border-0 shadow-sm mb-4">
        <div class="row g-3 align-items-end">
            <div class="col-md-5">
                <label class="form-label fw-semibold">
                    Tìm theo mã đơn, người mua, MST hoặc email
                </label>
                <input type="text"
                       name="search"
                       value="@search"
                       class="form-control"
                       placeholder="Ví dụ: 1024 hoặc company@email.com" />
            </div>
            <div class="col-md-4">
                <label class="form-label fw-semibold">Trạng thái</label>
                <select name="status" class="form-select">
                    <option value="">Tất cả</option>
                    @if (currentStatus == InvoiceRequestStatuses.Pending)
                    {
                        <option value="@InvoiceRequestStatuses.Pending" selected>
                            Chờ xử lý
                        </option>
                    }
                    else
                    {
                        <option value="@InvoiceRequestStatuses.Pending">
                            Chờ xử lý
                        </option>
                    }

                    @if (currentStatus == InvoiceRequestStatuses.Issued)
                    {
                        <option value="@InvoiceRequestStatuses.Issued" selected>
                            Đã phát hành
                        </option>
                    }
                    else
                    {
                        <option value="@InvoiceRequestStatuses.Issued">
                            Đã phát hành
                        </option>
                    }

                    @if (currentStatus == InvoiceRequestStatuses.Rejected)
                    {
                        <option value="@InvoiceRequestStatuses.Rejected" selected>
                            Đã từ chối
                        </option>
                    }
                    else
                    {
                        <option value="@InvoiceRequestStatuses.Rejected">
                            Đã từ chối
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button class="btn btn-dark flex-grow-1" type="submit">
                    Lọc
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    Xóa lọc
                </a>
            </div>
        </div>
    </form>

    <div class="card border-0 shadow-sm overflow-hidden">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Đơn hàng</th>
                        <th>Người mua</th>
                        <th>Thông tin nhận hóa đơn</th>
                        <th>Trạng thái</th>
                        <th style="min-width:320px;">Xử lý</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="5"
                                class="text-center text-secondary py-5">
                                Không có yêu cầu phù hợp.
                            </td>
                        </tr>
                    }

                    @foreach (var request in Model)
                    {
                        <tr>
                            <td>
                                <a asp-area="Admin"
                                   asp-controller="Order"
                                   asp-action="Details"
                                   asp-route-id="@request.OrderId"
                                   class="fw-bold text-decoration-none">
                                    #@request.OrderId
                                </a>
                                <div class="small text-secondary">
                                    @request.RequestedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                </div>
                            </td>
                            <td>
                                <div class="fw-semibold">@request.BuyerName</div>
                                <div class="small text-secondary">
                                    @FriendlyBuyerType(request.BuyerType)
                                </div>
                                @if (!string.IsNullOrWhiteSpace(request.TaxCode))
                                {
                                    <div class="small">
                                        MST: <strong>@request.TaxCode</strong>
                                    </div>
                                }
                            </td>
                            <td>
                                <div>@request.BuyerEmail</div>
                                @if (!string.IsNullOrWhiteSpace(request.BuyerPhone))
                                {
                                    <div class="small text-secondary">
                                        @request.BuyerPhone
                                    </div>
                                }
                                <div class="small text-secondary mt-1">
                                    @request.BuyerAddress
                                </div>
                            </td>
                            <td>
                                <span class="badge @(request.Status == InvoiceRequestStatuses.Issued ? "text-bg-success" : request.Status == InvoiceRequestStatuses.Rejected ? "text-bg-danger" : "text-bg-warning")">
                                    @FriendlyStatus(request.Status)
                                </span>
                                @if (!string.IsNullOrWhiteSpace(request.InvoiceNumber))
                                {
                                    <div class="small mt-2">
                                        Số: <strong>@request.InvoiceNumber</strong>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(request.AdminNote))
                                {
                                    <div class="small text-danger mt-1">
                                        @request.AdminNote
                                    </div>
                                }
                            </td>
                            <td>
                                @if (request.Status == InvoiceRequestStatuses.Pending)
                                {
                                    <form asp-action="MarkIssued"
                                          method="post"
                                          class="row g-2 mb-2">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden"
                                               name="id"
                                               value="@request.InvoiceRequestId" />
                                        <div class="col-6">
                                            <input name="invoiceNumber"
                                                   class="form-control form-control-sm"
                                                   maxlength="100"
                                                   placeholder="Số / ký hiệu hóa đơn"
                                                   required />
                                        </div>
                                        <div class="col-6">
                                            <input name="invoiceLookupCode"
                                                   class="form-control form-control-sm"
                                                   maxlength="200"
                                                   placeholder="Mã tra cứu (nếu có)" />
                                        </div>
                                        <div class="col-12">
                                            <button class="btn btn-success btn-sm w-100"
                                                    type="submit">
                                                Xác nhận đã phát hành
                                            </button>
                                        </div>
                                    </form>

                                    <form asp-action="Reject"
                                          method="post"
                                          class="d-flex gap-2">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden"
                                               name="id"
                                               value="@request.InvoiceRequestId" />
                                        <input name="adminNote"
                                               class="form-control form-control-sm"
                                               maxlength="500"
                                               placeholder="Lý do từ chối"
                                               required />
                                        <button class="btn btn-outline-danger btn-sm"
                                                type="submit">
                                            Từ chối
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <div class="small text-secondary">
                                        Xử lý lúc:
                                        @(request.ReviewedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")
                                    </div>
                                    <div class="small text-secondary">
                                        Bởi: @(request.ReviewedBy ?? "Admin")
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="alert alert-info mt-4 mb-0 small">
        Module này chỉ quản lý yêu cầu và snapshot dữ liệu người mua.
        Việc phát hành hóa đơn điện tử thật phải được thực hiện qua nhà cung cấp
        hoặc hệ thống kế toán được cấu hình riêng.
    </div>
</div>
