@model System.Collections.Generic.IReadOnlyList<TMDT_LT.Services.ReturnInspectionQueueItem>
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Kiểm định hàng trả";

    string DecisionText(string? decision) => decision switch
    {
        TMDT_LT.Models.ReturnInspectionDecisions.FullRefund =>
            "Đủ điều kiện hoàn toàn bộ",
        TMDT_LT.Models.ReturnInspectionDecisions.Reject =>
            "Từ chối",
        TMDT_LT.Models.ReturnInspectionDecisions.ManualReview =>
            "Cần đối soát thủ công",
        _ => "Chưa kiểm định"
    };
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">Kiểm định hàng trả</h1>
            <p class="text-secondary mb-0">
                Kiểm tra từng dòng sản phẩm trước khi cho phép hoàn tiền.
            </p>
        </div>
        <span class="badge text-bg-dark px-3 py-2">
            @Model.Count hồ sơ
        </span>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Warning"] != null)
    {
        <div class="alert alert-warning">@TempData["Warning"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card border-0 shadow-sm overflow-hidden">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Hồ sơ</th>
                        <th>Khách hàng</th>
                        <th>Trạng thái trả hàng</th>
                        <th>Kết quả kiểm định</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="5"
                                class="text-center text-secondary py-5">
                                Không có hồ sơ kiểm định.
                            </td>
                        </tr>
                    }

                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <strong>#RET-@item.ReturnId</strong>
                                <div class="small text-secondary">
                                    Đơn #@item.OrderId
                                </div>
                                <div class="small text-secondary">
                                    @item.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                </div>
                            </td>
                            <td>@item.CustomerName</td>
                            <td>
                                <span class="badge text-bg-warning">
                                    @item.ReturnStatus
                                </span>
                            </td>
                            <td>
                                <div class="fw-semibold">
                                    @DecisionText(item.Decision)
                                </div>
                                @if (item.EligibleRefundAmount.HasValue)
                                {
                                    <div class="small text-secondary">
                                        Đủ điều kiện:
                                        @(string.Format(
                                            "{0:N0} đ",
                                            item.EligibleRefundAmount.Value))
                                    </div>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Details"
                                   asp-route-returnId="@item.ReturnId"
                                   class="btn btn-sm @(item.IsFinalized ? "btn-outline-dark" : "btn-dark")">
                                    @(item.IsFinalized
                                        ? "Xem kết quả"
                                        : "Bắt đầu kiểm định")
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
