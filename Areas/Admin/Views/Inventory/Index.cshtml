@model IEnumerable<TMDT_LT.Models.ProductVariants>
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Quản lý Tồn kho";
}

<div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 25px;">
    <div>
        <h2 style="margin-bottom: 5px;">Kiểm soát Kho hàng</h2>
        <p style="color: #6B7280; font-size: 14px;">Giám sát số lượng tồn kho thực tế và truy xuất lịch sử xuất/nhập.</p>
    </div>
    <div style="display: flex; gap: 10px;">
        <a asp-action="POHistory" class="btn-outline" style="display: inline-flex; align-items: center; gap: 4px;">
            <svg class="svg-icon" viewBox="0 0 24 24" style="width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
            Nhật ký nhập kho
        </a>
        <a asp-action="CreatePO" class="btn-dark" style="display: inline-flex; align-items: center; gap: 4px;">
            <svg class="svg-icon" viewBox="0 0 24 24" style="width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round;"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            Tạo Phiếu Nhập Kho
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div style="background: #D1FAE5; color: #059669; padding: 15px; border-radius: 8px; margin-bottom: 20px; border: 1px solid #A7F3D0;">
        ✓ @TempData["Success"]
    </div>
}

<div class="admin-card" style="padding: 0;">
    <table class="data-table">
        <thead>
            <tr>
                <th style="width: 10%;">Mã SKU</th>
                <th style="width: 35%;">Sản phẩm (Phân loại)</th>
                <th style="width: 15%; text-align: center;">Tồn kho thực tế</th>
                <th style="width: 20%; text-align: right;">Giá bán tham khảo</th>
                <th style="width: 20%; text-align: center;">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="5" style="text-align:center; padding: 40px; color: #9CA3AF;">Hệ thống chưa có sản phẩm nào.</td></tr>
            }
            @foreach (var item in Model)
            {
                <tr>
                    <td style="color: #6B7280; font-weight: 500; font-family: monospace;">#@item.VariantId</td>
                    <td>
                        <strong style="color: var(--admin-text-dark); font-size: 14px;">@item.Product?.Name</strong>
                        <div style="font-size: 12px; color: #6B7280; margin-top: 4px;">
                            Bộ nhớ: @item.Storage / @item.Ram | Màu sắc: @item.Color
                        </div>
                    </td>
                    <td style="text-align: center;">
                        @if (item.Stock == 0)
                        {
                            <span style="background: #FEE2E2; color: #DC2626; padding: 4px 12px; border-radius: 20px; font-weight: 700; font-size: 13px;">Hết hàng</span>
                        }
                        else if (item.Stock < 5)
                        {
                            <span style="background: #FEF3C7; color: #D97706; padding: 4px 12px; border-radius: 20px; font-weight: 700; font-size: 13px;">@item.Stock ⚠️ (Sắp hết)</span>
                        }
                        else
                        {
                            <span style="background: #D1FAE5; color: #059669; padding: 4px 12px; border-radius: 20px; font-weight: 700; font-size: 13px;">@item.Stock</span>
                        }
                    </td>
                    <td style="text-align: right; font-weight: 600; color: var(--admin-text-dark);">
                        @string.Format("{0:N0}", item.Price) đ
                    </td>
                    <td style="text-align: center;">
                        <a asp-action="History" asp-route-id="@item.VariantId" class="btn-outline" style="font-size: 12px; padding: 6px 12px; display: inline-flex; align-items: center; gap: 4px;">
                            <svg class="svg-icon" viewBox="0 0 24 24" style="width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                            Xem Thẻ kho
                        </a>
                        <button onclick="openAdjustModal(@item.VariantId, '@item.Product?.Name', '@item.Storage / @item.Color', @(item.Stock ?? 0))" class="btn-outline" style="font-size: 12px; padding: 6px 12px; display: inline-flex; align-items: center; gap: 4px; margin-left: 5px;">
                            <svg class="svg-icon" viewBox="0 0 24 24" style="width: 14px; height: 14px;"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
                            Kiểm kê
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div id="adjustModal" class="modal-overlay" onclick="closeAdjustModal(event)">
    <div class="modal-content" style="max-width: 450px;" onclick="event.stopPropagation()">
        <div class="modal-header">
            <h3 class="modal-title">Phiếu Điều Chỉnh / Kiểm Kê</h3>
            <button onclick="closeAdjustModal()" class="btn-close">
                <svg class="svg-icon" viewBox="0 0 24 24" style="width: 18px; height: 18px;"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            </button>
        </div>
        <div class="modal-body">
            <div style="background: #F3F4F6; padding: 12px; border-radius: 6px; margin-bottom: 20px;">
                <strong id="adjProductName" style="display: block; color: var(--admin-text-dark); font-size: 14px;">-</strong>
                <span id="adjProductDesc" style="color: #6B7280; font-size: 12px;">-</span>
            </div>

            <input type="hidden" id="adjVariantId" />

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 15px;">
                <div>
                    <label class="form-label" style="color: #6B7280;">Tồn trên phần mềm</label>
                    <input type="number" id="adjCurrentStock" class="form-control" readonly style="background: #F9FAFB; font-weight: 700; color: #9CA3AF;" />
                </div>
                <div>
                    <label class="form-label">Tồn đếm được</label>
                    <input type="number" id="adjActualStock" class="form-control" min="0" style="font-weight: 700; color: var(--admin-text-dark); border-color: #111827;" oninput="calcDiff()" />
                </div>
            </div>

            <div style="margin-bottom: 15px; font-size: 13px;">
                Độ lệch so với sổ sách: <strong id="adjDiff" style="font-family: monospace; font-size: 15px;">0</strong> máy
            </div>

            <div class="form-row">
                <label class="form-label">Nguyên nhân / Lý do điều chỉnh (*)</label>
                <textarea id="adjNote" class="form-control" style="height: 60px;" placeholder="VD: Khách làm xước rớt 1 máy, Cập nhật do kiểm kê tháng 10..."></textarea>
            </div>
        </div>
        <div class="modal-footer">
            <button onclick="closeAdjustModal()" class="btn-outline">Hủy bỏ</button>
            <button onclick="submitAdjustment()" class="btn-dark" style="background: #111827;">LƯU ĐIỀU CHỈNH KHO</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Khai báo biến modal
        function openAdjustModal(id, name, desc, currentStock) {
            document.getElementById('adjVariantId').value = id;
            document.getElementById('adjProductName').innerText = name;
            document.getElementById('adjProductDesc').innerText = desc;
            document.getElementById('adjCurrentStock').value = currentStock;
            document.getElementById('adjActualStock').value = currentStock;
            document.getElementById('adjNote').value = '';
            calcDiff();

            document.getElementById('adjustModal').style.display = 'flex';
        }

        function closeAdjustModal(e) {
            document.getElementById('adjustModal').style.display = 'none';
        }

        function calcDiff() {
            const current = parseInt(document.getElementById('adjCurrentStock').value) || 0;
            const actual = parseInt(document.getElementById('adjActualStock').value) || 0;
            const diff = actual - current;

            const diffEl = document.getElementById('adjDiff');
            if(diff > 0) { diffEl.innerText = "+" + diff; diffEl.style.color = "#059669"; }
            else if(diff < 0) { diffEl.innerText = diff; diffEl.style.color = "#DC2626"; }
            else { diffEl.innerText = "0"; diffEl.style.color = "#111827"; }
        }

        async function submitAdjustment() {
            const variantId = document.getElementById('adjVariantId').value;
            const actualStock = document.getElementById('adjActualStock').value;
            const note = document.getElementById('adjNote').value;

            if(!note) { alert("Vui lòng ghi rõ nguyên nhân để lưu vào thẻ kho!"); return; }
            if(!confirm("Hệ thống sẽ cập nhật lại số lượng tồn kho và ghi nhật ký kiểm toán. Bạn có chắc chắn?")) return;

            try {
                const res = await fetch('/Admin/Inventory/AdjustStock', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: new URLSearchParams({ variantId: variantId, actualStock: actualStock, note: note })
                });
                const data = await res.json();

                if(data.success) {
                    alert("Đã cân bằng kho thành công!");
                    location.reload(); // Tải lại để cập nhật bảng
                } else { alert("Lỗi: " + data.message); }
            } catch(e) { alert("Lỗi kết nối."); }
        }
    </script>
}