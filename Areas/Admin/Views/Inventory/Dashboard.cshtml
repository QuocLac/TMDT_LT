@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Tổng quan kho";
    ViewData["InventorySection"] = "Overview";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/inventory.css" asp-append-version="true" />
}

<div class="inventory-page" id="inventoryDashboardApp">
    @await Html.PartialAsync("~/Areas/Admin/Views/Inventory/_InventoryNavigation.cshtml")

    <header class="inventory-page-head">
        <div>
            <h1>Tổng quan kho</h1>
            <p>Theo dõi lượng hàng, giá trị tồn, tiền nhập và kết quả bán hàng trong cùng một màn hình.</p>
        </div>
        <div class="inventory-head-actions">
            <a class="inventory-button inventory-button-secondary" href="/Admin/Inventory/Receiving">Tạo phiếu nhập</a>
            <a class="inventory-button inventory-button-primary" href="/Admin/Inventory/Operations">Mở hoạt động kho</a>
        </div>
    </header>

    <section class="inventory-filter-card" aria-label="Bộ lọc tổng quan kho">
        <label class="inventory-field inventory-field-wide">
            <span>Kho</span>
            <select id="warehouseFilter">
                <option value="">Đang tải danh sách kho...</option>
            </select>
            <small id="warehouseMeta"></small>
        </label>
        <label class="inventory-field">
            <span>Từ ngày</span>
            <input id="fromDateFilter" type="date" />
        </label>
        <label class="inventory-field">
            <span>Đến ngày</span>
            <input id="toDateFilter" type="date" />
        </label>
        <button class="inventory-button inventory-button-primary" type="button" id="applyOverviewFilterButton">Cập nhật</button>
    </section>

    <section class="inventory-highlight-grid" aria-label="Chỉ số chính">
        <article class="inventory-highlight inventory-highlight-dark">
            <span>Tiền thực thu trong kỳ</span>
            <strong id="actualCashReceived">—</strong>
            <small>Tiền thanh toán thành công sau khi trừ khoản đã hoàn</small>
        </article>
        <article class="inventory-highlight">
            <span>Giá trị hàng trong kho</span>
            <strong id="totalInventoryValue">—</strong>
            <small>Tính theo giá vốn của lượng hàng còn lại</small>
        </article>
        <article class="inventory-highlight">
            <span>Lợi nhuận tạm tính</span>
            <strong id="tentativeProfit">—</strong>
            <small>Đã trừ giá vốn và các khoản chi hiện có</small>
        </article>
    </section>

    <section class="inventory-kpi-grid" aria-label="Tình hình kho">
        <article class="inventory-kpi"><span>Có thể bán</span><strong id="totalAvailable">—</strong><small>Sau khi trừ hàng đang giữ cho đơn</small></article>
        <article class="inventory-kpi"><span>Tiền nhập trong kỳ</span><strong id="inboundSpend">—</strong><small>Tổng phải trả cho các phiếu nhập</small></article>
        <article class="inventory-kpi"><span>Giá vốn đã xuất</span><strong id="soldStockCost">—</strong><small>Giá vốn của hàng đã bán và phân phối</small></article>
        <article class="inventory-kpi"><span>Chưa thu</span><strong id="outstandingAmount">—</strong><small>Giá trị đơn hàng còn chờ thanh toán</small></article>
        <article class="inventory-kpi"><span>Sắp hết hàng</span><strong id="lowStockCount">—</strong><small>Mặt hàng còn tối đa 5 sản phẩm</small></article>
        <article class="inventory-kpi"><span>Tồn lâu</span><strong id="agedStockCount">—</strong><small>Mặt hàng có lô cũ trên 90 ngày</small></article>
    </section>

    <p class="inventory-note" id="financeScopeNote"></p>

    <section class="inventory-grid inventory-grid-main">
        <article class="inventory-panel">
            <div class="inventory-panel-head">
                <div><h2>Nhập và xuất hàng</h2><p>Số lượng phát sinh theo ngày trong khoảng đã chọn.</p></div>
            </div>
            <div class="inventory-chart"><canvas id="stockMovementChart"></canvas></div>
        </article>
        <article class="inventory-panel">
            <div class="inventory-panel-head">
                <div><h2>Giá trị tồn theo kho</h2><p>So sánh lượng vốn đang nằm tại từng kho.</p></div>
            </div>
            <div class="inventory-chart"><canvas id="warehouseValueChart"></canvas></div>
        </article>
    </section>

    <section class="inventory-grid inventory-grid-main">
        <article class="inventory-panel">
            <div class="inventory-panel-head">
                <div><h2>Sản phẩm nổi bật</h2><p>Xếp theo số lượng đã bán và phân phối trong kỳ.</p></div>
            </div>
            <div class="inventory-table-wrap">
                <table class="inventory-table">
                    <thead><tr><th>Sản phẩm</th><th class="is-number">Đã xuất</th><th class="is-number">Doanh thu</th><th class="is-number">Lợi nhuận</th></tr></thead>
                    <tbody id="topProductTableBody"></tbody>
                </table>
            </div>
        </article>
        <article class="inventory-panel">
            <div class="inventory-panel-head">
                <div><h2>Cần chú ý</h2><p>Các mặt hàng sắp hết hoặc nằm trong kho quá lâu.</p></div>
            </div>
            <div class="inventory-attention-tabs">
                <button class="inventory-tab is-active" type="button" data-attention-tab="low">Sắp hết</button>
                <button class="inventory-tab" type="button" data-attention-tab="aged">Tồn lâu</button>
            </div>
            <div class="inventory-attention-list" id="lowStockList"></div>
            <div class="inventory-attention-list" id="agedStockList" hidden></div>
        </article>
    </section>

    <section class="inventory-panel">
        <div class="inventory-panel-head inventory-panel-head-toolbar">
            <div><h2>Tồn kho theo sản phẩm</h2><p id="stockResultMeta">Đang tải dữ liệu...</p></div>
            <div class="inventory-stock-filters">
                <input id="stockSearch" type="search" placeholder="Tìm tên sản phẩm hoặc biến thể" autocomplete="off" />
                <select id="stockScopeFilter">
                    <option value="all">Tất cả</option>
                    <option value="available">Còn hàng</option>
                    <option value="low">Sắp hết</option>
                    <option value="out">Hết hàng</option>
                </select>
            </div>
        </div>
        <div class="inventory-table-wrap">
            <table class="inventory-table inventory-stock-table">
                <thead>
                    <tr>
                        <th>Sản phẩm</th>
                        <th class="is-number">Tồn thực tế</th>
                        <th class="is-number">Đang giữ</th>
                        <th class="is-number">Có thể bán</th>
                        <th class="is-number">Giá vốn trung bình</th>
                        <th class="is-number">Giá trị tồn</th>
                        <th>Trạng thái</th>
                    </tr>
                </thead>
                <tbody id="stockTableBody"></tbody>
            </table>
        </div>
        <div class="inventory-pagination">
            <span id="pageIndicator">Trang 1 / 1</span>
            <div>
                <button type="button" id="previousPageButton">Trang trước</button>
                <button type="button" id="nextPageButton">Trang sau</button>
            </div>
        </div>
    </section>

    <section class="inventory-panel">
        <div class="inventory-panel-head">
            <div><h2>Hoạt động gần đây</h2><p>Những thay đổi mới nhất tại kho đang chọn.</p></div>
        </div>
        <div class="inventory-table-wrap">
            <table class="inventory-table">
                <thead><tr><th>Thời gian</th><th>Sản phẩm</th><th>Hoạt động</th><th class="is-number">Số lượng</th><th>Ghi chú</th></tr></thead>
                <tbody id="recentActivityTableBody"></tbody>
            </table>
        </div>
    </section>
</div>

<div class="inventory-toast-stack" id="inventoryToastStack" aria-live="polite"></div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/admin/inventory-dashboard.js" asp-append-version="true"></script>
}
