@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Nhận hàng vào kho";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/inventory-receiving-phase-d.css" asp-append-version="true" />
}

<div class="ir-page" id="inventoryReceivingApp">
    @Html.AntiForgeryToken()

    <header class="ir-page-header">
        <div>
            <a class="ir-back-link" asp-area="Admin" asp-controller="Inventory" asp-action="Index">
                <i class="fa-solid fa-arrow-left"></i>
                Kiểm soát tồn kho
            </a>
            <div class="ir-title-row">
                <div>
                    <p class="ir-eyebrow">INBOUND RECEIVING · PHASE D1</p>
                    <h1>Nhận hàng từ nhà cung cấp</h1>
                    <p class="ir-subtitle">
                        Chọn kho nhận, đối chiếu chứng từ và xem trước landed cost trước khi cập nhật tồn theo lô.
                    </p>
                </div>
                <div class="ir-header-status" id="systemStatus">
                    <span class="ir-status-dot"></span>
                    Đang kết nối dữ liệu kho
                </div>
            </div>
        </div>
    </header>

    <div class="ir-alert ir-alert-warning" id="pageWarning" hidden></div>

    <section class="ir-context-grid">
        <article class="ir-panel ir-document-panel">
            <div class="ir-panel-heading">
                <div>
                    <span class="ir-step">01</span>
                    <h2>Thông tin nhận hàng</h2>
                </div>
                <span class="ir-required-note">* Bắt buộc</span>
            </div>

            <div class="ir-form-grid">
                <label class="ir-field ir-field-span-2">
                    <span>Nhà cung cấp *</span>
                    <select id="supplierId">
                        <option value="">Đang tải nhà cung cấp...</option>
                    </select>
                    <small id="supplierMeta">Chọn đúng pháp nhân phát hành chứng từ.</small>
                </label>

                <label class="ir-field ir-field-span-2">
                    <span>Kho nhận *</span>
                    <select id="warehouseId">
                        <option value="">Đang tải kho...</option>
                    </select>
                    <small id="warehouseMeta">Tồn hiển thị theo kho đang chọn.</small>
                </label>

                <label class="ir-field">
                    <span>Số hóa đơn / chứng từ NCC *</span>
                    <input id="invoiceNumber" type="text" maxlength="100" autocomplete="off"
                           placeholder="VD: INV-2026-000128" />
                </label>

                <label class="ir-field">
                    <span>Ngày chứng từ *</span>
                    <input id="invoiceDate" type="date" />
                </label>

                <label class="ir-field">
                    <span>Ngày nhận hàng *</span>
                    <input id="receivedDate" type="date" />
                </label>

                <label class="ir-field ir-checkbox-field">
                    <input id="inputVatDeductible" type="checkbox" checked />
                    <span>
                        <strong>VAT đầu vào được khấu trừ</strong>
                        <small>VAT vẫn thuộc công nợ NCC nhưng không cộng vào giá vốn tồn kho.</small>
                    </span>
                </label>

                <label class="ir-field ir-field-span-2">
                    <span>Ghi chú nội bộ</span>
                    <textarea id="receiptNote" rows="3"
                              placeholder="Tình trạng kiện hàng, người giao, biên bản kèm theo..."></textarea>
                </label>
            </div>
        </article>

        <aside class="ir-panel ir-recent-panel">
            <div class="ir-panel-heading">
                <div>
                    <span class="ir-step">LIVE</span>
                    <h2>Phiếu nhập gần đây</h2>
                </div>
                <button type="button" class="ir-icon-button" id="reloadRecentButton" title="Tải lại">
                    <i class="fa-solid fa-rotate"></i>
                </button>
            </div>
            <div class="ir-recent-list" id="recentReceiptList">
                <div class="ir-skeleton ir-skeleton-block"></div>
                <div class="ir-skeleton ir-skeleton-block"></div>
                <div class="ir-skeleton ir-skeleton-block"></div>
            </div>
        </aside>
    </section>

    <section class="ir-panel ir-catalog-panel">
        <div class="ir-panel-heading ir-catalog-heading">
            <div>
                <span class="ir-step">02</span>
                <h2>Chọn biến thể nhận kho</h2>
                <p>Sản phẩm được tải theo trang để tránh treo giao diện khi danh mục lớn.</p>
            </div>
            <div class="ir-result-count" id="productResultCount">0 biến thể</div>
        </div>

        <div class="ir-toolbar">
            <div class="ir-search-box">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input id="productSearch" type="search"
                       placeholder="Tên sản phẩm, biến thể, thương hiệu hoặc mã SKU..." />
            </div>
            <select id="categoryFilter" aria-label="Lọc danh mục">
                <option value="">Tất cả danh mục</option>
            </select>
            <select id="brandFilter" aria-label="Lọc thương hiệu">
                <option value="">Tất cả thương hiệu</option>
            </select>
            <select id="stockFilter" aria-label="Lọc tồn kho">
                <option value="all">Mọi trạng thái tồn</option>
                <option value="available">Đang có tồn</option>
                <option value="low">Sắp hết (1–5)</option>
                <option value="out">Hết hàng</option>
            </select>
            <button type="button" class="ir-secondary-button" id="resetFilterButton">
                Xóa lọc
            </button>
        </div>

        <div class="ir-product-grid" id="productGrid" aria-live="polite"></div>

        <div class="ir-pagination">
            <button type="button" class="ir-secondary-button" id="previousPageButton">
                <i class="fa-solid fa-chevron-left"></i>
                Trang trước
            </button>
            <span id="pageIndicator">Trang 1 / 1</span>
            <button type="button" class="ir-secondary-button" id="nextPageButton">
                Trang sau
                <i class="fa-solid fa-chevron-right"></i>
            </button>
        </div>
    </section>

    <section class="ir-receipt-layout">
        <article class="ir-panel ir-lines-panel">
            <div class="ir-panel-heading">
                <div>
                    <span class="ir-step">03</span>
                    <h2>Chi tiết hàng nhận</h2>
                    <p id="selectedLineCount">Chưa chọn mặt hàng</p>
                </div>
                <button type="button" class="ir-danger-text-button" id="clearLinesButton">
                    Xóa toàn bộ
                </button>
            </div>

            <div class="ir-table-wrap">
                <table class="ir-lines-table">
                    <thead>
                        <tr>
                            <th>Sản phẩm / SKU</th>
                            <th>Số lượng</th>
                            <th>Giá nhập chưa VAT</th>
                            <th>VAT</th>
                            <th>Tiền hàng</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="receiptLineBody"></tbody>
                </table>
            </div>
        </article>

        <aside class="ir-panel ir-summary-panel">
            <div class="ir-panel-heading">
                <div>
                    <span class="ir-step">04</span>
                    <h2>Đối chiếu & ghi nhận</h2>
                </div>
            </div>

            <div class="ir-cost-fields">
                <label class="ir-field">
                    <span>Phí vận chuyển đầu vào</span>
                    <input id="shippingFee" type="number" min="0" step="1000" value="0" />
                </label>
                <label class="ir-field">
                    <span>Chi phí khác</span>
                    <input id="otherFee" type="number" min="0" step="1000" value="0" />
                </label>
            </div>

            <div class="ir-summary-list">
                <div><span>Tiền hàng</span><strong id="goodsSubtotal">0 đ</strong></div>
                <div><span>VAT đầu vào</span><strong id="inputVatAmount">0 đ</strong></div>
                <div><span>Phí nhập phân bổ</span><strong id="allocatedFeeTotal">0 đ</strong></div>
                <div class="ir-summary-emphasis"><span>Phải trả nhà cung cấp</span><strong id="supplierPayable">0 đ</strong></div>
                <div class="ir-summary-capitalized"><span>Giá trị vốn hóa tồn kho</span><strong id="capitalizedCost">0 đ</strong></div>
            </div>

            <div class="ir-preview-state" id="previewState">
                Thêm sản phẩm để xem trước landed cost.
            </div>
            <div class="ir-warning-list" id="previewWarnings"></div>

            <button type="button" class="ir-primary-button" id="previewButton">
                <i class="fa-solid fa-calculator"></i>
                Kiểm tra & xem trước
            </button>
            <button type="button" class="ir-submit-button" id="submitButton" disabled>
                <i class="fa-solid fa-boxes-stacked"></i>
                Xác nhận nhận hàng vào kho
            </button>

            <p class="ir-submit-note">
                Thao tác này tạo PO, lô tồn, mã định danh nội bộ và bút toán nhập kho trong một transaction.
            </p>
        </aside>
    </section>
</div>

<div class="ir-modal" id="resultModal" hidden>
    <div class="ir-modal-card" role="dialog" aria-modal="true" aria-labelledby="resultModalTitle">
        <div class="ir-modal-icon"><i class="fa-solid fa-check"></i></div>
        <h2 id="resultModalTitle">Nhận hàng thành công</h2>
        <p id="resultModalMessage"></p>
        <div class="ir-modal-detail" id="resultModalDetail"></div>
        <div class="ir-modal-actions">
            <button type="button" class="ir-secondary-button" id="createAnotherButton">Tạo phiếu khác</button>
            <a class="ir-primary-button" asp-area="Admin" asp-controller="Inventory" asp-action="Index">Về kiểm soát kho</a>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin/inventory-receiving-phase-d.js" asp-append-version="true"></script>
}
