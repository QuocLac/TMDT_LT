@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Xuất kho phân phối";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/inventory-distribution-phase-d3.css" asp-append-version="true" />
}

@Html.AntiForgeryToken()

<div class="id-page" id="inventoryDistributionApp">
    <header class="id-header">
        <div>
            <div class="id-eyebrow">FIFO DISTRIBUTION · PHASE D3</div>
            <h1>Xuất kho phân phối</h1>
            <p>Chọn đúng kho nguồn, bảo vệ reservation, preview giá vốn FIFO và lợi nhuận trước khi ghi sổ.</p>
        </div>
        <nav class="id-header-actions">
            <a class="id-button id-button-light" href="/Admin/Inventory"><i class="fa-solid fa-chart-column"></i> Kiểm soát tồn</a>
            <a class="id-button id-button-light" href="/Admin/Inventory/Operations"><i class="fa-solid fa-right-left"></i> Vận hành kho</a>
            <a class="id-button id-button-light" href="/Admin/Inventory/CreatePO"><i class="fa-solid fa-truck-ramp-box"></i> Nhận hàng</a>
        </nav>
    </header>

    <div class="id-workspace">
        <main class="id-main">
            <section class="id-card">
                <div class="id-card-heading"><div><h2>Nguồn hàng</h2><p>Danh sách được phân trang và tính Available sau reservation.</p></div></div>
                <div class="id-filter-grid">
                    <label class="id-field"><span>Kho xuất</span><select id="distributionWarehouse"></select></label>
                    <label class="id-field id-field-wide"><span>Tìm sản phẩm</span><input id="distributionSearch" type="search" placeholder="Tên, biến thể, thương hiệu hoặc Variant ID" /></label>
                    <label class="id-field"><span>Danh mục</span><select id="distributionCategory"><option value="">Tất cả</option></select></label>
                    <label class="id-field"><span>Thương hiệu</span><select id="distributionBrand"><option value="">Tất cả</option></select></label>
                </div>
                <div class="id-product-grid" id="distributionProductGrid"></div>
                <div class="id-pagination"><span id="distributionPageMeta">Trang 1 / 1</span><div><button id="distributionPrevPage" type="button"><i class="fa-solid fa-chevron-left"></i></button><button id="distributionNextPage" type="button"><i class="fa-solid fa-chevron-right"></i></button></div></div>
            </section>

            <section class="id-card">
                <div class="id-card-heading"><div><h2>Chi tiết phiếu xuất</h2><p>Mỗi SKU có số lượng, giá bán trước VAT và thuế suất riêng.</p></div><button type="button" class="id-link-button" id="clearDistributionButton">Xóa tất cả</button></div>
                <div class="id-table-wrap"><table class="id-table"><thead><tr><th>Sản phẩm</th><th>Tồn khả dụng</th><th>Số lượng</th><th>Giá bán</th><th>VAT</th><th>Thành tiền trước VAT</th><th></th></tr></thead><tbody id="distributionLineTableBody"></tbody></table></div>
            </section>

            <section class="id-card">
                <div class="id-card-heading"><div><h2>Phiếu phân phối gần đây</h2><p>Doanh thu, COGS và lợi nhuận đã ghi nhận.</p></div><button type="button" class="id-icon-button" id="refreshDistributionsButton"><i class="fa-solid fa-rotate"></i></button></div>
                <div class="id-table-wrap"><table class="id-table"><thead><tr><th>Mã phiếu</th><th>Ngày</th><th>Kho → cửa hàng</th><th>Số lượng</th><th>Doanh thu HĐ</th><th>COGS</th><th>Lợi nhuận</th></tr></thead><tbody id="recentDistributionTableBody"></tbody></table></div>
            </section>
        </main>

        <aside class="id-sidebar">
            <section class="id-card id-sticky-card">
                <div class="id-card-heading"><div><span class="id-eyebrow">DISTRIBUTION DOCUMENT</span><h2>Thông tin chứng từ</h2></div></div>
                <label class="id-field"><span>Cửa hàng / đại lý nhận</span><select id="distributionStore"></select></label>
                <label class="id-field"><span>Số hóa đơn / chứng từ</span><input id="distributionInvoiceNumber" maxlength="100" placeholder="PXK-2026-..." /></label>
                <div class="id-two-columns">
                    <label class="id-field"><span>Chiết khấu (%)</span><input id="distributionDiscount" type="number" min="0" max="100" step="0.01" value="0" /></label>
                    <label class="id-field"><span>Chi phí vận chuyển</span><input id="distributionShipping" type="number" min="0" step="1000" value="0" /></label>
                </div>
                <label class="id-field"><span>Ghi chú</span><textarea id="distributionNotes" rows="3" maxlength="500" placeholder="Điều kiện giao hàng, người nhận..."></textarea></label>

                <div class="id-summary">
                    <div><span>Doanh thu trước VAT</span><strong id="summaryNetRevenue">—</strong></div>
                    <div><span>VAT đầu ra</span><strong id="summaryTax">—</strong></div>
                    <div><span>Tổng hóa đơn</span><strong id="summaryInvoiceTotal">—</strong></div>
                    <div><span>FIFO COGS</span><strong id="summaryCogs">—</strong></div>
                    <div><span>Chi phí vận chuyển</span><strong id="summaryShipping">—</strong></div>
                    <div class="id-summary-profit"><span>Lợi nhuận ghi nhận</span><strong id="summaryProfit">—</strong></div>
                    <div><span>Biên lợi nhuận</span><strong id="summaryMargin">—</strong></div>
                </div>
                <div class="id-alert" id="distributionPreviewStatus">Thêm sản phẩm và preview trước khi ghi sổ.</div>
                <button type="button" class="id-button id-button-light id-button-block" id="previewDistributionButton"><i class="fa-solid fa-calculator"></i> Preview FIFO & tài chính</button>
                <button type="button" class="id-button id-button-success id-button-block" id="submitDistributionButton" disabled><i class="fa-solid fa-check"></i> Ghi sổ xuất kho</button>
                <small class="id-submit-note">Sau khi ghi sổ, tồn lô và serial được trừ theo FIFO; không thể sửa trực tiếp phiếu bằng giao diện legacy.</small>
            </section>
        </aside>
    </div>
</div>

<div class="id-toast-stack" id="distributionToastStack" aria-live="polite"></div>

@section Scripts {
    <script src="~/js/admin/inventory-distribution-phase-d3.js" asp-append-version="true"></script>
}
