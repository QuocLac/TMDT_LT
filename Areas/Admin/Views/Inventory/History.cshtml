@model List<TMDT_LT.Models.InventoryTransactions>
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Thẻ kho chi tiết";
    var vInfo = ViewBag.VariantInfo as TMDT_LT.Models.ProductVariants;
    var activeLots = ViewBag.ActiveLots as List<TMDT_LT.Models.InventoryLots> ?? new List<TMDT_LT.Models.InventoryLots>();
}

<div style="margin-bottom: 25px; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;">
    <a href="/Admin/Inventory/Index" style="text-decoration:none; font-size:13px; font-weight:700; color:#4B5563;"> Quay lại danh sách tổng</a>
    <h2 style="font-weight: 800; color: #111827; margin-top: 10px;">Thẻ Kho Chi Tiết Giao Dịch: @vInfo?.Product?.Name</h2>
</div>

<div class="admin-card" style="background:#FFF; border-radius:8px; border:1px solid #E5E7EB; padding:20px; display:grid; grid-template-columns: repeat(4, 1fr); gap:16px; margin-bottom:20px; font-family: 'Segoe UI', sans-serif;">
    <div><span style="color:#6B7280; font-size:12px; display:block; margin-bottom:2px;">Mã định danh phần cứng</span><strong style="font-family:monospace; font-size:14px; color:#2563EB;">#SKU-@vInfo?.VariantId</strong></div>
    <div><span style="color:#6B7280; font-size:12px; display:block; margin-bottom:2px;">Cấu hình thiết bị</span><strong style="color:#111827; font-size:13px;">Màu @vInfo?.Color | Bản @vInfo?.Storage @(string.IsNullOrEmpty(vInfo?.Ram) ? "" : $"({vInfo?.Ram})")</strong></div>
    <div><span style="color:#6B7280; font-size:12px; display:block; margin-bottom:2px;">Tổng tồn kho hệ thống</span><strong style="color:#10B981; font-size:15px;">@vInfo?.Stock máy</strong></div>
    <div><span style="color:#6B7280; font-size:12px; display:block; margin-bottom:2px;">Giá bán niêm yết hiện tại</span><strong style="color:#111827; font-size:14px;">@((vInfo?.Price ?? 0).ToString("N0")) đ</strong></div>
</div>

<div style="display:grid; grid-template-columns: 1fr 380px; gap:20px; align-items:start; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;">

    <div class="admin-card" style="padding: 0; background:#FFF; border-radius:8px; overflow:hidden; border:1px solid #E5E7EB;">
        <div style="padding: 16px 20px; font-weight:700; font-size:14px; color:#111827; border-bottom:1px solid #F3F4F6; background:#FAFAFA; text-transform: uppercase;">
            Nhật Ký Biến Động Giao Dịch Kho
        </div>
        <table style="width:100%; border-collapse:collapse; text-align:left; font-size: 13px;">
            <thead>
                <tr style="background:#FAFAFA; border-bottom:2px solid #E5E7EB; color: #4B5563;">
                    <th style="padding:12px; width: 22%;">Thời gian ghi nhận</th>
                    <th style="padding:12px; width: 18%;">Loại biến động</th>
                    <th style="padding:12px; width: 15%; text-align: center;">Số lượng</th>
                    <th style="padding:12px; width: 15%;">Chứng từ Ref</th>
                    <th style="padding:12px; width: 30%;">Chi tiết diễn giải giá vốn</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="5" style="text-align:center; padding:40px; color:#9CA3AF; font-style:italic;">Thiết bị chưa phát sinh bất kỳ giao dịch xuất nhập kho nào.</td></tr>
                }
                @foreach (var trans in Model)
                {
                    string typeBadge = "";
                    string typeStyle = "";
                    if (trans.TransactionType == "IN_PURCHASE") { typeBadge = "Nhập từ NCC"; typeStyle = "color:#10B981; font-weight:700;"; }
                    else if (trans.TransactionType == "OUT_ORDER") { typeBadge = "Xuất cửa hàng"; typeStyle = "color:#EF4444; font-weight:700;"; }
                    else { typeBadge = "Kiểm kê kho"; typeStyle = "color:#F59E0B; font-weight:700;"; }

                    <tr style="border-bottom:1px solid #F3F4F6; color: #374151;">
                        <td style="padding:12px; color:#4B5563;">@trans.TransactionDate?.ToString("dd/MM/yyyy HH:mm:ss")</td>
                        <td style="padding:12px; @typeStyle">@typeBadge</td>
                        <td style="padding:12px; font-weight:700; font-size:14px; text-align: center;">
                            @(trans.Quantity > 0 ? $"+{trans.Quantity}" : trans.Quantity.ToString())
                        </td>
                        <td style="padding:12px; font-family:monospace; color:#6B7280; font-weight:600;">#(Ref-@trans.ReferenceId)</td>
                        <td style="padding:12px; color:#374151; font-size:12px; line-height: 1.4;">@trans.Note</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="admin-card" style="padding:0; background:#FFF; border-radius:8px; border:1px solid #E5E7EB; overflow:hidden;">
        <div style="padding: 16px 20px; font-weight:700; font-size:14px; color:#111827; border-bottom:1px solid #F3F4F6; background:#FAFAFA; text-transform: uppercase;">
            Trạng Thái Tồn Kho Theo Lô (FIFO)
        </div>
        <div style="padding:15px; display:flex; flex-direction:column; gap:12px;">
            @if (!activeLots.Any())
            {
                <div style="font-style:italic; color:#9CA3AF; text-align:center; padding:20px;">Không có lô hàng nào còn tồn khả dụng tại trung tâm phân phối.</div>
            }
            @foreach (var lot in activeLots)
            {
                string storeLocation = lot.Poid == 10 || lot.Poid == 1 ? "Kho HCM - Quận 1" : "Kho HN - Hoàn Kiếm";
                <div style="border:1px solid #E2E8F0; padding:12px; border-radius:6px; background:#F8FAFC;">
                    <div style="display:flex; justify-content:space-between; margin-bottom:4px;">
                        <span style="font-weight:700; color:#2563EB; font-family: monospace;">#LOT-00@lot.LotId</span>
                        <span style="background:#10B981; color:#FFF; font-size:11px; padding:2px 6px; border-radius:4px; font-weight:600;">Còn tồn: @lot.RemainingQuantity / @lot.ReceivedQuantity máy</span>
                    </div>
                    <div style="font-size:12px; color:#475569; margin-top:6px; line-height: 1.5;">
                        <div><strong>Giá vốn gốc phân bổ:</strong> <span style="color:#DC2626; font-weight:600;">@lot.UnitCost.ToString("N0") đ</span></div>
                        <div><strong>Cơ sở bãi lưu giữ:</strong> @storeLocation</div>
                        <div style="margin-top:2px; font-size: 11px; color: #9CA3AF;">Ngày nạp lô: @lot.ReceivedDate.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>