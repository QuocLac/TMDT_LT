@model TMDT_LT.Models.ViewModels.DashboardVM
@using System.Text.Json
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Thống kê doanh thu";

    string Money(decimal value) => string.Format("{0:N0} đ", value);
    string Number(int value) => string.Format("{0:N0}", value);
    string Percent(double value) => string.Format("{0:0.0}%", value);
}

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
    .commerce-dashboard { color: #111827; }
    .commerce-head { display:flex; justify-content:space-between; gap:24px; align-items:flex-end; margin-bottom:24px; }
    .commerce-title h1 { margin:0; font-size:32px; line-height:1.1; font-weight:800; letter-spacing:-0.8px; }
    .commerce-title p { margin:8px 0 0; color:#6b7280; font-size:14px; }
    .commerce-actions { display:flex; align-items:flex-end; gap:12px; flex-wrap:wrap; }
    .filter-box { display:flex; gap:10px; align-items:flex-end; padding:12px; border:1px solid #e5e7eb; border-radius:14px; background:#fff; box-shadow:0 8px 20px rgba(15,23,42,.04); }
    .filter-box label { display:block; font-size:11px; font-weight:800; color:#374151; margin-bottom:6px; }
    .filter-box input { height:38px; border:1px solid #d1d5db; border-radius:9px; padding:0 10px; font-weight:600; color:#111827; }
    .btn-primary-dark, .btn-outline-dark { height:40px; display:inline-flex; align-items:center; justify-content:center; gap:8px; border-radius:10px; padding:0 16px; font-weight:800; text-decoration:none; white-space:nowrap; }
    .btn-primary-dark { background:#111827; color:#fff; border:1px solid #111827; }
    .btn-outline-dark { background:#fff; color:#111827; border:1px solid #111827; }
    .insight-strip { display:grid; grid-template-columns: 1.4fr .8fr .8fr; gap:16px; margin-bottom:18px; }
    .insight-card { border:1px solid #e5e7eb; background:#fff; border-radius:18px; padding:20px; box-shadow:0 10px 24px rgba(15,23,42,.05); }
    .insight-card.dark { background:#111827; color:#fff; border-color:#111827; }
    .insight-label { color:#6b7280; font-size:12px; font-weight:800; text-transform:uppercase; letter-spacing:.5px; }
    .dark .insight-label { color:#cbd5e1; }
    .insight-value { margin-top:8px; font-size:30px; line-height:1.05; font-weight:900; letter-spacing:-.8px; }
    .insight-sub { margin-top:8px; color:#6b7280; font-size:13px; }
    .dark .insight-sub { color:#e5e7eb; }
    .kpi-grid { display:grid; grid-template-columns: repeat(6, minmax(0,1fr)); gap:14px; margin-bottom:20px; }
    .kpi { background:#fff; border:1px solid #e5e7eb; border-radius:16px; padding:16px; box-shadow:0 8px 18px rgba(15,23,42,.04); min-height:118px; }
    .kpi .label { color:#6b7280; font-size:12px; font-weight:750; }
    .kpi .value { margin-top:10px; font-size:24px; font-weight:900; letter-spacing:-.5px; }
    .kpi .note { margin-top:6px; color:#6b7280; font-size:12px; }
    .up { color:#059669; } .down { color:#dc2626; } .blue { color:#2563eb; } .orange { color:#ea580c; }
    .grid-2 { display:grid; grid-template-columns:1.2fr .8fr; gap:18px; margin-bottom:18px; }
    .grid-3 { display:grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap:18px; margin-bottom:18px; }
    .panel { background:#fff; border:1px solid #e5e7eb; border-radius:18px; padding:18px; box-shadow:0 8px 22px rgba(15,23,42,.04); }
    .panel-title { display:flex; justify-content:space-between; align-items:center; gap:12px; margin-bottom:14px; }
    .panel-title h3 { margin:0; font-size:15px; font-weight:900; }
    .panel-title span { color:#6b7280; font-size:12px; }
    .chart-area { height:300px; position:relative; }
    .small-chart { height:240px; position:relative; }
    .commerce-table { width:100%; border-collapse:collapse; }
    .commerce-table th { text-align:left; padding:12px 10px; border-bottom:1px solid #e5e7eb; color:#6b7280; font-size:12px; text-transform:uppercase; letter-spacing:.4px; }
    .commerce-table td { padding:13px 10px; border-bottom:1px solid #f1f5f9; font-size:13px; vertical-align:middle; }
    .commerce-table tr:hover { background:#f8fafc; }
    .tag { display:inline-flex; align-items:center; border-radius:999px; padding:4px 9px; font-size:11px; font-weight:800; background:#f1f5f9; color:#334155; }
    .progress { height:8px; background:#f1f5f9; border-radius:999px; overflow:hidden; }
    .progress > span { display:block; height:100%; background:#111827; border-radius:999px; }
    .quick-links { display:flex; gap:10px; flex-wrap:wrap; margin-top:14px; }
    media (max-width: 1200px) { .kpi-grid { grid-template-columns: repeat(3,1fr); } .insight-strip, .grid-2, .grid-3 { grid-template-columns:1fr; } }
    media (max-width: 768px) { .commerce-head { flex-direction:column; align-items:stretch; } .filter-box { flex-direction:column; align-items:stretch; } .kpi-grid { grid-template-columns:1fr; } }
</style>

<div class="commerce-dashboard">
    <div class="commerce-head">
        <div class="commerce-title">
            <h1>Thống kê doanh thu</h1>
            <p>Trung tâm điều hành tài chính: doanh thu, lợi nhuận, đơn hàng, hoàn trả và tín hiệu chuyển đổi.</p>
            <div class="quick-links">
                <a class="btn-outline-dark" href="@Url.Action("Index", "Analytics", new { area = "Admin" })">
                    <i class="fas fa-chart-line"></i> Sang phân tích hành vi khách hàng
                </a>
                <a class="btn-outline-dark" href="@Url.Action("Index", "Order", new { area = "Admin" })">
                    <i class="fas fa-clipboard-list"></i> Xem xử lý đơn hàng
                </a>
            </div>
        </div>
        <form method="get" class="filter-box">
            <div>
                <label>Từ ngày</label>
                <input type="date" name="startDate" value="@Model.FilterStartDate" />
            </div>
            <div>
                <label>Đến ngày</label>
                <input type="date" name="endDate" value="@Model.FilterEndDate" />
            </div>
            <button class="btn-primary-dark" type="submit"><i class="fas fa-filter"></i> Lọc</button>
        </form>
    </div>

    <div class="insight-strip">
        <div class="insight-card dark">
            <div class="insight-label">Doanh thu ghi nhận trong kỳ</div>
            <div class="insight-value">@Money(Model.GrossRevenue)</div>
            <div class="insight-sub">@Number(Model.CompletedOrdersCount) đơn hoàn tất • AOV @Money(Model.AverageOrderValue)</div>
        </div>
        <div class="insight-card">
            <div class="insight-label">Lợi nhuận sau giá vốn</div>
            <div class="insight-value @(Model.TotalNetProfit >= 0 ? "up" : "down")">@Money(Model.TotalNetProfit)</div>
            <div class="insight-sub">Biên lợi nhuận @Percent(Model.GrossMarginRate)</div>
        </div>
        <div class="insight-card">
            <div class="insight-label">Doanh thu tháng này</div>
            <div class="insight-value">@Money(Model.RevenueThisMonth)</div>
            <div class="insight-sub @(Model.RevenueMoMGrowth >= 0 ? "up" : "down")">@Percent(Model.RevenueMoMGrowth) so với tháng trước</div>
        </div>
    </div>

    <div class="kpi-grid">
        <div class="kpi"><div class="label">Tổng đơn trong kỳ</div><div class="value">@Number(Model.TotalOrdersCount)</div><div class="note">Mọi trạng thái đơn</div></div>
        <div class="kpi"><div class="label">Đơn hoàn tất</div><div class="value up">@Number(Model.CompletedOrdersCount)</div><div class="note">Đơn được tính doanh thu</div></div>
        <div class="kpi"><div class="label">Đơn hủy</div><div class="value down">@Number(Model.CancelledOrdersCount)</div><div class="note">Tỷ lệ hủy @Percent(Model.CancelRate)</div></div>
        <div class="kpi"><div class="label">Hoàn trả / hoàn tiền</div><div class="value orange">@Number(Model.ReturnedOrdersCount)</div><div class="note">Rủi ro hoàn @Money(Model.RefundRiskAmount)</div></div>
        <div class="kpi"><div class="label">Tỷ lệ chuyển đổi</div><div class="value blue">@Percent(Model.ConversionRate)</div><div class="note">Từ lượt ghé trang đến đơn</div></div>
        <div class="kpi"><div class="label">Sắp hết hàng</div><div class="value orange">@Number(Model.LowStockVariantCount)</div><div class="note">Biến thể còn từ 1-5 máy</div></div>
    </div>

    <div class="grid-2">
        <div class="panel">
            <div class="panel-title"><h3>Doanh thu - giá vốn - lợi nhuận theo ngày</h3><span>Theo khoảng lọc hiện tại</span></div>
            <div class="chart-area"><canvas id="financialChart"></canvas></div>
        </div>
        <div class="panel">
            <div class="panel-title"><h3>Phễu doanh thu</h3><span>Dữ liệu nội bộ + đơn hàng</span></div>
            <div class="chart-area"><canvas id="funnelChart"></canvas></div>
        </div>
    </div>

    <div class="grid-3">
        <div class="panel">
            <div class="panel-title"><h3>Traffic thương mại</h3><span>Lượt vào trang và xem sản phẩm</span></div>
            <div class="small-chart"><canvas id="trafficChart"></canvas></div>
        </div>
        <div class="panel">
            <div class="panel-title"><h3>Cơ cấu thanh toán</h3><span>COD / VNPAY / phương thức khác</span></div>
            <div class="small-chart"><canvas id="paymentChart"></canvas></div>
        </div>
        <div class="panel">
            <div class="panel-title"><h3>Trạng thái đơn hàng</h3><span>Sức khỏe vận hành</span></div>
            <div class="small-chart"><canvas id="statusChart"></canvas></div>
        </div>
    </div>

    <div class="grid-2">
        <div class="panel">
            <div class="panel-title"><h3>Top sản phẩm tạo doanh thu</h3><span>Ưu tiên theo doanh thu và lợi nhuận</span></div>
            <table class="commerce-table">
                <thead>
                    <tr>
                        <th>Sản phẩm</th>
                        <th>Đã bán</th>
                        <th>Doanh thu</th>
                        <th>Lợi nhuận</th>
                        <th>Biên</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.ProductSalesStats.Any())
                    {
                        foreach (var p in Model.ProductSalesStats)
                        {
                            var marginWidth = Math.Min(Math.Max(p.MarginRate, 0), 100).ToString("0");
                            <tr>
                                <td>
                                    <strong>@p.ProductName</strong><br />
                                    <span class="tag">@p.BrandName</span> <span class="tag">@p.CategoryName</span>
                                </td>
                                <td><strong>@Number(p.QuantitySold)</strong></td>
                                <td>@Money(p.TotalRevenue)</td>
                                <td class="@(p.NetProfit >= 0 ? "up" : "down")"><strong>@Money(p.NetProfit)</strong></td>
                                <td>
                                    <div style="display:flex; align-items:center; gap:8px;">
                                        <span style="width:45px;">@Percent(p.MarginRate)</span>
                                        <div class="progress" style="flex:1;"><span style="width:@(marginWidth)%"></span></div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="5" style="text-align:center; color:#9ca3af; padding:28px;">Chưa có sản phẩm phát sinh doanh thu trong kỳ.</td></tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="panel">
            <div class="panel-title"><h3>Chỉ số điều hành nhanh</h3><span>Đọc nhanh sức khỏe sàn</span></div>
            <table class="commerce-table">
                <tbody>
                    <tr><td>Khách hàng mới</td><td><strong>@Number(Model.NewCustomersCount)</strong></td></tr>
                    <tr><td>Khách đang hoạt động</td><td><strong>@Number(Model.ActiveCustomersCount)</strong></td></tr>
                    <tr><td>Tỷ lệ rời bỏ</td><td><strong class="down">@Percent(Model.ChurnRate)</strong></td></tr>
                    <tr><td>Số máy đã bán</td><td><strong>@Number(Model.TotalQuantitySold)</strong></td></tr>
                    <tr><td>Giá vốn ghi nhận</td><td><strong>@Money(Model.TotalCost)</strong></td></tr>
                    <tr><td>Thời gian giao TB</td><td><strong>@(Model.AverageDeliveryHours > 0 ? Model.AverageDeliveryHours.ToString("0.0") + " giờ" : "Chưa đủ dữ liệu")</strong></td></tr>
                    <tr><td>Hao hụt kho dự phòng</td><td><strong>@Number(Model.InventoryShrinkage)</strong></td></tr>
                    <tr><td>Cart → Order</td><td><strong class="blue">@Percent(Model.CartToOrderRate)</strong></td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const labels = @Html.Raw(JsonSerializer.Serialize(Model.FinancialChartData.Select(x => x.DateLabel)));
        const revenues = @Html.Raw(JsonSerializer.Serialize(Model.FinancialChartData.Select(x => x.Revenue)));
        const costs = @Html.Raw(JsonSerializer.Serialize(Model.FinancialChartData.Select(x => x.PurchaseCost)));
        const profits = @Html.Raw(JsonSerializer.Serialize(Model.FinancialChartData.Select(x => x.NetProfit)));
        const pageViews = @Html.Raw(JsonSerializer.Serialize(Model.TrafficChartData.Select(x => x.PageViews)));
        const productViews = @Html.Raw(JsonSerializer.Serialize(Model.TrafficChartData.Select(x => x.ProductViews)));
        const paymentLabels = @Html.Raw(JsonSerializer.Serialize(Model.PaymentMethodStats.Select(x => x.PaymentMethod)));
        const paymentValues = @Html.Raw(JsonSerializer.Serialize(Model.PaymentMethodStats.Select(x => x.Revenue)));
        const statusLabels = @Html.Raw(JsonSerializer.Serialize(Model.OrderStatusStats.Select(x => x.Status)));
        const statusValues = @Html.Raw(JsonSerializer.Serialize(Model.OrderStatusStats.Select(x => x.OrderCount)));

        const money = (value) => new Intl.NumberFormat('vi-VN').format(value) + ' đ';
        const common = {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { labels: { boxWidth: 12, font: { size: 11, weight: 'bold' } } } },
            scales: {
                x: { grid: { display:false }, ticks: { color:'#6b7280', maxRotation: 45, minRotation: 0 } },
                y: { grid: { color:'#f1f5f9' }, ticks: { color:'#6b7280' } }
            }
        };

        new Chart(document.getElementById('financialChart'), {
            type: 'line',
            data: {
                labels,
                datasets: [
                    { label: 'Doanh thu', data: revenues, borderColor:'#111827', backgroundColor:'rgba(17,24,39,.08)', fill:true, tension:.35, borderWidth:2, pointRadius:3 },
                    { label: 'Giá vốn', data: costs, borderColor:'#ea580c', backgroundColor:'rgba(234,88,12,.08)', fill:false, tension:.35, borderWidth:2, pointRadius:2 },
                    { label: 'Lợi nhuận', data: profits, borderColor:'#059669', backgroundColor:'rgba(5,150,105,.08)', fill:false, tension:.35, borderWidth:2, pointRadius:2 }
                ]
            },
            options: { ...common, plugins: { ...common.plugins, tooltip: { callbacks: { label: ctx => ctx.dataset.label + ': ' + money(ctx.parsed.y) } } } }
        });

        new Chart(document.getElementById('funnelChart'), {
            type: 'bar',
            data: {
                labels: ['Ghé trang', 'Xem SP', 'Thêm giỏ', 'Checkout', 'Đơn'],
                datasets: [{ data: [@Model.FunnelViews, @Model.ProductViews, @Model.FunnelCarts, @Model.FunnelCheckouts, @Model.FunnelOrders], backgroundColor:['#64748b','#475569','#334155','#1f2937','#111827'], borderRadius:10 }]
            },
            options: { indexAxis:'y', responsive:true, maintainAspectRatio:false, plugins:{ legend:{display:false} }, scales:{ x:{ grid:{color:'#f1f5f9'} }, y:{ grid:{display:false} } } }
        });

        new Chart(document.getElementById('trafficChart'), {
            type: 'bar',
            data: { labels, datasets: [
                { label:'Lượt ghé', data: pageViews, backgroundColor:'#111827', borderRadius:6 },
                { label:'Xem sản phẩm', data: productViews, backgroundColor:'#2563eb', borderRadius:6 }
            ]},
            options: common
        });

        new Chart(document.getElementById('paymentChart'), {
            type: 'doughnut',
            data: { labels: paymentLabels, datasets: [{ data: paymentValues, backgroundColor:['#111827','#2563eb','#059669','#ea580c','#7c3aed'], borderWidth:0 }] },
            options: { responsive:true, maintainAspectRatio:false, plugins:{ legend:{ position:'bottom', labels:{ boxWidth:12, font:{ size:11, weight:'bold' } } }, tooltip:{ callbacks:{ label: ctx => ctx.label + ': ' + money(ctx.parsed) } } } }
        });

        new Chart(document.getElementById('statusChart'), {
            type: 'bar',
            data: { labels: statusLabels, datasets: [{ data: statusValues, backgroundColor:'#111827', borderRadius:8 }] },
            options: { ...common, plugins:{ legend:{display:false} } }
        });
    </script>
}
