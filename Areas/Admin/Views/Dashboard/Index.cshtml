@model TMDT_LT.Models.ViewModels.DashboardVM
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "BI Dashboard Cao Cấp";
}

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
    .dashboard-grid-3 {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-bottom: 24px;
    }

    .dashboard-grid-2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
        margin-bottom: 24px;
    }

    .kpi-card {
        background: #FFFFFF;
        border: 1px solid #E5E7EB;
        padding: 22px;
        border-radius: 4px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .kpi-label {
        font-size: 11px;
        text-transform: uppercase;
        color: #6B7280;
        font-weight: 700;
        letter-spacing: 0.5px;
    }

    .kpi-value {
        font-size: 26px;
        font-weight: 800;
        color: #111827;
        margin: 8px 0;
        font-family: monospace;
    }

    .kpi-sub {
        font-size: 12px;
        color: #4B5563;
    }

    .chart-container {
        background: #FFFFFF;
        border: 1px solid #E5E7EB;
        border-radius: 4px;
        padding: 24px;
    }

    .chart-title {
        font-size: 13px;
        font-weight: 700;
        text-transform: uppercase;
        color: #111827;
        margin: 0 0 20px 0;
        border-bottom: 1px solid #F3F4F6;
        padding-bottom: 12px;
        letter-spacing: 0.5px;
    }
</style>

<div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 30px; border-bottom: 1px solid #E5E7EB; padding-bottom: 20px;">
    <div>
        <h1 style="font-size: 22px; font-weight: 700; color: #111827; margin: 0; letter-spacing: -0.5px;">Báo cáo vận hành tổng quan sàn</h1>
        <p style="color: #6B7280; font-size: 13px; margin-top: 4px;">Phân tích sâu phễu hành vi khách hàng, tỷ lệ churn tài chính và lưu lượng tăng trưởng mạng lưới.</p>
    </div>
    <form method="get" style="display: flex; gap: 12px; align-items: flex-end; background: #F9FAFB; padding: 12px; border-radius: 4px; border: 1px solid #E5E7EB;">
        <div>
            <label style="display: block; font-size: 10px; text-transform: uppercase; font-weight: 700; color: #6B7280; margin-bottom: 4px;">Ngày bắt đầu biểu đồ</label>
            <input type="date" name="startDate" value="@Model.FilterStartDate" class="form-control" style="padding: 6px 10px; font-size: 13px;" />
        </div>
        <div>
            <label style="display: block; font-size: 10px; text-transform: uppercase; font-weight: 700; color: #6B7280; margin-bottom: 4px;">Ngày kết thúc biểu đồ</label>
            <input type="date" name="endDate" value="@Model.FilterEndDate" class="form-control" style="padding: 6px 10px; font-size: 13px;" />
        </div>
        <button type="submit" class="btn-dark" style="padding: 8px 16px; font-size: 12px; font-weight: 600;">ÁP DỤNG MỐC</button>
    </form>
</div>

<div class="dashboard-grid-3">
    <div class="kpi-card">
        <span class="kpi-label">Doanh thu tháng này</span>
        <div class="kpi-value">@string.Format("{0:N0}", Model.RevenueThisMonth) đ</div>
        <div class="kpi-sub">
            Tháng trước: <span style="font-family: monospace;">@string.Format("{0:N0}", Model.RevenueLastMonth) đ</span>
            (Biến động: <strong style="color: @(Model.RevenueMoMGrowth >= 0 ? "#059669" : "#DC2626")">@string.Format("{0:F1}", Model.RevenueMoMGrowth)%</strong>)
        </div>
    </div>

    <div class="kpi-card">
        <span class="kpi-label">Tỷ lệ rời bỏ (Churn Rate)</span>
        <div class="kpi-value">@Model.ChurnRate%</div>
        <div class="kpi-sub">
            Mất tương tác (2 tháng): <strong>@Model.ChurnedCustomersCount</strong> / Hoạt động: <strong>@Model.ActiveCustomersCount</strong>
        </div>
    </div>

    <div class="kpi-card">
        <span class="kpi-label">Tỷ lệ chuyển đổi cuối (CR)</span>
        <div class="kpi-value">@Model.ConversionRate%</div>
        <div class="kpi-sub">
            Tổng đơn hàng phát sinh trong kỳ lọc: <strong>@Model.FunnelOrders</strong> đơn
        </div>
    </div>
</div>

<div class="dashboard-grid-2">
    <div class="chart-container">
        <h3 class="chart-title">Diễn tiến doanh thu theo bộ lọc thời gian cụ thể</h3>
        <div style="position: relative; height: 260px;"><canvas id="revenueChart"></canvas></div>
    </div>
    <div class="chart-container">
        <h3 class="chart-title">Biểu đồ tăng trưởng lượt tham quan trang (Page Views)</h3>
        <div style="position: relative; height: 260px;"><canvas id="trafficChart"></canvas></div>
    </div>
</div>

<div class="dashboard-grid-2">
    <div class="chart-container">
        <h3 class="chart-title">Mô hình phễu hành vi khách hàng thương mại</h3>
        <div style="position: relative; height: 260px;"><canvas id="funnelChart"></canvas></div>
    </div>
    <div class="chart-container" style="display: flex; flex-direction: column;">
        <h3 class="chart-title">Cơ cấu lưu giữ và rời bỏ người dùng (60 Ngày)</h3>
        <div style="position: relative; height: 220px; flex: 1; display: flex; align-items: center; justify-content: center;">
            <canvas id="churnChart"></canvas>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Phân tách dữ liệu mảng thô sang JSON Client
        const dateLabels = @Html.Raw(Json.Serialize(Model.RevenueChartData.Select(x => x.DateLabel)));
        const revData = @Html.Raw(Json.Serialize(Model.RevenueChartData.Select(x => x.DailyTotal)));
        const trafficData = @Html.Raw(Json.Serialize(Model.TrafficChartData.Select(x => x.PageViews)));

        const globalChartOptions = {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                x: { grid: { display: false }, ticks: { color: '#9CA3AF', font: { size: 10 } } },
                y: { grid: { color: '#F3F4F6' }, ticks: { color: '#9CA3AF', font: { size: 10 } } }
            }
        };

        // 1. BIỂU ĐỒ DOANH THU CỤ THỂ
        new Chart(document.getElementById('revenueChart'), {
            type: 'line',
            data: {
                labels: dateLabels,
                datasets: [{ data: revData, borderColor: '#111827', borderWidth: 2, pointRadius: 1, fill: true, backgroundColor: 'rgba(17,24,39,0.02)', tension: 0.1 }]
            },
            options: globalChartOptions
        });

        // 2. BIỂU ĐỒ LƯỢT THAM QUAN TRANG (PAGE VIEWS)
        new Chart(document.getElementById('trafficChart'), {
            type: 'line',
            data: {
                labels: dateLabels,
                datasets: [{ data: trafficData, borderColor: '#4B5563', borderWidth: 2, pointRadius: 1, fill: true, backgroundColor: 'rgba(75,85,99,0.02)', tension: 0.1 }]
            },
            options: globalChartOptions
        });

        // 3. BIỂU ĐỒ PHỄU CHUYỂN ĐỔI (BAR NGANG PHÂN CẤP)
        new Chart(document.getElementById('funnelChart'), {
            type: 'bar',
            data: {
                labels: ['1. Xem Sản phẩm', '2. Thêm Giỏ hàng', '3. Đặt hàng'],
                datasets: [{
                    data: [@Model.FunnelViews, @Model.FunnelCarts, @Model.FunnelOrders],
                    backgroundColor: ['#111827', '#4B5563', '#9CA3AF'],
                    barThickness: 30
                }]
            },
            options: {
                indexAxis: 'y', // Đảo trục thành Bar ngang hiển thị cấu trúc phễu thu hẹp dần
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    x: { grid: { color: '#F3F4F6' }, ticks: { color: '#9CA3AF' } },
                    y: { grid: { display: false }, ticks: { color: '#111827', font: { weight: '600' } } }
                }
            }
        });

        // 4. BIỂU ĐỒ TRÒN KHÁCH HÀNG RỜI BỎ
        new Chart(document.getElementById('churnChart'), {
            type: 'pie',
            data: {
                labels: ['Khách hàng giữ chân (Active)', 'Khách hàng rời bỏ (Churned)'],
                datasets: [{
                    data: [@Model.ActiveCustomersCount, @Model.ChurnedCustomersCount],
                    backgroundColor: ['#111827', '#E5E7EB'],
                    borderWidth: 1,
                    borderColor: '#FFFFFF'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { position: 'right', labels: { boxWidth: 12, font: { size: 11 } } } }
            }
        });
    </script>
}